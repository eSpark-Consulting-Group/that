<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="APTAT.Core.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <APTAT.Core.Properties.Settings>
            <setting name="AgentDescentingTimeout" serializeAs="String">
                <value>00:10:00</value>
            </setting>
            <setting name="PackageDescentingTimeout" serializeAs="String">
                <value>00:10:00</value>
            </setting>
            <setting name="SupportedDnsNames" serializeAs="String">
                <value>localhost</value>
            </setting>
            <setting name="DsaPublicKey" serializeAs="String">
                <value />
            </setting>
            <setting name="DsaPrivateKey" serializeAs="String">
                <value />
            </setting>
            <setting name="DescentMaximumConcurrencyLevel" serializeAs="String">
                <value>50</value>
            </setting>
            <setting name="AgentSocketPort" serializeAs="String">
                <value>9901</value>
            </setting>
            <setting name="WebRootFolder" serializeAs="String">
                <value>.\WebRoot\</value>
            </setting>
            <setting name="DescentResultLifetime" serializeAs="String">
                <value>04:00:00</value>
            </setting>
            <setting name="DescentResultCleanupPeriod" serializeAs="String">
                <value>00:30:00</value>
            </setting>
            <setting name="MaxEndpointsAvailabilityResolverConcurrentTasks"
                serializeAs="String">
                <value>260</value>
            </setting>
            <setting name="ScanScope" serializeAs="String">
