                            <Setter TargetName="Indicator" Property="Background" Value="#FFD54331"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.HasUnknowns,
                                RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Indicator" Property="Background" Value="#FFF9AD16"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

