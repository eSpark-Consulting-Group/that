<Window x:Class="FAT.Application.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Application="clr-namespace:FAT.Application"
        MinHeight="760" MinWidth="1015"  Height="760" Width="1015"  WindowStyle="None"
        
        AllowsTransparency="True" Background="Transparent" 
        ResizeMode="CanResizeWithGrip" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" x:Name="this">

    <Border x:Name="Shadow" CornerRadius="4" BorderBrush="#11000000" BorderThickness="1" Margin="0">
        <Border CornerRadius="3" BorderBrush="#22000000" BorderThickness="1">
            <Border CornerRadius="2" BorderBrush="#33000000" BorderThickness="1">
                <Border CornerRadius="1" BorderBrush="#44000000" BorderThickness="1">
                    <Border x:Name="Border" BorderThickness="0" BorderBrush="{DynamicResource StrongBrush}" Background="#FFFAF9F9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource StrongBrush}" Grid.ColumnSpan="2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 15 20 0">
                                       
                                        <Button AutomationProperties.AutomationId="ResizeButton" 
                                                Style="{StaticResource MaximizeButton}" Click="OnResizeClick" Width="18" Height="18" Margin="20 0 0 0" ToolTip="Maximize"/>
                                        <Button AutomationProperties.AutomationId="CloseReportButton"
                                                Style="{StaticResource CloseButton}" Click="OnCloseClick" Width="18" Height="18" Margin="20 0 0 0" ToolTip="Close"/>
                                    </StackPanel>

                                    <TextBlock AutomationProperties.AutomationId="ReportTitleTextBlock"
                                               Text="{Binding ElementName=this, Path=Header}" Foreground="White" FontFamily="Segoe UI Light"  FontSize="20" VerticalAlignment="Center" 
                                               HorizontalAlignment="Left" Margin="20 0 0 0"  SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>
                            <Application:ReportView Grid.Row="1" Grid.ColumnSpan="2"/>
                        </Grid>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
