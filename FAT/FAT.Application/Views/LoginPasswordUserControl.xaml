<UserControl x:Class="FAT.Application.Views.LoginPasswordUserControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"  
      xmlns:converters="clr-namespace:FAT.Application.Converters"     
      mc:Ignorable="d" x:Name="this"
      d:DesignHeight="300" d:DesignWidth="300" >
    <Grid AutomationProperties.AutomationId="CredentialsGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <RadioButton AutomationProperties.AutomationId="UseCurrentDomainCredentialsRadioButton"
                     HorizontalAlignment="Left" Grid.Row="0" Margin="-206 -2 0 0" Grid.Column="2" 
                     Visibility="{Binding ElementName=this, Path=ShowCurrentDomain, Converter={converters:BoolToVisibilityConverter2}}" 
                     Content="{Binding ParentViewModel.CurrentDomainNameContent}" IsChecked="{Binding ElementName=this, Path=UseCurrentDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <RadioButton AutomationProperties.AutomationId="UseCustomCredentialsRadioButton"
                     HorizontalAlignment="Right" Grid.Row="1" Margin="0 17 0 19"  Visibility="{Binding ElementName=this, Path=ShowCurrentDomain, Converter={converters:BoolToVisibilityConverter2}}" 
                     Content="Use Custom Credentials" 
                     IsChecked="{Binding ElementName=this, Path=UseCurrentDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:BoolInvertConverter}}" 
                     Checked="RadioButton_Checked"/>

        <TextBlock Text="Domain Name" Grid.Row="2" Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolToSemiOpacityConverter}, ConverterParameter=!}" 
                   Style="{DynamicResource SubTitleTextStyle}" Visibility="{Binding ElementName=this, Path=ShowDomainController, Converter={converters:BoolToVisibilityConverter2}}" 
                   Margin="0 7 0 0" HorizontalAlignment="Right" />
        <telerik:RadWatermarkTextBox AutomationProperties.AutomationId="DomainNameWatermarkTextBox"
                                     Grid.Column="2" Grid.Row="2" x:Name="text" Margin="0 0 0 17" Visibility="{Binding ElementName=this, Path=ShowDomainController, 
                                     Converter={converters:BoolToVisibilityConverter2}}" IsEnabled="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" 
                                     Text="{Binding DomainController, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <telerik:RadWatermarkTextBox.WatermarkContent>
                <TextBlock Margin="0 1 0 0" Text="Enter Domain Name" Foreground="{DynamicResource TextBrush2}" />
            </telerik:RadWatermarkTextBox.WatermarkContent>
        </telerik:RadWatermarkTextBox>

        <TextBlock Text="Login" Grid.Row="3" Visibility="{Binding ElementName=this, Path=ShowDomainController, Converter={converters:BoolToVisibilityConverter2}, ConverterParameter=!}" 
                   Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolToSemiOpacityConverter}, ConverterParameter=!}" 
                   Style="{DynamicResource SubTitleTextStyle}" HorizontalAlignment="Right" Margin="0 7 0 0" />
        <telerik:RadWatermarkTextBox AutomationProperties.AutomationId="LoginWatermarkTextBox"
                                     Grid.Column="2" 
                                     Visibility="{Binding ElementName=this, Path=ShowDomainController, Converter={converters:BoolToVisibilityConverter2}, ConverterParameter=!}" 
                                     Grid.Row="3" x:Name="text2" Margin="0 0 0 0" IsEnabled="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" 
                                     Text="{Binding ElementName=this, Path=Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <telerik:RadWatermarkTextBox.WatermarkContent>
                <TextBlock Margin="0 1 0 0" Text="Enter Login" Foreground="{DynamicResource TextBrush2}" />
            </telerik:RadWatermarkTextBox.WatermarkContent>
        </telerik:RadWatermarkTextBox>

        <TextBlock Text="Domain Administrator" Grid.Row="3" Visibility="{Binding ElementName=this, Path=ShowDomainController, Converter={converters:BoolToVisibilityConverter2}}" 
                   Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolToSemiOpacityConverter}, ConverterParameter=!}" 
                   Style="{DynamicResource SubTitleTextStyle}" HorizontalAlignment="Right" Margin="0 7 0 0" />
        <telerik:RadWatermarkTextBox AutomationProperties.AutomationId="DomainAdministratorWatermarkTextBox"
                                     Grid.Column="2" Grid.Row="3" Visibility="{Binding ElementName=this, Path=ShowDomainController, Converter={converters:BoolToVisibilityConverter2}}" 
                                     x:Name="text3" Margin="0 0 0 0" IsEnabled="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" 
                                     Text="{Binding ElementName=this, Path=Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <telerik:RadWatermarkTextBox.WatermarkContent>
                <TextBlock Margin="0 1 0 0" Text="Enter Domain Administrator" Foreground="{DynamicResource TextBrush2}" />
            </telerik:RadWatermarkTextBox.WatermarkContent>
        </telerik:RadWatermarkTextBox>

        <TextBlock Text="Password" Grid.Row="4" Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolToSemiOpacityConverter}, ConverterParameter=!}" Style="{DynamicResource SubTitleTextStyle}" HorizontalAlignment="Right" Margin="0 24 0 0" />
        <telerik:RadWatermarkTextBox AutomationProperties.AutomationId="PasswordWatermarkTextBox"
                                     Grid.Column="2" Grid.Row="4" Margin="0 17 0 0" Padding="10 6 38 0" 
                                     IsEnabled="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" 
                                     IsTabStop="{Binding ElementName=PasswordMasked, Path=IsTabStop, Converter={converters:BoolInvertConverter}}" 
                                     Text="{Binding ElementName=this, Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     x:Name="PasswordUnmasked">
            <telerik:RadWatermarkTextBox.WatermarkContent>
                <TextBlock Margin="0 1 0 0" Text="Enter Password" Foreground="{DynamicResource TextBrush2}" />
            </telerik:RadWatermarkTextBox.WatermarkContent>
        </telerik:RadWatermarkTextBox>
        
        <PasswordBox AutomationProperties.AutomationId="PasswordBox"
                     Grid.Column="2" Grid.Row="4"  Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" 
                     Margin="0 17 0 0" Padding="10 6 38 0" x:Name="PasswordMasked" PasswordChanged="PasswordChanged" Visibility="Collapsed" IsTabStop="False">
        </PasswordBox>

        <Button Grid.Column="2" Grid.Row="4" Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" 
                IsHitTestVisible="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" Margin="0 15 0 0" MinWidth="34" 
                HorizontalAlignment="Right" Click="SwitchMask" Template="{StaticResource PasswordButton}" Tag="False" x:Name="OpenedEye" ToolTip="Show" IsTabStop="False"/>
        <Button Grid.Column="2" Grid.Row="4" Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" 
                IsHitTestVisible="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" Margin="0 14 0 0" MinWidth="34" 
                HorizontalAlignment="Right" Click="SwitchMask" Template="{StaticResource PasswordButton}" Tag="True" Visibility="Collapsed" x:Name="ClosedEye" ToolTip="Hide" 
                IsTabStop="False"/>


    </Grid>

</UserControl>