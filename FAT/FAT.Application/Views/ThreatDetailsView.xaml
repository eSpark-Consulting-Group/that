            <TextBlock AutomationProperties.AutomationId="MalwareNameTextBlock" Style="{StaticResource HeaderTextBlock}"  VerticalAlignment="Center" Text="{Binding FileName}" FontSize="22" Margin="27,8,20,8" Grid.Column="1" MaxWidth="750" ToolTipService.ToolTip="{Binding FileName}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
        </Grid>
        
        <Grid Background="White" Grid.Row="1" Margin="65,0,0,0">
            
              <Grid AutomationProperties.AutomationId="DetailsGrid" x:Name="gridProperties" Margin="5, 0"  VerticalAlignment="Top" HorizontalAlignment="Left"  >
                <Grid.Resources>
                    <Style TargetType="TextBlock" >
                        <Setter Property="Margin" Value="7"/>
                    </Style>
                  
       <Style x:Key="SelectTextStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Margin" Value="4 7 0 0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <ScrollViewer x:Name="PART_ContentHost" MaxWidth="{TemplateBinding MaxWidth}" BorderThickness="0" Padding="0"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                    <Grid x:Name="GeneralCol1" Margin="20, 0,20,20 " MinWidth="370">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock AutomationProperties.AutomationId="FileNameTextBlock" Text="File Name:"  Grid.Column="0" Grid.Row="0" />
                    <TextBlock AutomationProperties.AutomationId="VerdictTextBlock" Text="Verdict:" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" Margin="7,7,0,7" Width="65"/>
                    <TextBlock AutomationProperties.AutomationId="SizeTextBlock" Text="Size:" Grid.Column="0" Grid.Row="2"/>
                    <TextBlock AutomationProperties.AutomationId="CreatedTextBlock" Text="Created:" Grid.Column="0" Grid.Row="3"/>
                    <TextBlock AutomationProperties.AutomationId="ModifiedTextBlock" Text="Modified:" Grid.Column="0" Grid.Row="4"/>
                    <TextBlock AutomationProperties.AutomationId="AccessedTextBlock" Text="Accessed:" Grid.Column="0" Grid.Row="5"/>

                    <TextBox AutomationProperties.AutomationId="FileNameValueTextBox"
                               Text="{Binding FileName}" Grid.Column="1" Grid.Row="0" MaxWidth="220" ToolTipService.ToolTip="{Binding FileName}" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="VerdictValueTextBox"
                               Text="{Binding Verdict}" Grid.Column="1" Grid.Row="1" MaxWidth="220" ToolTipService.ToolTip="{Binding Verdict}" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="SizeValueTextBox" Text="{Binding Size}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="CreatedValueTextBox" Text="{Binding Created}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="ModifiedValueTextBox" Text="{Binding Modified}" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="AccessedValueTextBox" Text="{Binding Accessed}" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                </Grid>
                    <Grid x:Name="GeneralCol2" Grid.Column="1" Margin="20, 0,20,20" MinWidth="250">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                        
                    <TextBlock AutomationProperties.AutomationId="HashTextBlock" Text="Hash (SHA1):" Grid.Column="0" Grid.Row="0"/>
                    <TextBlock AutomationProperties.AutomationId="SignerTextBlock" Text="Signer:" Grid.Column="0" Grid.Row="1"/>
                    <TextBlock AutomationProperties.AutomationId="DescriptionTextBlock" Text="Description:" Grid.Column="0" Grid.Row="2"/>
                    <TextBlock AutomationProperties.AutomationId="VersionTextBlock" Text="Version:" Grid.Column="0" Grid.Row="3"/>
                    <TextBlock AutomationProperties.AutomationId="CopyrightTextBlock" Text="Copyright:" Grid.Column="0" Grid.Row="4"/>
                    <TextBlock AutomationProperties.AutomationId="ProductTextBlock" Text="Product:" Grid.Column="0" Grid.Row="5"/>

                    <TextBox AutomationProperties.AutomationId="HashValueTextBox"
                               Text="{Binding Hash}" Grid.Column="1" Grid.Row="0" MaxWidth="220" ToolTipService.ToolTip="{Binding Hash}" HorizontalAlignment="Left" 
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="SignerValueTextBox"
                               Text="{Binding Signer}" Grid.Column="1" Grid.Row="1" MaxWidth="220" ToolTipService.ToolTip="{Binding Signer}" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="DescriptionValueTextBox"
                               Text="{Binding Description}" Grid.Column="1" Grid.Row="2" MaxWidth="220" ToolTipService.ToolTip="{Binding Description}" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="VersionValueTextBox" Text="{Binding Version}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="CopyrightValueTextBox"
                               Text="{Binding Copyright}" Grid.Column="1" Grid.Row="4" MaxWidth="220" ToolTipService.ToolTip="{Binding Copyright}" HorizontalAlignment="Left" 
                               Style="{StaticResource SelectTextStyle}"/>
                    <TextBox AutomationProperties.AutomationId="ProductValueTextBox"
                               Text="{Binding Product}" Grid.Column="1" Grid.Row="5" MaxWidth="220" ToolTipService.ToolTip="{Binding Product}" HorizontalAlignment="Left"
                               Style="{StaticResource SelectTextStyle}"/>
                </Grid>
            </Grid>
            
        </Grid>
        
        <StackPanel Orientation="Horizontal" Grid.Row="3"   Margin="0,0,10,10" HorizontalAlignment="Right" >
            <Button AutomationProperties.AutomationId="CloseButton" Content="Close" Margin="5" Click="OnBackClick" Height="32"/>
        </StackPanel>
    </Grid>
</Models:BaseView>
