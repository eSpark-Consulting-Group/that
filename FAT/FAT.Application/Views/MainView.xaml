        </Grid>

        <TextBlock x:Name="BusyContent" Opacity="0" Visibility="{Binding Loaded, Converter={converters:BoolToVisibilityConverter2}}" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="Black" FontFamily="{StaticResource myriadpro}" Margin="32,0,0,0" FontSize="19">
            <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="translate3" Y="-300" />
                </TextBlock.RenderTransform>
            <TextBlock.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="translate3" Storyboard.TargetProperty="Y" BeginTime="0:0:0.2">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0" >
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase/>
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BusyContent" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" >
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </TextBlock.Triggers>
            <Run Text="{Binding Header, Mode=OneWay}" FontFamily="myriadpro" FontSize="19"/> <Run Text="{Binding ComputersHeader, Mode=OneWay}" FontFamily="myriadpro" Foreground="#FF457FAD" FontSize="15"/>
            
        </TextBlock>

        <Grid Grid.Row="3" Background="#FFFAF9F9" Visibility="{Binding ScanWasOnceStarted, Converter={converters:BoolToVisibilityConverter2}}">
            <Border x:Name="border" Height="46" Margin="32 0 32 20" Background="#FF2A80B9" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Foreground="White" HorizontalAlignment="Center" FontSize="13" VerticalAlignment="Center"  Visibility="{Binding HideSubmitEmail, Converter={converters:BoolToVisibilityConverter2}}">
                        <Run Text="When all the files are analyzed, you will receive a detailed report at "/><Run Text="{Binding Email}" FontWeight="Bold"/>
                    </TextBlock>

                    <TextBlock Foreground="White" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Please enter your email to receive a detailed scan results report:" Visibility="{Binding HideSubmitEmail, Converter={converters:BoolToVisibilityConverter2}, ConverterParameter=!}"/>
                    <telerik:RadWatermarkTextBox MaxLength="254" Margin="7 0 0 0" x:Name="email" Grid.Column="1" Width="300" Visibility="{Binding HideSubmitEmail, Converter={converters:BoolToVisibilityConverter2}, ConverterParameter=!}"
                                     MinHeight="31" MaxHeight="31"  BorderThickness="1" BorderBrush="#FFD6D4D4" Padding="7 7 0 0" 
                                     Background="White" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <telerik:RadWatermarkTextBox.WatermarkContent>
                            <TextBlock Margin="0 1 0 0" FontSize="14" Opacity="0.5" Text="customermail@enterprise.com" Foreground="#FF547D98"/>
                        </telerik:RadWatermarkTextBox.WatermarkContent>
                    </telerik:RadWatermarkTextBox>
                    <Button Content="Submit" BorderBrush="White" Command="{Binding SubmitEmailCommand}" Visibility="{Binding HideSubmitEmail, Converter={converters:BoolToVisibilityConverter2}, ConverterParameter=!}" MaxHeight="32" Grid.Column="2" Margin="7"/>
                    <Button Content="Edit Email" Click="EditEmail" BorderBrush="White" Command="{Binding EditEmailCommand}" Visibility="{Binding HideSubmitEmail, Converter={converters:BoolToVisibilityConverter2}}" MaxHeight="32" Grid.Column="2" Margin="7"/>
                </Grid>
            </Border>
        </Grid>

        <Border Height="1" Background="#FFF3F3F3" Grid.Row="3" VerticalAlignment="Bottom"/>
        
        <Border Grid.Row="4" Height="46"  Background="White" >
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock  Text="Comodo Forensic Analysis Tool is part of the Comodo ONE portfolio of security solutions. Visit " Foreground="#FF547D98" FontSize="13"/>
                
                <TextBlock Cursor="Hand">
                    <Hyperlink NavigateUri="http://one.comodo.com" RequestNavigate="Hyperlink_RequestNavigate"  Foreground="#FF547D98" FontSize="13">one.comodo.com </Hyperlink>
                </TextBlock>
                
                <TextBlock  Text=" to learn how Comodo can help protect your environment." Foreground="#FF547D98" FontSize="13"/>
            </StackPanel>
        </Border>

    </Grid>
</Models:BasePage>