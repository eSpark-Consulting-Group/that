                                </Button.Triggers>
                            </Button>

                        </Grid>
                    </Border>

                </Grid>



            </Grid>


        </Grid>
        <Grid x:Name="customScanOptions" Grid.Row="3" Visibility="{Binding CurrentStep, Converter={StaticResource StringToVisibiltyConverter}, ConverterParameter=SelectTargets, FallbackValue=Collapsed}">
            <CheckBox AutomationProperties.AutomationId="ScanCriticalAreasCheckBox"
                      IsChecked="{Binding ScanCriticalAreas}" HorizontalAlignment="Left" Margin="160, 0, 0, 30" 
                      Content="Scan critical areas of computer which are most often targeted by malware"></CheckBox>
        </Grid>
    </Grid>
</UserControl>
