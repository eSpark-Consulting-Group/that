<Window x:Class="FAT.Application.StartScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Application="clr-namespace:FAT.Application"
        MinWidth="800"  Height="600" Width="800" WindowStyle="None"
        AllowsTransparency="True" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent">
    <Border x:Name="Shadow" CornerRadius="4" BorderBrush="#11000000" BorderThickness="1" Margin="0">
        <Border CornerRadius="3" BorderBrush="#22000000" BorderThickness="1">
            <Border CornerRadius="2" BorderBrush="#33000000" BorderThickness="1">
                <Border CornerRadius="1" BorderBrush="#44000000" BorderThickness="1">
                    <Border x:Name="Border" BorderThickness="0" BorderBrush="{DynamicResource StrongBrush}" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource StrongBrush}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 15 20 0">
                                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" Width="18" Height="18" Margin="20 0 0 0" ToolTip="Close"/>
                                    </StackPanel>

                                    <TextBlock Text="Start Scan Wizard" Foreground="White" FontFamily="{StaticResource myriadpro}"  FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 0 0"  SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>

                            <Application:StartScanView FinishClick="OnFinishClick" CancelClick="OnCancelClick" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
