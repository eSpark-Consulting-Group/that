                        <TextBlock Margin="8,5,0,0" Text="{Binding ScanHeader}" Grid.Column="1" FontSize="14" Foreground="{Binding ElementName=txt, Path=Foreground, Converter={converters:ColorToWhiteConverter}}"/>

                        <TextBlock Margin="8,6,0,8" x:Name="txt" ToolTip="{Binding ScanHeader2}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Grid.Column="2" Text="{Binding ScanHeader2}" FontSize="13" />
                    </Grid>
                </DataTemplate>

                
                <DataTemplate x:Key="DateColumn">
                    <TextBlock Text="{Binding Started, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="13" VerticalAlignment="Center" TextAlignment="Right" Margin="3 0"/>
                </DataTemplate>
                <DataTemplate x:Key="TypeColumn">
                    <TextBlock Text="{Binding ScanTypeStr}" FontSize="13" TextAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DevicesSourceDescription.Type}" Margin="3 0"/>
                </DataTemplate>
                <DataTemplate x:Key="MethodColumn">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ScanMethodStr}" FontSize="13" VerticalAlignment="Center"  Margin="3 0" MinWidth="80"/>
                        <TextBlock Cursor="Hand" ToolTip="{Binding ValkyrieOperationInfo.DetailedLink}">
                            <Hyperlink NavigateUri="{Binding ValkyrieOperationInfo.DetailedLink}" RequestNavigate="Hyperlink_RequestNavigate"  Foreground="#FF547D98" FontSize="13">Detailed Results</Hyperlink>
                        </TextBlock>

                    </StackPanel>
                </DataTemplate>
            </telerik:RadTreeListView.Resources>

            <telerik:RadTreeListView.Columns>
                <telerik:GridViewColumn 
                    IsFilterable="False"
                    ShowFilterButton="False"    
                    ShowFieldFilters="False"
                    HeaderCellStyle="{StaticResource HeaderCellStyle}"
                    CellTemplate="{StaticResource ScanTemplate}"
                    Header="Scan Summary" MinWidth="300"
                    Width="300*" />
                <telerik:GridViewColumn 
                    HeaderCellStyle="{StaticResource HeaderCellStyle}"
                    CellTemplate="{StaticResource DateColumn}"   
                    IsFilterable="False"
                    Header="Scan Date"  
                    TextAlignment="Left"
                    SortMemberPath="Started"
                    MinWidth="90"/>
                <telerik:GridViewColumn 
                    HeaderCellStyle="{StaticResource HeaderCellStyle}"
                    CellTemplate="{StaticResource TypeColumn}"   
                    IsFilterable="False"
                    Header="Scan Target"  
                    SortMemberPath="DevicesSourceDescription.Type"
                    TextAlignment="Left"
                    MinWidth="100"/>
                <telerik:GridViewColumn 
                    HeaderCellStyle="{StaticResource HeaderCellStyle}"
                    CellTemplate="{StaticResource MethodColumn}"   
                    IsFilterable="False"
                    SortMemberPath="ScanMethod"
                    Header="Scan Type"  
                    TextAlignment="Left"
                    MinWidth="110"/>
            </telerik:RadTreeListView.Columns>
        </telerik:RadTreeListView>
    </Grid>
</UserControl>
