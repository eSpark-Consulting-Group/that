                        <TextBlock Margin="8,6,0,8" x:Name="txt" Text="{Binding InstancesCount}" Grid.Column="2" HorizontalAlignment="Left" FontSize="13"/>
                    </Grid>
                </DataTemplate>
                
                <DataTemplate x:Key="SizeColumn">
                    <TextBlock Text="{Binding SizeString}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SizeString}" TextAlignment="Right" Margin="3 0"/>
                </DataTemplate>

                <DataTemplate x:Key="VerdictColumn">
                    <TextBlock Text="{Binding VerdictString}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding VerdictString}" TextAlignment="Left" Margin="3 0"/>
                </DataTemplate>
                
                <TemplateSelectors:ComputerFileTemplateSelector x:Key="NameTemplateSelector" 
                                                                FileTemplate="{StaticResource FileTemplate}"
                                                                ComputerTemplate="{StaticResource ComputerTemplate}"/>
            </telerik:RadTreeListView.Resources>
            <telerik:RadTreeListView.ChildTableDefinitions>
                <telerik:TreeListViewTableDefinition ItemsSource="{Binding Computers}" />
            </telerik:RadTreeListView.ChildTableDefinitions>
            <telerik:RadTreeListView.Columns>
                <telerik:GridViewColumn 
                    IsFilterable="False"
                    ShowFilterButton="False"
                    ShowFieldFilters="False"
                    HeaderCellStyle="{StaticResource HeaderCellStyle}"
                    CellTemplateSelector="{StaticResource NameTemplateSelector}"
                    Header="      Name" MinWidth="300"
                    Width="540*"        
                    SortMemberPath="ShortName" />
                <telerik:GridViewColumn 
                    CellTemplate="{StaticResource SizeColumn}"
                    SortMemberPath="SizeSorting"
                    IsFilterable="False"
                    Header="Size"  
                    HeaderCellStyle="{StaticResource HeaderCellStyle}"
                    TextAlignment="Right"
                    Width="80*" MinWidth="80"/>
                <telerik:GridViewColumn 
                    SortMemberPath="VerdictString"
                    CellTemplate="{StaticResource VerdictColumn}"   
                    IsFilterable="False"
                    Header="Verdict"  
                    HeaderCellStyle="{StaticResource HeaderCellStyle}"
                    TextAlignment="Left"
                    Width="160*" MinWidth="120"/>
            </telerik:RadTreeListView.Columns>
