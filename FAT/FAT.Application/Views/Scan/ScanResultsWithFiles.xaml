<UserControl    AutomationProperties.AutomationId="ScanResultsWithFilesScreen"
                x:Class="FAT.Application.ScanResultsWithFiles"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:Models="clr-namespace:FAT.Application.Models"
                xmlns:TemplateSelectors="clr-namespace:FAT.Application.TemplateSelectors"
                xmlns:converters="clr-namespace:FAT.Application.Converters"
                xmlns:Application="clr-namespace:FAT.Application"
                xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" mc:Ignorable="d" 
                xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
                d:DesignHeight="400" d:DesignWidth="600" Loaded="UserControl_Loaded">
    <Grid x:Name="grid" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grid" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0">
                            <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <CubicEase/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Telerik.Windows.Themes.Windows8;component/Themes/Telerik.Windows.Controls.Navigation.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <telerik:RadTreeListView AutomationProperties.AutomationId="UnknownFilesTree"
                                 SelectedItem="{Binding SelectedItem}" 
                                 CanUserFreezeColumns="False"                  
                                 CanUserReorderColumns="False"
                                 x:Name="treeList" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 ItemsSource="{Binding Files}"   
                                 AutoExpandItems="False"
                                 Sorting="treeList_Sorting"
                                 HierarchyIndent="34"
                                 EnableRowVirtualization="True" 
                                 IsSynchronizedWithCurrentItem="False" 
                                 ScrollMode="Deferred"
                                 MouseDoubleClick="OnTreeDoubleClick" >

            <telerik:RadTreeListView.Resources>

              
                <DataTemplate x:Key="ComputerTemplate">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                    <TextBlock Margin="8,0,0,0" Text="{Binding NameAndIpAddress}" FontSize="14" Grid.Column="0" HorizontalAlignment="Left"/>
                        <TextBlock Margin="8,0" Text="{Binding ShortName}"  FontSize="13" Grid.Column="1" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShortName}" />

                  </Grid>
                </DataTemplate>
                <DataTemplate x:Key="FileTemplate">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

