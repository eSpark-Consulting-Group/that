<UserControl    AutomationProperties.AutomationId="ScanResultsByFilesScreen"
                x:Class="FAT.Application.ScanResultsWithFiles"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:Models="clr-namespace:FAT.Application.Models"
                xmlns:TemplateSelectors="clr-namespace:FAT.Application.TemplateSelectors"
                xmlns:converters="clr-namespace:FAT.Application.Converters"
                xmlns:Application="clr-namespace:FAT.Application"
                xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" mc:Ignorable="d" 
                xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
                d:DesignHeight="400" d:DesignWidth="600" Loaded="UserControl_Loaded">
    <Grid x:Name="grid" Opacity="0" DataContext="{Binding DataContextSwitcher}">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grid" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2">
                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <CubicEase/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Telerik.Windows.Themes.Windows8;component/Themes/Telerik.Windows.Controls.Navigation.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <telerik:RadTreeListView AutomationProperties.AutomationId="ScanResultsByFilesTree"
                                 SelectionChanged="treeList_SelectionChanged"
                                 PreviewMouseDown="treeList_MouseDown"
                                 MouseDoubleClick="treeList_MouseDoubleClick"
                                 RowIsExpandedChanged="treeList_RowIsExpandedChanged"
                                 SelectionMode="Single"
                                 CanUserFreezeColumns="False"                                
                                 x:Name="treeList" 
                                 CanUserReorderColumns="False"
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 ItemsSource="{Binding Files}"   
                                 AutoExpandItems="False"
                                 HierarchyIndent="30"
                                 Validation.ErrorTemplate="{x:Null}"
                                 EnableRowVirtualization="True" 
                                 IsSynchronizedWithCurrentItem="False" 
                                 ScrollMode="Deferred">

            <telerik:RadTreeListView.Resources>
                <DataTemplate x:Key="ComputerTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Canvas Height="17" Width="20" Margin="0,0,0,0">
                            <Path SnapsToDevicePixels="True" Data="F1M80,139L94,128L94,139z" Fill="{Binding ElementName=txt, Path=Foreground}" Height="11" Canvas.Left="3" Opacity="0.3" Stretch="Fill" Canvas.Top="1" Width="14"/>
