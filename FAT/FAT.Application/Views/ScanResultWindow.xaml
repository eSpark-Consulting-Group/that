<Window x:Class="FAT.Application.ScanResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan Failed" Width="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" BorderThickness="3" WindowStyle="None" SizeToContent="Height" >

    <Border x:Name="Shadow" CornerRadius="4" BorderBrush="#11000000" BorderThickness="1" Margin="0">
        <Border CornerRadius="3" BorderBrush="#22000000" BorderThickness="1">
            <Border CornerRadius="2" BorderBrush="#33000000" BorderThickness="1">
                <Border CornerRadius="1" BorderBrush="#44000000" BorderThickness="1">
                    <Border x:Name="Border" BorderThickness="0" BorderBrush="{DynamicResource StrongBrush}" Background="#FFFAF9F9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>


                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="White" Grid.ColumnSpan="2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 15 20 0">
                                        <Button Style="{StaticResource CloseButton}" Background="#FF636973" Click="OnCloseClick" Width="18" Height="18" Margin="20 0 0 0" ToolTip="Close"/>
                                    </StackPanel>

                                    </Grid>
                            </Border>
                            <Grid Grid.Row="1">


 
                            </Grid>

                        </Grid>


                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
