<Window AutomationProperties.AutomationId="EulaFullWindow"
      x:Class="FAT.Application.EULAFullWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      MinHeight="745" MinWidth="1015"  Height="745" Width="1015"
      ShowInTaskbar="False" ResizeMode="NoResize"  WindowStartupLocation="CenterOwner"
      AllowsTransparency="True" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300" >

    <Border x:Name="Shadow" CornerRadius="4" BorderBrush="#11000000" BorderThickness="1" Margin="0">
        <Border CornerRadius="3" BorderBrush="#22000000" BorderThickness="1">
            <Border CornerRadius="2" BorderBrush="#33000000" BorderThickness="1">
                <Border CornerRadius="1" BorderBrush="#44000000" BorderThickness="1">
                    <Border x:Name="Border" BorderThickness="0" >
                        <Grid Background="#FFFCFCFC">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource StrongBrush}" Grid.ColumnSpan="2">
                                <Grid>
                                    <TextBlock Text="Forensic Analysis Tool" Foreground="White" FontFamily="{StaticResource myriadpro}"  FontSize="19" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 0 0"  SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Background="#FFFCFCFC">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <telerik:RadPdfViewer AutomationProperties.AutomationId="EulaDocument" Grid.RowSpan="7" MaxHeight="700" 
                                          x:Name="pdf" Mode="TextSelection" DocumentChanged="pdf_DocumentChanged" BorderThickness="0" VerticalAlignment="Stretch" 
                                          HorizontalAlignment="Stretch" Background="#FFFCFCFC" >
                                </telerik:RadPdfViewer>

                                <Border  Grid.Row="7" VerticalAlignment="Bottom"  Background="White">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button AutomationProperties.AutomationId="CancelButton" Content="Cancel"  Margin="0,15,5,15" Click="NoClick" Height="32" 
                                                Template="{StaticResource BackButton}" Foreground="Black"></Button>
                                        <Button AutomationProperties.AutomationId="IAcceptButton" Content="I ACCEPT"  Margin="5,15,15,15" Click="YesClick" Height="32" 
                                                Command="{Binding OnLoadedCommand}"></Button>
                                    </StackPanel>
                                </Border>
                                
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
