<Window AutomationProperties.AutomationId="EulaWindow"
      x:Class="FAT.Application.EULAWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      Width="600" Height="350" MaxHeight="350" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
      AllowsTransparency="True" Background="Transparent" BorderThickness="3" WindowStyle="None" SizeToContent="Height" MouseLeftButtonDown="Window_MouseLeftButtonDown"
      Loaded="EULAView_Loaded"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300" >

    <Border x:Name="Shadow" CornerRadius="4" BorderBrush="#11000000" BorderThickness="1" Margin="0">
        <Border CornerRadius="3" BorderBrush="#22000000" BorderThickness="1">
            <Border CornerRadius="2" BorderBrush="#33000000" BorderThickness="1">
                <Border CornerRadius="1" BorderBrush="#44000000" BorderThickness="1">
                    <Border x:Name="Border" BorderThickness="0" >
                        <Grid Background="#FFFCFCFC">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource StrongBrush}" Grid.ColumnSpan="2">
                                <Grid>
                                    <TextBlock Text="Forensic Analysis Tool" Foreground="White" FontFamily="{StaticResource myriadpro}"  FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 0 0"  SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Background="#FFFCFCFC">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Source="Assets/eula.png" x:Name="eula" VerticalAlignment="Top" Grid.RowSpan="7" HorizontalAlignment="Left" Width="149" Height="238"/>

                                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="20" Opacity="{Binding ElementName=eula, Path=Opacity}"
                                    FontFamily="{StaticResource myriadpro}" VerticalAlignment="Top" Margin="170,30,0,0" Foreground="#FF2A80B9" Text="License Agreement"/>

                                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Top" Opacity="{Binding ElementName=eula, Path=Opacity}"
                                    Margin="170,10,0,0" Grid.Row="1" Text="Please read the following license agreement carefully"/>

                                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Top"
                                    Margin="170,10,0,0" Grid.Row="2" Cursor="Hand" Opacity="{Binding ElementName=eula, Path=Opacity}">
                                    <Hyperlink PreviewMouseLeftButtonDown="Hyperlink_MouseDown"  Foreground="#FF547D98" FontSize="13">License agreement</Hyperlink>
                                </TextBlock>

                                <Border Height="1" Grid.Row="3" Margin="170, 20, 50, 10" Background="#FFEAECED" SnapsToDevicePixels="True" Opacity="{Binding ElementName=eula, Path=Opacity}"/>

                                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Top" Opacity="{Binding ElementName=eula, Path=Opacity}"
                                    Margin="170,10,0,0" Grid.Row="4" Text="By clicking 'I AGREE', you agree you have read and accepted"/>

                                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Top"
                                    Margin="170,0,0,0" Grid.Row="5" Text="COMODO Forensic Analysis Tool License Agreement" Opacity="{Binding ElementName=eula, Path=Opacity}"/>

                                <telerik:RadPdfViewer AutomationProperties.AutomationId="EulaDocument"  Grid.RowSpan="7" MaxHeight="0" 
                                          x:Name="pdf" Mode="TextSelection" DocumentChanged="pdf_DocumentChanged" BorderThickness="0" VerticalAlignment="Stretch" 
                                          HorizontalAlignment="Stretch" Background="#FFFCFCFC" >
                                    <telerik:RadPdfViewer.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="pdf" Storyboard.TargetProperty="Opacity" BeginTime="0">
                                                        <EasingDoubleKeyFrame KeyTime="0" Value="0" >
                                                        </EasingDoubleKeyFrame>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="pdf" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2">
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" >
                                                        </EasingDoubleKeyFrame>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </telerik:RadPdfViewer.Triggers>
                                </telerik:RadPdfViewer>

                                <Border  Grid.Row="7" VerticalAlignment="Bottom"  Background="White">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel"  Margin="0,15,5,15" Click="NoClick" Height="32" Template="{StaticResource BackButton}" Foreground="Black"></Button>
                                        <Button Content="I ACCEPT"  Margin="5,15,15,15" Click="YesClick" Height="32" Command="{Binding OnLoadedCommand}"></Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
