<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="APTAT.Core.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
   </configSections>
  <applicationSettings>
    <APTAT.Core.Properties.Settings>
      <setting name="ScanScope" serializeAs="String">
        <value>?:</value>
      </setting>
      <setting name="SkipGac" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="AgentDescentingTimeout" serializeAs="String">
        <value>02:00:00</value>
      </setting>
      <setting name="PackageDescentingTimeout" serializeAs="String">
        <value>00:10:00</value>
      </setting>
      <setting name="SupportedDnsNames" serializeAs="String">
        <value>localhost</value>
      </setting>
      <setting name="DescentMaximumConcurrencyLevel" serializeAs="String">
        <value>100</value>
      </setting>
      <setting name="DescentResultLifetime" serializeAs="String">
        <value>04:00:00</value>
      </setting>
      <setting name="DescentResultCleanupPeriod" serializeAs="String">
        <value>00:30:00</value>
      </setting>
      <setting name="MaxEndpointsAvailabilityResolverConcurrentTasks" serializeAs="String">
        <value>260</value>
      </setting>
      <setting name="FlsHost" serializeAs="String">
        <value>fls.security.comodo.com</value>
      </setting>
      <setting name="FlsPort" serializeAs="String">
        <value>4448</value>
      </setting>
      <setting name="FlsUploadInterval" serializeAs="String">
        <value>2</value>
      </setting>
      <setting name="FlsUploadHashesAtOnce" serializeAs="String">
        <value>20</value>
      </setting>
      <setting name="UseDevCam" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="valkyrieBaseUrl" serializeAs="String">
        <value>https://valkyrie.comodo.com/</value>
      </setting>
      <setting name="ReportFolder" serializeAs="String">
        <value>Reports</value>
      </setting>
    </APTAT.Core.Properties.Settings>
  </applicationSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>