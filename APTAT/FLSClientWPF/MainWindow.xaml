<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" x:Class="FLSClientWPF.MainWindow"
        mc:Ignorable="d"
        Title="{Binding Progress}"  Height="350" Width="525" Closed="MainWindow_OnClosed">
    <Grid Margin="0,1,0,-1">
        <Grid.RowDefinitions>
            <RowDefinition Height="294*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>




        <DataGrid x:Name="dataGrid" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Stretch"  ItemsSource="{Binding FlsResults}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hash" Binding="{Binding Sha1}" Width="*"/>
                <DataGridTextColumn Header="Verdict" Binding="{Binding FlsVerdictString}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button  Content="Cancel" HorizontalAlignment="Left" Margin="80 0 0 0 " Height="20" Width="75" Click="button1_Click" Grid.Column="0"/>
            <!--<Button Content="Start" HorizontalAlignment="Left"   Height="20"  Width="75" Click="button_Click" Grid.Column="0"/>-->
            <Button Content="Enqueue" HorizontalAlignment="Left"   Height="20" Margin="0 0 0 0"  Width="75" Click="button_Add" Grid.Column="0"/>
            
        </Grid>


    </Grid>
</Window>
