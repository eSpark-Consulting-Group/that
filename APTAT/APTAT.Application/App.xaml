                                                   CompletedBrush="Green" FailedBrush="#FFD64333" CanceledBrush="#FFD64333" ProgressBrush="#666" OfflineBrush="#999"/>
            <Converters:ScanStageToOpacityConverter x:Key="ScanStageToOpacityConverter"/>
