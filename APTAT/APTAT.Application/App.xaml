							Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />

                        <Path x:Name="PART_SortIndicator" Data="M10.000001,0 L20.000002,20 L2.3395899E-08,20 z" Fill="White" SnapsToDevicePixels="True"
								RenderTransformOrigin="0.5,0.5" Opacity="0" HorizontalAlignment="Center" Margin="0,3,0,0" VerticalAlignment="Top" Stretch="Fill" Width="8" Height="6">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <SkewTransform />
                                    <RotateTransform/>
