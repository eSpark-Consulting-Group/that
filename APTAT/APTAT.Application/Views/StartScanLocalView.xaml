                <Path Data="F1M579,594L569,594L569,593L579,593z" Fill="#FF53974F" Height="1" Stretch="Fill" Width="10" Canvas.Left="25" Canvas.Top="18"/>
                <Path Data="F1M575,596L569,596L569,595L575,595z" Fill="#FF53974F" Height="1" Stretch="Fill" Width="6" Canvas.Left="25" Canvas.Top="20"/>
                <Path Data="F1M579,603L569,603L569,602L579,602z" Fill="#FF53974F" Height="1" Stretch="Fill" Width="10" Canvas.Left="25" Canvas.Top="27"/>
