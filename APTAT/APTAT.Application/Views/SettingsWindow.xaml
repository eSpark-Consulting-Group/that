<Window x:Class="APTAT.Application.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
              xmlns:local="clr-namespace:APTAT.Application.Views"
         xmlns:converters="clr-namespace:APTAT.Application.Converters"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        Title="Options"   Width="600"   WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        SizeToContent="Height" MouseLeftButtonDown="Window_MouseLeftButtonDown" x:Name="this"  >
    <Border x:Name="Shadow" CornerRadius="4" BorderBrush="#11000000" BorderThickness="1" Margin="0">
        <Border CornerRadius="3" BorderBrush="#22000000" BorderThickness="1">
            <Border CornerRadius="2" BorderBrush="#33000000" BorderThickness="1">
                <Border CornerRadius="1" BorderBrush="#44000000" BorderThickness="1">
                    <Border x:Name="Border" BorderThickness="0" BorderBrush="{DynamicResource StrongBrush}" Background="#FFFAF9F9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource StrongBrush}" Grid.ColumnSpan="2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 15 20 0">
                                        <Button AutomationProperties.AutomationId="CloseAgentRequirementsCrossButton"
                                                Style="{StaticResource CloseButton}" Click="OnCloseClick" Width="18" Height="18" Margin="20 0 0 0" ToolTip="Close"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ElementName=this, Path=Header}" Foreground="White" FontFamily="Segoe UI Light"  FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 0 0"  SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Background="#FCFCFC" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                    
                                    <RowDefinition Height="Auto"></RowDefinition>
                                </Grid.RowDefinitions>

                                
                                <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0 20 20 20">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="570" Margin="0 10 0 10" Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding ElementName=this, Path=ShowCredentials, Converter={converters:BoolToVisibilityConverter2}}">
                                        <local:LoginPasswordUserControl Margin="0" Login="{Binding ProxyLogin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    
                                                    Password="{Binding ProxyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                                    </Grid>




                                    <TextBlock Text="FLS TCP Port" Style="{DynamicResource SubTitleTextStyle}" Grid.Row="3"  Margin="0 24 0 0" HorizontalAlignment="Right" Visibility="{Binding ElementName=this, Path=ShowCredentials, Converter={converters:BoolToVisibilityConverter2}, ConverterParameter=!}"/>
                                    <telerik:RadWatermarkTextBox AutomationProperties.AutomationId="FlsTcpPortWatermarkTextBox" Visibility="{Binding ElementName=this, Path=ShowCredentials, Converter={converters:BoolToVisibilityConverter2}, ConverterParameter=!}"
                                             Grid.Column="2" Margin="0 17 0 17" HorizontalAlignment="Left" Grid.Row="3" Width="275" x:Name="tcp"
                                             Text="{Binding  TcpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox">
                                        <telerik:RadWatermarkTextBox.WatermarkContent>
                                            <TextBlock Text="Enter FLS Port" Foreground="{DynamicResource TextBrush2}" />
                                        </telerik:RadWatermarkTextBox.WatermarkContent>
                                    </telerik:RadWatermarkTextBox>

                                    <TextBlock Text="FLS UDP Port" Style="{DynamicResource SubTitleTextStyle}" Grid.Row="4"  Margin="0 7 0 0" HorizontalAlignment="Right" Visibility="{Binding ElementName=this, Path=ShowCredentials, Converter={converters:BoolToVisibilityConverter2}, ConverterParameter=!}"/>
                                    <telerik:RadWatermarkTextBox AutomationProperties.AutomationId="FlsUdpPortWatermarkTextBox" Visibility="{Binding ElementName=this, Path=ShowCredentials, Converter={converters:BoolToVisibilityConverter2}, ConverterParameter=!}"
                                             Grid.Column="2" Margin="0 0 0 17" HorizontalAlignment="Left" Grid.Row="4" Width="275" x:Name="udp"
                                             Text="{Binding  UdpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox" Loaded="this_Loaded">
                                        <telerik:RadWatermarkTextBox.WatermarkContent>
                                            <TextBlock Text="Enter FLS Port" Foreground="{DynamicResource TextBrush2}" />
                                        </telerik:RadWatermarkTextBox.WatermarkContent>
                                    </telerik:RadWatermarkTextBox>



                                </Grid>
                                <Border Background="White" Grid.Row="2" >
                                    <StackPanel HorizontalAlignment="Right"  Margin="0,10,10,0" Orientation="Horizontal">
                                        <Button Content="Cancel" Height="32" x:Name="no" Margin="5,5,5,15" Click="Button_CancelClick" Template="{StaticResource BackButton}" Foreground="Black"></Button>
                                        <Button Content="Save" Height="32"  Margin="5,5,5,15"  Click="Button_Click"   ></Button>
                                        
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
