<Window AutomationProperties.AutomationId="CamCredentialsWindow"
        x:Class="APTAT.Application.CamCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
        
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
          Width="700"  WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"  WindowStyle="None"
        SizeToContent="Height" MouseLeftButtonDown="CamCredentialsWindow_OnMouseLeftButtonDown" >
    <Border x:Name="Shadow" CornerRadius="4" BorderBrush="#11000000" BorderThickness="1" Margin="0">
        <Border CornerRadius="3" BorderBrush="#22000000" BorderThickness="1">
            <Border CornerRadius="2" BorderBrush="#33000000" BorderThickness="1">
                <Border CornerRadius="1" BorderBrush="#44000000" BorderThickness="1">
                    <Border x:Name="Border" BorderThickness="0" BorderBrush="{DynamicResource StrongBrush}" Background="#FFFAF9F9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource StrongBrush}" Grid.ColumnSpan="2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 15 20 0">
                                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" Width="18" Height="18" Margin="20 0 0 0" ToolTip="Close"/>
                                    </StackPanel>

                                    <TextBlock Text="Submit to Valkyrie" Foreground="White" FontFamily="Segoe UI Light"  FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 0 0"  SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>


                            <Line X1="0" X2="0" Y1="80" Y2="380"
    Width="1" Grid.RowSpan="2" HorizontalAlignment="Right"   Opacity="0.2"
    Stroke="Black" StrokeDashArray="2, 2"
    StrokeThickness="4" />

                            <Grid Grid.Row="1" Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Please sign in with Comodo License Account credentials to analyze files with Valkyrie"  
                           Style="{StaticResource HeaderTextBlock}"
                           FontSize="16" 
                           Foreground="#555" 
                           FontFamily="Segoe UI"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="19,10,22,5"  Width="306"/>

                                <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="30, 10" Grid.Row="1" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <controls:RadWatermarkTextBox AutomationProperties.AutomationId="LoginWatermarkTextBox"
                                                  Grid.Column="0" Grid.Row="0" x:Name="LoginText" 
                                                  WatermarkContent="Enter User Name" 
                                                  Text="{Binding UserName, Mode=TwoWay}" >
                                    </controls:RadWatermarkTextBox>

                                    <controls:RadWatermarkTextBox AutomationProperties.AutomationId="PasswordWatermarkTextBox"
                                                  Grid.Column="0" Grid.Row="1" WatermarkContent="Enter Password"
                                                  Text="{Binding PasswordBuffer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 10">
                                    </controls:RadWatermarkTextBox>


                                    <Line X1="25" X2="130" Y1="0" Y2="0"
    Height="1"  Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"   Opacity="0.2"
    Stroke="Black" StrokeDashArray="2, 2"
    StrokeThickness="4" />

                                    <Line X1="160" X2="265" Y1="0" Y2="0"
    Height="1"  Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"   Opacity="0.2"
    Stroke="Black" StrokeDashArray="2, 2"
    StrokeThickness="4" />

                                    <TextBlock Text="or"   
                           Style="{StaticResource HeaderTextBlock}"
                           FontSize="16" 
                           Foreground="#555" 
                           FontFamily="Segoe UI"
                            HorizontalAlignment="Center" Margin="0 -2 0 0"
                           TextAlignment="Center" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>

                                    <controls:RadWatermarkTextBox AutomationProperties.AutomationId="CamLicenseKeyWatermarkTextBox"
                                                  Grid.Column="0" Grid.Row="3" x:Name="LicenseIdText" WatermarkContent="Enter License" 
                                                  Text="{Binding LicenseId, Mode=TwoWay}" Margin="0 10 0 0" Width="286">
                                    </controls:RadWatermarkTextBox>

                                    <TextBlock AutomationProperties.AutomationId="MessageTextBlock"
                               Foreground="Red" FontSize="14" TextWrapping="Wrap" Grid.Row="4" Text="{Binding ErrorMessage}"  Width="240" Margin="10"/>

                                </Grid>




                                <telerik:RadBusyIndicator Grid.Row="3" Background="Transparent" BorderBrush="Transparent" Height="50" Margin="0,0,0,20" x:Name="loading" x:FieldModifier="public" BusyContent="Checking Credentials..." VerticalAlignment="Center" HorizontalAlignment="Center" >
                                    <telerik:RadBusyIndicator.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.MergedDictionaries>
                                                <ResourceDictionary Source="/Telerik.Windows.Themes.Windows8;component/Themes/Telerik.Windows.Controls.xaml"/>
                                            </ResourceDictionary.MergedDictionaries>
                                        </ResourceDictionary>
                                    </telerik:RadBusyIndicator.Resources>

                                    <Button AutomationProperties.AutomationId="OkButton"
                        Grid.Row="3" Margin="0" Content="OK" x:Name="ok" x:FieldModifier="public"
                        VerticalAlignment="Center" Click="Button_Click"   >
                                    </Button>
                                </telerik:RadBusyIndicator>

                            </Grid>



                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>

                                    <RowDefinition Height="*"></RowDefinition>

                                </Grid.RowDefinitions>
                                <TextBlock Text="Please sign up to Valkyrie if you don't have a Valkyrie account yet"  
                           Style="{StaticResource HeaderTextBlock}"
                           FontSize="16" 
                           Foreground="#555" 
                           FontFamily="Segoe UI"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="19,10,22,5"  Width="306"/>

                                <TextBlock Grid.Row="1"  TextWrapping="Wrap" FontSize="13" TextAlignment="Center" Width="300" Margin="0 26 0 0"  >
                <Hyperlink NavigateUri="https://valkyrie.comodo.com" RequestNavigate="Hyperlink_OnRequestNavigate">Valkyrie </Hyperlink>
                    is a cloud based file analysis service for submitted known and unknown files with a range of static and dynamic detectors including file lookup, heuristics and real-time behaviour analysis</TextBlock>

                                <Button AutomationProperties.AutomationId="GetValkyrieButton" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="Green" BorderBrush="Green"
                        Grid.Row="2"   x:Name="GetValkyrieButton" Click="GetValkyrieButton_OnClick"  Margin="0 0 0 29" Content="Sign Up" >

                                </Button>

                            </Grid>


                        </Grid>


                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
