<Window AutomationProperties.AutomationId="CamCredentialsWindow"
        x:Class="APTAT.Application.CamCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
        
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
          Width="700"  WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" BorderThickness="3" WindowStyle="None"
        SizeToContent="Height" MouseLeftButtonDown="CamCredentialsWindow_OnMouseLeftButtonDown" >

    <Border x:Name="Border" BorderThickness="1" BorderBrush="{DynamicResource StrongBrush}" Background="#FFFAF9F9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource StrongBrush}" Grid.ColumnSpan="2">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 15 20 0">
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" Width="18" Height="18" Margin="20 0 0 0" ToolTip="Close"/>
                    </StackPanel>

                    <TextBlock Text="Activate Valkyrie" Foreground="White" FontFamily="Segoe UI Light"  FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 0 0"  SnapsToDevicePixels="True"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Please enter your CAM credentials to analyse files with Valkyrie"  
                           FontSize="16" 
                           FontWeight="Bold"
                           Foreground="#555" 
                           FontFamily="Segoe UI Ligh"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="19,10,22,5" Style="{StaticResource HeaderTextBlock}" Width="306"/>

                <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="30, 10" Grid.Row="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <controls:RadWatermarkTextBox AutomationProperties.AutomationId="LoginWatermarkTextBox"
                                                  Grid.Column="0" Grid.Row="0" x:Name="LoginText" 
                                                  WatermarkContent="Enter User Name" 
                                                  Text="{Binding UserName, Mode=TwoWay}" >
                    </controls:RadWatermarkTextBox>

                    <controls:RadWatermarkTextBox AutomationProperties.AutomationId="PasswordWatermarkTextBox"
                                                  Grid.Column="0" Grid.Row="1" WatermarkContent="Enter Password"
                                                  Text="{Binding PasswordBuffer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 10">
                    </controls:RadWatermarkTextBox>

                    <Label Content="-------------------- OR ------------------------" 
                           Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" FontWeight="Bold">
                    </Label>

                    <controls:RadWatermarkTextBox AutomationProperties.AutomationId="CamLicenseKeyWatermarkTextBox"
                                                  Grid.Column="0" Grid.Row="3" x:Name="LicenseIdText" WatermarkContent="Enter License" 
                                                  Text="{Binding LicenseId, Mode=TwoWay}" Margin="0 10 0 0" Width="286">
                    </controls:RadWatermarkTextBox>

                    <TextBlock AutomationProperties.AutomationId="MessageTextBlock"
                               Foreground="Red" FontSize="14" TextWrapping="Wrap" Grid.Row="4" Text="{Binding ErrorMessage}"  Width="240" Margin="10"/>

                </Grid>




                <telerik:RadBusyIndicator Grid.Row="3" Background="#FFFAF9F9" Height="50" Margin="0,0,0,20" x:Name="loading" x:FieldModifier="public" BusyContent="Checking Credentials..." VerticalAlignment="Center" HorizontalAlignment="Center" >

                    <Button AutomationProperties.AutomationId="OkButton"
                        Grid.Row="3" Margin="0" Content="OK" x:Name="ok" x:FieldModifier="public"
                        VerticalAlignment="Center" Click="Button_Click"   >
                    </Button>
                </telerik:RadBusyIndicator>

            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="90"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0 10 0 0" HorizontalAlignment="Center" Grid.Row="0">
                    <TextBlock  FontSize="16" Foreground="Green"
                   >OR</TextBlock>
                    <TextBlock  Text=" Get Valkyrie if you do not have CAM credentials" TextWrapping="Wrap"  TextAlignment="Left" FontSize="16" FontWeight="Bold" Foreground="#555"   Width="237"/>
                </StackPanel>
               
                <TextBlock Grid.Row="3"  TextWrapping="Wrap" FontSize="13" TextAlignment="Center" Width="300"   >
                <Hyperlink NavigateUri="https://valkyrie.comodo.com" RequestNavigate="Hyperlink_OnRequestNavigate">Valkyrie </Hyperlink>
                    is a cloud based file analysis service for submitted files with a range of static and dynamic detectors including heuristics, file look-up and real time behaviour analysis.
                </TextBlock>

                <Button AutomationProperties.AutomationId="GetValkyrieButton"  HorizontalAlignment="Center" 
                        Grid.Row="4"   x:Name="GetValkyrieButton" Click="GetValkyrieButton_OnClick"  Margin="0 0 20 0" Content="Get Valkyrie" >
                   
                </Button>

            </Grid>


        </Grid>


    </Border>
</Window>
