                                                <TextBlock HorizontalAlignment="Center" Style="{DynamicResource SubTitleTextStyle}" Foreground="{DynamicResource StrongBrush}" Grid.Column="1" Margin="0 50 0 0">
                                                    <TextBlock.Text>
                                                        This Computer
                                                    </TextBlock.Text>
                                                </TextBlock>

                                                <TextBlock Opacity="0.5" Grid.Row="1" Grid.Column="1" Style="{DynamicResource SubTitleTextStyle}" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Scan this computer"/>
                                            </Grid>
                                            <Border Background="#FFF1F0F0" Height="1" VerticalAlignment="Bottom"  HorizontalAlignment="Stretch" SnapsToDevicePixels="True"/>
                                        </Grid>

                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <Trigger Trigger.Property="UIElement.IsMouseOver" Trigger.Value="True">
                                            <TriggerBase.ExitActions>
                                                <BeginStoryboard BeginStoryboard.Name="AnimaMouseLeave_BeginStoryboard" BeginStoryboard.Storyboard="{StaticResource AnimaMouseLeave}" />
                                            </TriggerBase.ExitActions>
                                            <TriggerBase.EnterActions>
                                                <BeginStoryboard BeginStoryboard.Name="AnimaMouseEnter_BeginStoryboard" BeginStoryboard.Storyboard="{StaticResource AnimaMouseEnter}" />
                                            </TriggerBase.EnterActions>
                                        </Trigger>
                                        <Trigger Trigger.Property="IsPressed" Trigger.Value="True">
                                            <Setter Setter.TargetName="MouseOverElement" Property="Border.Background" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="translate4" X="600" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="translate4" Storyboard.TargetProperty="X" BeginTime="0:0:0.3">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0" >
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                    </Grid>
                </Border>

                <Border x:Name="wizardBorder" Visibility="Collapsed" >
                    <Grid>
                        <App:StartScanDomainView AutomationProperties.AutomationId="ActiveDirectoryView" x:Name="viewScanDomain" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"  />
                        <App:StartScanWorkgroupView AutomationProperties.AutomationId="WorkgroupView" x:Name="viewScanWorkgroup"  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"  />
                        <App:StartScanByIpView AutomationProperties.AutomationId="NetworkAddressesView" x:Name="viewScanByIp" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"  />
                        <App:StartScanLocalView x:Name="viewScanLocal" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"  />
                    </Grid>
                </Border>

            </Grid>
        </telerik:RadBusyIndicator>

        <Border Grid.Row="0" BorderThickness="0" Background="{DynamicResource ErrorBrush2}" BorderBrush="#FF6A0101" VerticalAlignment="Top" CornerRadius="0" 
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <TextBlock AutomationProperties.AutomationId="ErrorTextBlock" Foreground="White" Text="{Binding Error}" Style="{DynamicResource SubTitleTextStyle}" Margin="20 10"   FontSize="13"/>
                <Button Style="{StaticResource CloseButton}" Background="White" Command="{Binding ClearErrorMessageCommand}" Margin="0 0 20 0" Width="12" Height="12" HorizontalAlignment="Right"  ToolTip="Hide" />
            </Grid>

        </Border>

        <Border  Grid.Row="2"  Height="60" >
            <Grid>

                <Button AutomationProperties.AutomationId="BackButton"
                            x:Name="btnBack" Content="Back" HorizontalAlignment="Left" Margin="17,0,0,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" 
                            Visibility="{Binding IsBackEnabled, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" 
                            Click="OnBackClick" Template="{StaticResource BackButton}" Foreground="Black"/>

                <StackPanel AutomationProperties.AutomationId="ToolBarPanel"
                            Orientation="Horizontal"  HorizontalAlignment="Right" Height="50" Margin="0,0,17,0">


                    <Button AutomationProperties.AutomationId="QuickScanButton"
                            x:Name="btnQuickScan"
                            Visibility="{Binding IsFinishEnabled, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                            IsDefault="{Binding EnableDefaultButtons, FallbackValue=True}" 
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"  
                            Content="Quick Scan" 
                            Click="OnQuickScanClick" Margin="5"    />
                    <Button AutomationProperties.AutomationId="FullScanButton"
                            x:Name="btnFinish"
                            Visibility="{Binding IsFinishEnabled, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                            IsDefault="{Binding EnableDefaultButtons, FallbackValue=True}" 
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"  
                            Content="Full Scan" 
                            Click="OnFinishClick" Margin="12 5 0 5"   />
                </StackPanel>

                <Button 
                            x:Name="cancel"
                            Content="Cancel" 
                            HorizontalAlignment="Right"  Margin="5 5 17 5"
                            Click="OnCancelClick"  
                            />

                <Grid HorizontalAlignment="Right"  Margin="5 5 17 5" Visibility="{Binding IsNextEnabled, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" >
                    <Button AutomationProperties.AutomationId="NextButton"
                            x:Name="btnNext"  
                            
                            IsDefault="{Binding EnableDefaultButtons, FallbackValue=True}" 
                            Content="Next" Visibility="{Binding IsBackEnabled, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" 
                            
                            Click="OnNextClick"  
                            />
                </Grid>



            </Grid>

        </Border>

    </Grid>

</Models:BaseView>
