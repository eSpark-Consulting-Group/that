<Window x:Class="APTAT.Application.ThreatDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Application="clr-namespace:APTAT.Application"
        Title="DETAILS"
        MaxWidth="850" 
        MaxHeight="420"
        MinWidth="915" 
        MinHeight="420"
        WindowStyle="None"
                AllowsTransparency="True" Background="Transparent" BorderThickness="3"
                ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border x:Name="Border" BorderThickness="1" BorderBrush="{DynamicResource StrongBrush}" Background="#FFFAF9F9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
           

            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource StrongBrush}" Grid.ColumnSpan="2">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 15 20 0">
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" Width="18" Height="18" Margin="20 0 0 0" ToolTip="Close"/>
                    </StackPanel>

                    <TextBlock Text="Details" Foreground="White" FontFamily="Segoe UI Light"  FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 0 0"  SnapsToDevicePixels="True"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Application:ThreatDetailsView BackClick="OnBackClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
