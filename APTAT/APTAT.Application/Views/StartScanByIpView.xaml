        <Grid x:Name="panelSelectIp" Grid.Row="2" Visibility="{Binding CurrentStep, Converter={StaticResource StringToVisibiltyConverter}, ConverterParameter=SelectIp, FallbackValue=Collapsed}">
            <Grid.Resources>
                <DataTemplate x:Key="ItemTemplate">
                    <TextBlock Text="{Binding FormattedText}" Style="{DynamicResource SubTitleTextStyle}" Margin="10 4"   FontSize="13"/>
                </DataTemplate>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="20,20,7,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="135"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:TextEntryListView Margin="5,0,0,0" BorderThickness="0" x:Name="TextEntryListView"
                        Grid.Column="1" Grid.ColumnSpan="2"
                        AddCommand="{Binding AddIpCommand}"
                        RemoveCommand="{Binding DeleteIpCommand}"
                                         RemoveAllCommand="{Binding DeleteAllIpCommand}"
                        ItemTemplate="{StaticResource ItemTemplate}"
                        ItemsSource="{Binding IpAddresses}"/>
            </Grid>

        </Grid>

        <Grid x:Name="panelSelectPort" Grid.Row="2" Visibility="{Binding CurrentStep, Converter={StaticResource StringToVisibiltyConverter}, ConverterParameter=SelectPort, FallbackValue=Collapsed}">



            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="-80,60,7,20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Text="FLS TCP Port" Style="{DynamicResource SubTitleTextStyle}" Grid.Row="1"  Margin="0 24 0 0" HorizontalAlignment="Right" />
                <telerik:RadWatermarkTextBox Grid.Column="2" Margin="0 17 0 17" HorizontalAlignment="Left" Grid.Row="1" Width="289" Text="{Binding  ParentViewModel.TcpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox">
                    <telerik:RadWatermarkTextBox.WatermarkContent>
                        <TextBlock Text="Enter FLS Port" Foreground="{DynamicResource TextBrush2}" />
                    </telerik:RadWatermarkTextBox.WatermarkContent>
                </telerik:RadWatermarkTextBox>

                <TextBlock Text="FLS UDP Port" Style="{DynamicResource SubTitleTextStyle}" Grid.Row="2"  Margin="0 7 0 0" HorizontalAlignment="Right" />
                <telerik:RadWatermarkTextBox Grid.Column="2" Margin="0 0 0 17" HorizontalAlignment="Left" Grid.Row="2" Width="289" Text="{Binding  ParentViewModel.UdpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox">
                    <telerik:RadWatermarkTextBox.WatermarkContent>
                        <TextBlock Text="Enter FLS Port" Foreground="{DynamicResource TextBrush2}" />
                    </telerik:RadWatermarkTextBox.WatermarkContent>
                </telerik:RadWatermarkTextBox>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="0 0 0 0" Grid.ColumnSpan="3">
                    <local:LoginPasswordUserControl Margin="0" Login="{Binding ParentViewModel.Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    ShowCurrentDomain="{Binding ParentViewModel.UseCurrentCredentials, UpdateSourceTrigger=PropertyChanged}" 
                                                    Password="{Binding ParentViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UseCurrentDomain="{Binding ParentViewModel.UseCurrentDomainForDeploy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>




            </Grid>

        </Grid>

    </Grid>

</UserControl>
