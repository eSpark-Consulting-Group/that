                                 IsOptionElementsEnabled="True"
                                 IsTriStateMode="True"
                                 Checked="OnChecked"
                                 FontSize="14"
                                 Unchecked="OnUnchecked"
                                 ItemPrepared="OnItemPrepared"
                                 ItemTemplate="{StaticResource DomainTreeItemTemplate}"
