        <Grid x:Name="panelSelectDomain" Grid.Row="2" Visibility="{Binding CurrentStep, Converter={StaticResource StringToVisibiltyConverter}, ConverterParameter=SelectWorkgroup, FallbackValue=Collapsed}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Margin="22 80 0 0 ">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <RadioButton HorizontalAlignment="Left" Grid.Row="0" Margin="-245 -2 0 0" Grid.Column="2" Content="Search Available Workgroups (may take some time)" IsChecked="{Binding EnumerateWorkgroups, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <RadioButton HorizontalAlignment="Right" Grid.Row="1" Margin="40 17 0 6" Content="Use Known Workgroup Name" IsChecked="{Binding EnumerateWorkgroups, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:BoolInvertConverter}}" Checked="RadioButton_Checked"/>

                <telerik:RadWatermarkTextBox Grid.Column="2" Grid.Row="1" x:Name="text" Width="289" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsEnabled="{Binding EnumerateWorkgroups, Converter={converters:BoolInvertConverter}, ConverterParameter=!}" Text="{Binding WorkgroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <telerik:RadWatermarkTextBox.WatermarkContent>
                        <TextBlock Text="Enter Workgroup Name" Foreground="{DynamicResource TextBrush2}" />
                    </telerik:RadWatermarkTextBox.WatermarkContent>
                   
                </telerik:RadWatermarkTextBox>

            </Grid>

        </Grid>
        <Grid x:Name="panelSelectComputers" Grid.Row="2" Visibility="{Binding CurrentStep, Converter={StaticResource StringToVisibiltyConverter}, ConverterParameter=SelectTargets, FallbackValue=Collapsed}">
            <Grid.Resources>
                <DataTemplate x:Key="DomainTreeItemTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Grid.Column="1"/>
                    </Grid>
                </DataTemplate>
            </Grid.Resources>

            <Border Margin="160,30,160,30" BorderThickness="0" Background="White">
                <telerik:RadTreeView AutomationProperties.AutomationId="WTree"
                                 x:Name="workgroupTree"                               
                                 SnapsToDevicePixels="True"
                                 IsOptionElementsEnabled="True"
                                 IsTriStateMode="True"
                                 Checked="OnChecked"
                                 FontSize="14"
                                 Unchecked="OnUnchecked"
                                 ItemPrepared="OnItemPrepared"
                                 ItemTemplate="{StaticResource DomainTreeItemTemplate}"
                                 LoadOnDemand="OnLoadOnDemand" 
                                 ItemsSource="{Binding Items}" 
                                 IsLoadOnDemandEnabled="true" />
            </Border>

        </Grid>
        <Grid x:Name="panelSelectPort" Grid.Row="2" Visibility="{Binding CurrentStep, Converter={StaticResource StringToVisibiltyConverter}, ConverterParameter=SelectPort, FallbackValue=Collapsed}">



            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="-80,60,7,20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Text="FLS TCP Port" Style="{DynamicResource SubTitleTextStyle}" Grid.Row="1"  Margin="0 24 0 0" HorizontalAlignment="Right" />
                <telerik:RadWatermarkTextBox Grid.Column="2" Margin="0 17 0 17" HorizontalAlignment="Left" Grid.Row="1" Width="289" Text="{Binding  ParentViewModel.TcpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox">
                    <telerik:RadWatermarkTextBox.WatermarkContent>
                        <TextBlock Text="Enter FLS Port" Foreground="{DynamicResource TextBrush2}" />
                    </telerik:RadWatermarkTextBox.WatermarkContent>
                </telerik:RadWatermarkTextBox>

                <TextBlock Text="FLS UDP Port" Style="{DynamicResource SubTitleTextStyle}" Grid.Row="2"  Margin="0 7 0 0" HorizontalAlignment="Right" />
                <telerik:RadWatermarkTextBox Grid.Column="2" Margin="0 0 0 17" HorizontalAlignment="Left" Grid.Row="2" Width="289" Text="{Binding  ParentViewModel.UdpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox">
                    <telerik:RadWatermarkTextBox.WatermarkContent>
                        <TextBlock Text="Enter FLS Port" Foreground="{DynamicResource TextBrush2}" />
                    </telerik:RadWatermarkTextBox.WatermarkContent>
                </telerik:RadWatermarkTextBox>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="0 0 0 0" Grid.ColumnSpan="3">
                    <local:LoginPasswordUserControl Margin="0" Login="{Binding ParentViewModel.Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Password="{Binding ParentViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UseCurrentDomain="{Binding ParentViewModel.UseCurrentDomainForDeploy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>




            </Grid>

        </Grid>
    </Grid>

