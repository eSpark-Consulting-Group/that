                                 VerticalAlignment="Top"  IsOverflowOpen="False" GripVisibility="Collapsed" IsManipulationEnabled="False" OverflowButtonVisibility="Collapsed"  BorderThickness="0" Background="#FFFAF9F9">

                <telerik:RadButton AutomationProperties.AutomationId="StartScanningButton"
                               Margin="-2,-2,0,-2"  
                               FontSize="16"
                               Padding="20,20"
                               IsTabStop="True"
                               Command="{Binding StartScanCommand}">
                    <telerik:RadButton.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
