        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <telerik:RadBusyIndicator Grid.Row="1"  IsBusy="{Binding IsBusy}" BusyContent="Resolving Computers..." x:Name="loading" Background="Transparent" BorderBrush="Transparent" IsTabStop="false" FocusVisualStyle="{x:Null}">
            <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding ValkyrieSendingFiles}" BusyContent="Sending Files for Analysis..." Background="Transparent" BorderBrush="Transparent" IsTabStop="false" FocusVisualStyle="{x:Null}">
                <Grid>

                    <ContentControl x:Name="mainContent" IsTabStop="false" FocusVisualStyle="{x:Null}"/>

                    <StackPanel Orientation="Vertical" Visibility="{Binding IsItemsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" 
                   HorizontalAlignment="Center"  Opacity="{Binding IsScanInProgress, Converter={StaticResource InverseBoolToOpacityConverter}}">

                        <TextBlock AutomationProperties.AutomationId="NoScansTextBlock" Text="There are no scans have been performed yet."
                   Opacity="0.5"
                   
                   FontSize="13" Style="{DynamicResource SubTitleTextStyle}"/>

                        <Button AutomationProperties.AutomationId="StartScanningNowButton"
                    Margin="0,10,0,0"  HorizontalAlignment="Center"
                    
                    Style="{StaticResource LinkButton}" 
                   
                    Command="{Binding StartScanCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
