                              Height="24" 
                              Width="24" Margin="0,0,10,0"/>
                            <TextBlock Text="Stop Scanning" Grid.Column="1" Style="{StaticResource HeaderTextBlock}" FontSize="16"
                   FontFamily="Segoe UI"/>
                        </Grid>
                    </telerik:RadButton.Content>
                </telerik:RadButton>

                <telerik:RadDropDownButton AutomationProperties.AutomationId="ReportsDropDownButton"
                                           AutoOpenDelay="0:0:0.0"
                                           Content="Reports"
                                           IsEnabled="{Binding IsReportEnabled}"
                                           Style="{StaticResource RadDropDownButtonStyle2}"
                                           Margin="-2,-2,0,-2"  
                                           ContentTemplate="{StaticResource ReportButtonContentTemplate}"
                                           x:Name="ReportButton"
                                           FontSize="16"
                                           Padding="20,20,0,20">
                    <telerik:RadDropDownButton.DropDownContent>
                        <telerik:RadContextMenu AutomationProperties.AutomationId="ReportsContextMenu" IconColumnWidth="0" Width="160" BorderThickness="0">
                            <telerik:RadMenuItem AutomationProperties.AutomationId="ExecutiveReportMenuItem" HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" 
                                                 Header="Executive" Click="OnExecutiveReportClick"  Visibility="{Binding ShowFlsReportsMenu, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <telerik:RadMenuItem AutomationProperties.AutomationId="PerDeviceReportMenuItem" 
                                                 HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="Per Device" Click="OnPerDeviceReportClick" Visibility="{Binding ShowFlsReportsMenu, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <telerik:RadMenuItem AutomationProperties.AutomationId="PerProgramReportMenuItem"
                                                 HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="Per Program" Click="OnPerProgramReportClick" Visibility="{Binding ShowFlsReportsMenu, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <telerik:RadMenuItem AutomationProperties.AutomationId="ExecutiveValkyrieReportMenuItem"
                                                 HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="Executive Valkyrie" Click="OnExecutiveReportValkyrieClick"  Visibility="{Binding IsValkyrieReportEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <telerik:RadMenuItem AutomationProperties.AutomationId="PerDeviceValkyrieReportMenuItem"
                                                 HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="Per Device Valkyrie" Click="OnPerDeviceReportValkyrieClick" Visibility="{Binding IsValkyrieReportEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <telerik:RadMenuItem AutomationProperties.AutomationId="PerProgramValkyrieReportMenuItem"
                                                 HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="Per Program Valkyrie" Click="OnPerProgramReportValkyrieClick" Visibility="{Binding IsValkyrieReportEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </telerik:RadContextMenu>
                    </telerik:RadDropDownButton.DropDownContent>
                </telerik:RadDropDownButton>

                <telerik:RadDropDownButton AutomationProperties.AutomationId="HelpDropDownButton"
                                          AutoOpenDelay="0:0:0.0"
                                          Content="Help"
                                          Style="{StaticResource RadDropDownButtonStyle2}"
                                          Margin="-2,-2,0,-2"  
                                          ContentTemplate="{StaticResource AboutButtonContentTemplate}"
                                          x:Name="HelpButton"
                                          FontSize="16"
                                          Padding="20,20,0,20">
                    <telerik:RadDropDownButton.DropDownContent>
                        <telerik:RadContextMenu AutomationProperties.AutomationId="HelpContextMenu" IconColumnWidth="0" Width="160" BorderThickness="0">
                            <telerik:RadMenuItem AutomationProperties.AutomationId="AboutMenuItem" HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="About" Click="AboutClick"  />
                            <telerik:RadMenuItem AutomationProperties.AutomationId="AgentRequirementsMenuItem" HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}"  Header="Agent Requirements" Click="AgentClick"  />
                        </telerik:RadContextMenu>
                    </telerik:RadDropDownButton.DropDownContent>
                </telerik:RadDropDownButton>

            </telerik:RadToolBar>

            <Controls:SearchUserControl
                                        AutomationProperties.AutomationId="SearchControl" Keyword="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        x:Name="SearchTextBox" Grid.Column="1" VerticalAlignment="Top"   TabIndex="0"                 
                                        Margin="0 3 20 0" Width="160" HorizontalAlignment="Right"  
                                        IsEnabled="{Binding IsAnyScanInProgress, Converter={StaticResource InverseBooleanConverter}}">
            </Controls:SearchUserControl>

        </Grid>

        <Grid Grid.Row="2"  Visibility="{Binding IsItemsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Border  Background="{StaticResource StrongBrush}"  Height="35"  Visibility="{Binding IsValkyrieAnalysCompleted, Converter={StaticResource BoolToVisibilityConverter}}">

                <TextBlock AutomationProperties.AutomationId="ValkyrieTextBlock" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Hyperlink AutomationProperties.AutomationId="ValkyrieLink"
                       x:Name="ValkyrieHyperLink" NavigateUri="{Binding ValkyrieDetailsLink}" RequestNavigate="Hyperlink_RequestNavigate"  Foreground="#B1F984" FontSize="16">
                       Please click here to see the detailed results
            </Hyperlink>
                </TextBlock>
            </Border>
        </Grid>
        

        <Border Grid.Row="3"  Height="35" Background="{StaticResource StrongBrush}" Visibility="{Binding IsItemsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <DockPanel   Height="35" >
                <TextBlock Margin="10,0,0,0" />
                <TextBlock AutomationProperties.AutomationId="UnknownFilesCounterTextBlock" 
                           Foreground="White" Text="{Binding UnknownFilesCount}" VerticalAlignment="Center" Margin="0,5,0,5" FontSize="14"/>
                <TextBlock Foreground="White" Text=" Unknown programs found" VerticalAlignment="Center" Margin="0,5" FontSize="14" />
                <StackPanel  Orientation="Horizontal" >
                    <TextBlock Foreground="White" Text=", " VerticalAlignment="Center" Margin="0,5" FontSize="14" />
                    <TextBlock AutomationProperties.AutomationId="MalwareFilesCounterTextBlock" 
                           Foreground="White" Text="{Binding MalwareFilesCount}" VerticalAlignment="Center" Margin="0,5,0,5" FontSize="14"/>
                    <TextBlock Foreground="White" Text=" Malware items found" VerticalAlignment="Center" Margin="0,5" FontSize="14"/>
                </StackPanel>

                <TextBlock Foreground="White" Text=" (" VerticalAlignment="Center" Margin="0,5" FontSize="14"/>
                <TextBlock AutomationProperties.AutomationId="ScannedItemsCountTextBlock" 
                           Foreground="White" Text="{Binding ScannedItemsCount}" VerticalAlignment="Center" Margin="0,5" FontSize="14"/>
                <TextBlock Foreground="White" Text=" of " VerticalAlignment="Center" Margin="0,5" FontSize="14"/>
                <TextBlock AutomationProperties.AutomationId="TotalItemsCountTextBlock" 
                           Foreground="White" Text="{Binding TotalItemsCount}" VerticalAlignment="Center" Margin="0,5" FontSize="14"/>
                <TextBlock  Foreground="White" Text=" Computers scanned)" VerticalAlignment="Center" Margin="0,5" FontSize="14"/>



            </DockPanel >
        </Border>


    </Grid>
</Models:BasePage>
