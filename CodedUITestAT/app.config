<?xml version="1.0"?>
<configuration>
	<configSections>
		<sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="CodedUITestAT.Settings.Scanner" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
   <section name="CodedUITestAT.Settings.Results" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
   <section name="CodedUITestAT.Settings.General" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
			<section name="CodedUITestAT.Settings.WaitingTime" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
			<section name="CodedUITestAT.Settings.ScanCompleted" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
		</sectionGroup>
 </configSections>
	<applicationSettings>
		<CodedUITestAT.Settings.Scanner>
   <setting name="ServiceName" serializeAs="String">
    <value>ScannerService.exe</value>
   </setting>
   <setting name="Directory" serializeAs="String">
    <value>Windows\ComodoAptAtScanner</value>
   </setting>
   <setting name="ExeName64" serializeAs="String">
    <value>cmdapt64.exe</value>
   </setting>
   <setting name="ExeName86" serializeAs="String">
    <value>cmdapt86.exe</value>
   </setting>
   <setting name="TxtFiles" serializeAs="Xml">
    <value>
     <ArrayOfString xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <string>scan_status.txt</string>
      <string>tvl.txt</string>
      <string>trl.txt</string>
     </ArrayOfString>
    </value>
   </setting>
  </CodedUITestAT.Settings.Scanner>
  <CodedUITestAT.Settings.Results>
   <setting name="ScanStatusIndicatorCompleted" serializeAs="String">
    <value>Completed:</value>
   </setting>
   <setting name="ScanStatusIndicatorFailed" serializeAs="String">
    <value>Failed:</value>
   </setting>
   <setting name="ScanStatusIndicatorNotAccessible" serializeAs="String">
    <value>This computer is not accessible</value>
   </setting>
   <setting name="ScanStatusIndicatorStopped" serializeAs="String">
    <value>Scan operation was canceled.</value>
   </setting>
   <setting name="ScanStatusIndicatorRunning" serializeAs="Xml">
    <value>
     <ArrayOfString xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <string>%).</string>
      <string>Initializing</string>
      <string>Starting</string>
      <string>Enumerating</string>
     </ArrayOfString>
    </value>
   </setting>
   <setting name="ScanStatusIndicatorFailedFullMessage" serializeAs="String">
    <value>Failed: Login problem: invalid username or bad password. The user name or password is incorrect</value>
   </setting>
  </CodedUITestAT.Settings.Results>
  <CodedUITestAT.Settings.General>
   <setting name="ATApplicationProcessName" serializeAs="String">
    <value>UnknownFileHunter</value>
   </setting>
   <setting name="CamLogin" serializeAs="String">
    <value>esm.reseller@gmail.com</value>
   </setting>
   <setting name="CamPassword" serializeAs="String">
    <value>sellthemall</value>
   </setting>
   <setting name="CamKey" serializeAs="String">
    <value>c593bd1c-ca67-4013-914d-0fe852d72108</value>
   </setting>
   <setting name="ValkyrieUri" serializeAs="String">
    <value>https://valkyrie.comodo.com/signup_apikey</value>
   </setting>
   <setting name="ThreatName" serializeAs="String">
    <value>91exestealth.exe</value>
   </setting>
   <setting name="NoScansTextBlockText" serializeAs="String">
    <value>There are no scans have been performed yet.</value>
   </setting>
  </CodedUITestAT.Settings.General>
		<CodedUITestAT.Settings.WaitingTime>
   <setting name="QuickScanWaitTime" serializeAs="String">
    <value>1200000</value>
   </setting>
   <setting name="ValkyrieAnalysisWaitTime" serializeAs="String">
    <value>1200000</value>
   </setting>
   <setting name="WpfTreeWaitTime" serializeAs="String">
    <value>60000</value>
   </setting>
   <setting name="LaunchAppWaitTime" serializeAs="String">
    <value>60000</value>
   </setting>
  </CodedUITestAT.Settings.WaitingTime>
		<CodedUITestAT.Settings.ScanCompleted>
   <setting name="ScanCompletedText" serializeAs="String">
    <value>Scan Completed!</value>
   </setting>
   <setting name="UnknownFile" serializeAs="String">
    <value>Unknown</value>
   </setting>
   <setting name="Malware" serializeAs="String">
    <value>Malware</value>
   </setting>
  </CodedUITestAT.Settings.ScanCompleted>
	</applicationSettings>
	<startup/>
</configuration>
