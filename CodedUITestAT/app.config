<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="CodedUITestAT.Settings.General" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
            <section name="CodedUITestAT.Settings.WaitingTime" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
            <section name="CodedUITestAT.Settings.ScanCompleted" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <CodedUITestAT.Settings.General>
            <setting name="ATApplicationProcessName" serializeAs="String">
                <value>APTAT.Application</value>
            </setting>
        </CodedUITestAT.Settings.General>
        <CodedUITestAT.Settings.WaitingTime>
            <setting name="QuickScanWaitTime" serializeAs="String">
                <value>180000</value>
            </setting>
        </CodedUITestAT.Settings.WaitingTime>
        <CodedUITestAT.Settings.ScanCompleted>
            <setting name="ScanCompletedText" serializeAs="String">
                <value>Scan Completed! Do you want to analyse files with Valkyrie?</value>
            </setting>
        </CodedUITestAT.Settings.ScanCompleted>
    </applicationSettings>
</configuration>