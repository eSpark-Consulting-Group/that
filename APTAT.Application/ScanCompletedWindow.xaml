<Window x:Class="APTAT.Application.ScanCompletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan Completed" Height="120" Width="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Text" Text="" Margin="10"/>
        <StackPanel HorizontalAlignment="Center" Grid.Row="1">
            <Button Content="OK"  Margin="5" Width="70" Click="Button_Click"></Button>
        </StackPanel>
    </Grid>
</Window>
