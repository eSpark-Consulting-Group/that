            <TextBlock  x:Name="txtSelectComputers" Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center"  Text="{Binding FileName}" FontSize="20" Margin="30,8,20,8" Grid.Column="1" MaxWidth="750" ToolTipService.ToolTip="{Binding FileName}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
