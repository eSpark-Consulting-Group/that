        <Grid Background="White" Grid.Row="1" Margin="65,0,0,0">
            <ScrollViewer  BorderThickness="0,0,0,0">
            <Grid x:Name="gridProperties" Margin="5, 0"  VerticalAlignment="Top" HorizontalAlignment="Left"  >
                <Grid.Resources>
                    <Style TargetType="TextBlock" >
                        <Setter Property="Margin" Value="7"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                    <Grid x:Name="GeneralCol1" Margin="20, 0,20,20 " MinWidth="250">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="File Name:"  Grid.Column="0" Grid.Row="0"/>
                    <TextBlock Text="Verdict:" Grid.Column="0" Grid.Row="1"/>
                    <TextBlock Text="Size:" Grid.Column="0" Grid.Row="2"/>
                    <TextBlock Text="Created:" Grid.Column="0" Grid.Row="3"/>
                    <TextBlock Text="Modified:" Grid.Column="0" Grid.Row="4"/>
                    <TextBlock Text="Accessed:" Grid.Column="0" Grid.Row="5"/>
                    <TextBlock Text="Whitelisted:" Grid.Column="0" Grid.Row="6"/>
                      
                    <TextBlock Text="{Binding FileName}" Grid.Column="1" Grid.Row="0" MaxWidth="220" ToolTipService.ToolTip="{Binding FileName}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding Verdict}" Grid.Column="1" Grid.Row="1" FontWeight="Bold" MaxWidth="220" ToolTipService.ToolTip="{Binding Verdict}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding Size}" Grid.Column="1" Grid.Row="2"/>
                    <TextBlock Text="{Binding Created}" Grid.Column="1" Grid.Row="3"/>
                    <TextBlock Text="{Binding Modified}" Grid.Column="1" Grid.Row="4"/>
                    <TextBlock Text="{Binding Accessed}" Grid.Column="1" Grid.Row="5"/>
                    <TextBlock Text="{Binding IsWhitelisted}" Grid.Column="1" Grid.Row="6" FontWeight="Bold"/>
                </Grid>
                    <Grid x:Name="GeneralCol2" Grid.Column="1" Margin="20, 0,20,20" MinWidth="250">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Hash (SHA1):" Grid.Column="0" Grid.Row="0"/>
                    <TextBlock Text="Signer:" Grid.Column="0" Grid.Row="1"/>
                    <TextBlock Text="Description:" Grid.Column="0" Grid.Row="2"/>
                    <TextBlock Text="Version:" Grid.Column="0" Grid.Row="3"/>
                    <TextBlock Text="Copyright:" Grid.Column="0" Grid.Row="4"/>
                    <TextBlock Text="Product:" Grid.Column="0" Grid.Row="5"/>
                    <TextBlock Text="Malware Probability:" Grid.Column="0" Grid.Row="6"/>

                    <TextBlock Text="{Binding Hash}" Grid.Column="1" Grid.Row="0" MaxWidth="220" ToolTipService.ToolTip="{Binding Hash}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding Signer}" Grid.Column="1" Grid.Row="1" MaxWidth="220" ToolTipService.ToolTip="{Binding Signer}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding Description}" Grid.Column="1" Grid.Row="2" MaxWidth="220" ToolTipService.ToolTip="{Binding Description}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding Version}" Grid.Column="1" Grid.Row="3" />
                    <TextBlock Text="{Binding Copyright}" Grid.Column="1" Grid.Row="4" MaxWidth="220" ToolTipService.ToolTip="{Binding Copyright}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding Product}" Grid.Column="1" Grid.Row="5" MaxWidth="220" ToolTipService.ToolTip="{Binding Product}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding MalwareProbability}" Grid.Column="1" Grid.Row="6" FontWeight="Bold"/>


                </Grid>
            </Grid>
            </ScrollViewer>
        </Grid>
        
        <StackPanel Orientation="Horizontal" Grid.Row="3" Height="50"  Margin="5,5,30,5" HorizontalAlignment="Right" >
            <Button Content="Close" Margin="5"  Click="OnBackClick" Style="{StaticResource ButtonHighlightStyle}"/>
        </StackPanel>
    </Grid>
</Models:BaseView>
