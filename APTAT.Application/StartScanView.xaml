<Models:BaseView x:Class="APTAT.Application.StartScanView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
                 xmlns:Models="clr-namespace:APTAT.Application.Models" mc:Ignorable="d" 
      d:DesignHeight="480" d:DesignWidth="640"
                 SnapsToDevicePixels="True"
	>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition  Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        
        <!--<telerik:RadToolBar Margin="0,0,0,0"  IsOverflowOpen="False" GripVisibility="Collapsed"   IsManipulationEnabled="False" OverflowButtonVisibility="Collapsed" Grid.Row="1" >
        </telerik:RadToolBar>-->


        <Grid  Grid.Row="1" Margin="30,0,0,0" x:Name="txtSpecifyADInfo">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Canvas x:Name="Layer_1" Height="38" Canvas.Left="0" Canvas.Top="0" Width="38" VerticalAlignment="Center"  HorizontalAlignment="Left" Margin="0,0,0,0">
                <Path Data="F1M0,38L38,38L38,0L0,0z" Fill="#2A81BA" Height="38" Canvas.Left="0" Stretch="Fill" Canvas.Top="0" Width="38"/>
                <Path Data="M22.0854,7.7764C20.5904,5.3764,13.1034,5.2904,13.4444,11.4894C13.4984,12.4704,13.5794,13.4544,13.7494,14.4374C13.2704,14.2884,13.1864,14.7104,13.1984,15.2724C13.2174,16.4514,13.5674,17.6344,14.7314,18.5414C14.7204,20.8904,15.9684,20.3674,15.9164,21.4634C15.2154,21.6594,14.7174,22.1924,14.3434,22.9344C12.3084,25.0064,11.4774,25.5904,9.2224,26.1214C7.4424,26.6254,6.6104,27.6554,6.7914,29.2484C6.8054,30.0794,6.8194,30.9104,6.8324,31.7414L31.1904,31.7414C31.2044,30.9844,31.2174,30.2294,31.2314,29.4734C31.2564,27.8294,30.3814,26.5934,28.3914,25.9384C26.0084,25.5834,25.0764,24.7324,23.4564,23.1794C23.1524,22.1754,22.6574,21.9954,21.8834,21.3404C21.8864,20.5144,22.9794,20.5924,22.9464,18.4594C24.1504,17.9724,24.4974,17.1984,24.6644,15.2934C24.7594,14.3734,24.5484,14.3124,24.1934,14.3734C24.8344,11.3904,24.6064,7.8694,22.0854,7.7764" Fill="White" Height="25.482" Canvas.Left="6.767" Stretch="Fill" Canvas.Top="6.26" Width="24.465"/>
            </Canvas>
            <TextBlock  Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center"   Text="Specify AD Information" FontSize="20"  Margin="30,8,20,8" Grid.Column="1"/>
        </Grid>

        <Grid  x:Name="txtSelectComputers" Grid.Row="1" Margin="30,0,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Canvas x:Name="Layer_3" Height="38" Canvas.Left="0" Canvas.Top="0" Width="38" VerticalAlignment="Center" Margin="0,0,0,0" HorizontalAlignment="Left">
                <Path Data="F1M0,38L38,38L38,0L0,0z" Fill="#2A81BA" Height="38" Canvas.Left="0" Stretch="Fill" Canvas.Top="0" Width="38"/>
                <Path Data="F1M29.541,10.041L8.459,10.041L8.459,23.055L29.541,23.055z M7.417,7.959L30.582,7.959L31.623,7.959L31.623,9L31.623,24.096L31.623,25.137L30.582,25.137L23.676,25.137L23.676,28.041L26.873,28.041L26.873,30.041L11.126,30.041L11.126,28.041L14.323,28.041L14.323,25.137L7.417,25.137L6.376,25.137L6.376,24.096L6.376,9L6.376,7.959z" Fill="White" Height="22.082" Canvas.Left="6.376" Stretch="Fill" Canvas.Top="7.959" Width="25.247"/>
            </Canvas>

            <TextBlock  Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center"  Text="Select Computers" FontSize="20" Margin="30,8,20,8" Grid.Column="1"/>
        </Grid>

        
        <Grid x:Name="panelSelectDomain" Grid.Row="2" Background="White" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
     
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock VerticalAlignment="Center" Grid.Row="0" FontSize="14" Margin="5" Text="Domain Controller:"/>
                <TextBlock VerticalAlignment="Center" Grid.Row="1"  FontSize="14" Margin="5" Text="Administrator:"/>
                <TextBlock VerticalAlignment="Center" Margin="5" FontSize="14" Grid.Row="2" Text="Password:"/>
                
                <TextBox x:Name="txtDomainController" BorderThickness="0" VerticalAlignment="Top" Margin="5" Grid.Row="0" Grid.Column="1" Text="{Binding DomainController, Mode=TwoWay, ValidatesOnExceptions=True}" >                 
                </TextBox>
                <TextBox x:Name="txtAdministrator" BorderThickness="0" Margin="5" Grid.Row="1" Grid.Column="1" Text="{Binding Administrator, Mode=TwoWay, ValidatesOnExceptions=True}" ></TextBox>
                <PasswordBox x:Name="password"  BorderThickness="0" Margin="5" Grid.Row="2" Grid.Column="1"  PasswordChanged="OnPasswordChanged" ></PasswordBox>
                
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2"  TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,100,0,0" FontSize="10" Foreground="#666" FontWeight="Bold"> 
                <Run>NOTE: In order to successfully deploy Agent(s) to endpoint(s) the following should be done at target computers:</Run>
                <LineBreak/>
                <Run>- make sure that Windows Firewall permits access to Admin Share;</Run>
                <LineBreak/>
                <Run>- set HKLM\SYSTEM\CurrentControlSet\Control\Lsa\forceguest DWORD to «0»;</Run>
                <LineBreak/>
                <Run>- set HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\LocalAccountTokenFilterPolicy DWORD to «1»."</Run>
                <LineBreak/>
                </TextBlock>


            </Grid>

          
        </Grid>
        <Grid x:Name="panelSelectComputers" Grid.Row="2" Background="White">
            <Grid.Resources>
                <DataTemplate x:Key="DomainTreeItemTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <!--<TextBlock Text="Root" Opacity="{Binding Type, Converter={StaticResource DirectoryItemTypeToOpacityConverter}, ConverterParameter='Root'}"/>
                        <TextBlock Text="OrgUnit" Opacity="{Binding Type, Converter={StaticResource DirectoryItemTypeToOpacityConverter}, ConverterParameter='OrgUnit'}"/>
                        <TextBlock Text="Computer" Opacity="{Binding Type, Converter={StaticResource DirectoryItemTypeToOpacityConverter}, ConverterParameter='Computer'}"/>-->
                        <TextBlock Text="{Binding Name}" Grid.Column="1"/>
                    </Grid>
                </DataTemplate>
            </Grid.Resources>
            
            <Border BorderBrush="LightGray" Margin="30,0,30,0" BorderThickness="0">
               
            <telerik:RadTreeView x:Name="domainTree" 
                                 SnapsToDevicePixels="True"
                                 IsOptionElementsEnabled="True"
                                 IsTriStateMode="True"
                                 Checked="OnChecked"
                                 FontSize="14"
                                 Unchecked="OnUnchecked"
                                 ItemPrepared="OnItemPrepared"
                                 ItemTemplate="{StaticResource DomainTreeItemTemplate}"
                                 LoadOnDemand="OnLoadOnDemand" 
                                 ItemsSource="{Binding Items}" 
                                 IsLoadOnDemandEnabled="True" />
            </Border>
  
        </Grid>

        <Border Grid.Row="0" BorderThickness="0"  BorderBrush="#FF6A0101" VerticalAlignment="Top" CornerRadius="0" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">    
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFA11D1D" Offset="0"/>
                    <GradientStop Color="#FF931919" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Foreground="White" Text="{Binding Error}" Margin="20,5"/>
        </Border>


        <Border  BorderBrush="#CCC" Grid.Row="3"  Height="60" BorderThickness="0,0,0,0" >
            <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right" Height="50" Margin="0,0,25,0">
                <Button x:Name="btnBack" Content="Back" Margin="5"  Click="OnBackClick" Style="{StaticResource ButtonNormalStyle}" />
                <Button x:Name="btnCancel" Content="Cancel" Click="OnCancelClick" Margin="5"  Style="{StaticResource ButtonNormalStyle}"/>
                <Button x:Name="btnNext"  IsDefault="True" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Content="Next" Margin="5" Click="OnNextClick"  Style="{StaticResource ButtonHighlightStyle}" />
                <Button x:Name="btnFinish" IsDefault="True"  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"  Content="Scan" Click="OnFinishClick" Margin="5"   Style="{StaticResource ButtonHighlightStyle}" />
            </StackPanel>
        </Border>
        
        <telerik:RadBusyIndicator Grid.Row="2" IsBusy="{Binding IsBusy}"  Background="Transparent"   BorderBrush="Transparent" />
    </Grid>
</Models:BaseView>
