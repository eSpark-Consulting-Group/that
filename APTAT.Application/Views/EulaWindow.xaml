<Window AutomationProperties.AutomationId="EulaWindow"
        x:Class="APTAT.Application.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="COMODO Unknown File Hunter"  WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Height="600" Width="800">
 
    <Grid AutomationProperties.AutomationId="EulaMainGrid" Background="White"
          Margin="15">


      <Grid.RowDefinitions>
        <RowDefinition Height="0"></RowDefinition>
        <RowDefinition Height="58"></RowDefinition>
        <RowDefinition Height="*"></RowDefinition>
        <RowDefinition Height="Auto"></RowDefinition>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
        <TextBlock FontWeight="Bold" FontSize="22" TextAlignment="Center">End user license agreement</TextBlock>
        <TextBlock FontSize="14">To continue you must accept the terms of this agreement. </TextBlock>
      </StackPanel>

      <ScrollViewer Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <telerik:RadPdfViewer x:Name="EulaRichTextBox" AutomationProperties.AutomationId="EulaRichTextBox" HorizontalAlignment="Left" Margin="-1 -1 0 -1" />            
      </ScrollViewer>

      <Grid AutomationProperties.AutomationId="EulaAcceptGrid"
            Grid.Row="3" Margin="0 15 0 0" >

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"></ColumnDefinition>
          <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <CheckBox AutomationProperties.AutomationId="IAcceptTermsOfThisAgreementCheckBox"
                  x:Name="AgreeCheckbox"  Grid.Column="0"
                  Content="I accept the terms of this agreement" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button AutomationProperties.AutomationId="ContinueButton"
                 IsEnabled="{Binding ElementName=AgreeCheckbox, Path=IsChecked}"  Content="Continue" Click="OnOkButtonClick" Height="23" Width="75" />
          <Button AutomationProperties.AutomationId="CancelButton" Margin="15,0,0,0"
                 Content="Cancel" Click="OnCancelButtonClick" Height="23" Width="75" />
        </StackPanel>
      </Grid>


    </Grid>

    
</Window>
