                               Opacity="{Binding Pending, Converter={StaticResource BoolToOpacityConverter}}" Width="20" Height="20" Data="M251,125.90482 L468,221.29267 251,320.32661 z M312,55.25 C182.79301,55.25 78,129.47838 78,221 78,312.52162 182.79301,386.75 312,386.75 441.207,386.75 546,312.52162 546,221 546,129.47838 441.207,55.25 312,55.25 z M312,0 C484.34097,0 624,98.952769 624,221 624,343.04723 484.34097,442 312,442 L0,442 0,193.375 C19.227005,84.394382 152.91906,0 312,0 z" Fill="{StaticResource AccentBrush}" Stretch="Fill" />


                      <TextBlock Margin="0,8,0,0" Text="{Binding FullName}" VerticalAlignment="Center" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}"/>
                      <TextBlock Margin="0,0,0,6" Text="{Binding InstancesCount}" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" />
                    </Grid>
                </DataTemplate>
           
                <DataTemplate x:Key="SizeColumn">
                    <TextBlock Text="{Binding FileSizeFormatted}" FontSize="13" FontFamily="Segoe UI Light" VerticalAlignment="Center" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileSizeFormatted, ValidatesOnDataErrors=False, ValidatesOnExceptions=False}" TextAlignment="Right" Margin="0 0 5 0"/>
                </DataTemplate>
                <DataTemplate x:Key="WhiteListedColumn">
                    <TextBlock Text="{Binding ValkyrieAnalysisResult.IsWhiteListed,  Converter={StaticResource BoolToYesNoConverter}}" FontSize="13" FontFamily="Segoe UI Light" VerticalAlignment="Center" Grid.Column="1"  TextAlignment="Center"/>
                </DataTemplate>
                <DataTemplate x:Key="VerdictColumn">
                    <TextBlock  Text="{Binding ValkyrieAnalysisResult.VerdictString}" FontSize="13" FontFamily="Segoe UI Light" VerticalAlignment="Center" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValkyrieAnalysisResult.SkipReason}"/>
                </DataTemplate>

                <TemplateSelectors:ValkyrieNameTemplateSelector x:Key="NameTemplateSelector" 
                                                                FileTemplate="{StaticResource FileInfoTemplate}"
                                                                ComputerTemplate="{StaticResource ComputerInfoTemplate}"/>
                <TemplateSelectors:ValkyrieNameTemplateSelector x:Key="SizeTemplateSelector"
                                                                FileTemplate="{StaticResource SizeColumn}"
                                                                ComputerTemplate="{x:Null}"/>
                <TemplateSelectors:ValkyrieNameTemplateSelector x:Key="WhiteListedTemplateSelector"
                                                                FileTemplate="{StaticResource WhiteListedColumn}"
                                                                ComputerTemplate="{x:Null}"/>
                <TemplateSelectors:ValkyrieNameTemplateSelector x:Key="VerdictTemplateSelector"
                                                                FileTemplate="{StaticResource VerdictColumn}"
                                                                ComputerTemplate="{x:Null}"/>
            </telerik:RadTreeListView.Resources>

            <telerik:RadTreeListView.ChildTableDefinitions>
                <telerik:TreeListViewTableDefinition ItemsSource="{Binding Computers}" />
            </telerik:RadTreeListView.ChildTableDefinitions>
            
            <telerik:RadTreeListView.Columns>
                
                <telerik:GridViewColumn                 
                    CellTemplateSelector="{StaticResource NameTemplateSelector}"
                    IsFilterable="False"
                    ShowFilterButton="False"                    
                    ShowFieldFilters="False"                    
                    Header="NAME"
                    TextAlignment="Left"
                    Width="590*" 
                 SortMemberPath="FullName"/>
               
                <telerik:GridViewColumn
                    CellTemplateSelector="{StaticResource SizeTemplateSelector}"
                    SortMemberPath="Size"
                    IsFilterable="False"
                    Header="SIZE"  
                    TextAlignment="Right"
                    Width="80*"/>

                <telerik:GridViewColumn
                    CellTemplateSelector="{StaticResource VerdictTemplateSelector}"
                    SortMemberPath="ValkyrieAnalysisResult.VerdictString"
                    IsFilterable="False"
                    Header="VERDICT"  
                    TextAlignment="Left"
                    Width="206*"/>

                <telerik:GridViewColumn
                    CellTemplateSelector="{StaticResource WhiteListedTemplateSelector}"
                    SortMemberPath="ValkyrieAnalysisResult.IsWhiteListed"
                    IsFilterable="False"
                    Header="TRUSTED VENDOR"  
                    TextAlignment="Center"
                    Width="110*"/>

            </telerik:RadTreeListView.Columns>
            
        </telerik:RadTreeListView>
        
    </Grid>
    
</UserControl>
