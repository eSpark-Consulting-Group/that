<UserControl    AutomationProperties.AutomationId="ValkyrieResultsScreen"
                x:Class="APTAT.Application.ValkyrieResultUserControl"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:Models="clr-namespace:APTAT.Application.Models"
                xmlns:TemplateSelectors="clr-namespace:APTAT.Application.TemplateSelectors"
                xmlns:Application="clr-namespace:APTAT.Application"
                xmlns:Controls="clr-namespace:APTAT.Application.Controls"
                xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" mc:Ignorable="d" 
                xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
                d:DesignHeight="400" d:DesignWidth="1000">
    
    <Grid>
        
        <telerik:RadTreeListView AutomationProperties.AutomationId="ValkyrieResultsTree"
                                 SelectedItem="{Binding SelectedValkyrieItem}" 
                                 CanUserFreezeColumns="False"                                
                                 x:Name="treeList2" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 ItemsSource="{Binding ItemsValkyrie}"
                                 RowStyle="{StaticResource rowStyleCompleted}"
                                 TabIndex="1"
                                 AutoExpandItems="False"
                                 RowHeight="50"
                                 HierarchyIndent="14"
                                
                                 EnableRowVirtualization="True"
                                 MouseDoubleClick="OnTreeDoubleClick" 
                                 Validation.ErrorTemplate="{x:Null}">
            
