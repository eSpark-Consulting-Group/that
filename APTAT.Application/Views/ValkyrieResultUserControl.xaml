                            Opacity="{Binding Clean, Converter={StaticResource BoolToOpacityConverter}}" Width="20" Height="20" Data="M9.5,5.0865002 L10.5,6.0865002 7.5,9.0865002 5.5,7.0865002 6.5,6.0865002 7.5,7.0865002 z M8,3 C5.7910004,3 4,4.7910004 4,7 4,9.2089996 5.7910004,11 8,11 10.209,11 12,9.2089996 12,7 12,4.7910004 10.209,3 8,3 z M8,0 C9.1049995,0 10,0.89599991 10,2 10,2.0780001 9.9860001,2.152 9.9770002,2.2280002 10.025,2.1669998 10.066,2.105 10.122999,2.0500002 10.902,1.2690001 12.17,1.2690001 12.951,2.0500002 13.732,2.8309999 13.732,4.0979996 12.951,4.8780003 12.896,4.934 12.834,4.9759998 12.775,5.0229998 12.85,5.0139999 12.924,5 13,5 14.105,5 15,5.8959999&#xd;&#xa;15,7 15,8.1040001 14.105,9 13,9 12.924,9 12.85,8.9860001 12.775,8.9770002 12.834,9.0240002 12.896,9.066 12.951,9.1210003 13.341999,9.5120001 13.537001,10.024 13.537001,10.537 L16,13 13,13 13,16 9.9779997,12.222 C9.8660002,13.221001 9.0290003,14 8,14 6.9729996,14 6.1350002,13.221001 6.0229998,12.222 L3,16 3,13 0,13 2.4650002,10.535 C2.4650002,10.023 2.6599998,9.5120001 3.0509996,9.1210003 3.1049995,9.066 3.1680002,9.0240002 3.2270002,8.9770002 3.1520004,8.9860001 3.0780001,9 3,9 1.8959999,9 1,8.1040001 1,7 1,5.8959999 1.8959999,5 3,5 3.0780001,5 3.1520004,5.0139999 3.2290001,5.0229998 3.1680002,4.9759998 3.1049995,4.934 3.0509996,4.8780003 2.2700005,4.0970001 2.2700005,2.8309999&#xd;&#xa;3.0509996,2.0500002 3.8319998,1.2690001 5.0979996,1.2690001 5.8789997,2.0500002 5.934,2.105 5.9770002,2.1669998 6.0229998,2.2270002 6.0159998,2.151 6,2.0780001 6,2 6,0.89599991 6.8959999,0 8,0 z" Fill="Green" Canvas.Left="0" Stretch="Fill" Canvas.Top="0"/>

