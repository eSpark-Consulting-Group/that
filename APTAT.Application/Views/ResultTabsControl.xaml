<UserControl AutomationProperties.AutomationId="ResultsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:APTAT.Application.Converters"
             xmlns:local="clr-namespace:APTAT.Application" x:Class="APTAT.Application.ResultTabsControl" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
      <Grid.Resources>

        <converters:ContentToPathConverter x:Key="content2PathConverter" />
        
        <Style TargetType="TabItem">
          <Setter Property="MinWidth" Value="100" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Grid>
                  <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="FocusStates">
                      <VisualState x:Name="Focused"/>
                      <VisualState x:Name="Unfocused"/> 
                    </VisualStateGroup>
                  </VisualStateManager.VisualStateGroups>
                  <Path x:Name="TabPath" Stroke="#FFE3E3E3" SnapsToDevicePixels="true" Margin="0 0 -23 0" Fill="White">
                    <Path.Data>
                      <PathGeometry>
                        <PathFigure IsClosed="False" StartPoint="0,0" Segments="{Binding ElementName=ContentSite, Converter={StaticResource content2PathConverter}}">
                        </PathFigure>
                      </PathGeometry>
                    </Path.Data>
                    <Path.LayoutTransform>
                      <ScaleTransform ScaleY="-1"/>
                    </Path.LayoutTransform>
                  </Path>
                  <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center"  Margin="15,5,0,2" ContentSource="Header"
                                          TextBlock.Foreground="#FF767676" TextBlock.FontSize="13"/>
                  <ContentPresenter x:Name="ContentSite2" Opacity="0" VerticalAlignment="Center"  Margin="10,5,0,2" ContentSource="Header"
                                          TextBlock.Foreground="#FF767676" TextBlock.FontSize="13" TextBlock.FontFamily="Segoe UI Semibold"/>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" TargetName="TabPath" Value="#FFD6D4D4" />
                  </Trigger>
                  <Trigger Property="Selector.IsSelected" Value="True">
                    <Setter Property="Fill" TargetName="TabPath" Value="#FFE3E3E3"/>
                    <Setter Property="Opacity" TargetName="ContentSite" Value="0"/>
                    <Setter Property="Opacity" TargetName="ContentSite2" Value="1"/>
                    <Setter Property="Panel.ZIndex" Value="2"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        
        <Style TargetType="ToggleButton">
          <Setter Property="MinWidth" Value="100" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ToggleButton">
                <Grid>
                  <Path x:Name="TabPath" Stroke="#FFE3E3E3" SnapsToDevicePixels="true" Margin="0 0 -23 0" Fill="White">
                    <Path.Data>
                      <PathGeometry>
                        <PathFigure IsClosed="False" StartPoint="0,0" Segments="{Binding ElementName=ContentSite, Converter={StaticResource content2PathConverter}}">
                        </PathFigure>
                      </PathGeometry>
                    </Path.Data>
                    <Path.LayoutTransform>
                      <ScaleTransform ScaleY="-1"/>
                    </Path.LayoutTransform>
                  </Path>
                  <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center"  Margin="15,5,0,2" ContentSource="Content"
                                          TextBlock.Foreground="#FF767676" TextBlock.FontSize="13"/>
                  <ContentPresenter x:Name="ContentSite2" Opacity="0" VerticalAlignment="Center"  Margin="10,5,0,2" ContentSource="Content"
                                          TextBlock.Foreground="#FF767676" TextBlock.FontSize="13" TextBlock.FontFamily="Segoe UI Semibold"/>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" TargetName="TabPath" Value="#FFD6D4D4" />
                  </Trigger>
                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter Property="Fill" TargetName="TabPath" Value="#FFE3E3E3"/>
                    <Setter Property="Opacity" TargetName="ContentSite" Value="0"/>
                    <Setter Property="Opacity" TargetName="ContentSite2" Value="1"/>
                    <Setter Property="Panel.ZIndex" Value="2"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Grid.Resources>
        
        <TabControl AutomationProperties.AutomationId="ResultsTabControl" BorderThickness="0" Padding="0 1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsTabStop="False">
            <TabItem AutomationProperties.AutomationId="UnknownFilesTab" Header="Scanning results" IsSelected="{Binding SelectScan, Mode=TwoWay}" IsTabStop="False">
              <Grid>
                <local:ScanResultUserControlByComputers HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding GroupByComputers, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <local:ScanResultUserControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding GroupByFiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
              </TabItem>
            <TabItem AutomationProperties.AutomationId="ValkyrieAnalysisResultsTab" Header="Valkyrie analysis results" IsSelected="{Binding SelectValkyrieScan, Mode=TwoWay}" IsEnabled="{Binding ValkyrieEnabled}" IsTabStop="False">
              <Grid>
                <local:ValkyrieResultUserControlByComputers HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding GroupByComputers, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <local:ValkyrieResultUserControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding GroupByFiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
            </TabItem>
        </TabControl>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 2 24 0" Visibility="{Binding GroupingEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
        <ToggleButton AutomationProperties.AutomationId="GroupByComputersToggleButton" 
                      Content="Group by Computers" IsChecked="{Binding GroupByComputers, Mode=TwoWay}" IsHitTestVisible="{Binding GroupByFiles}"/>
        <ToggleButton AutomationProperties.AutomationId="GroupByFilesToggleButton" 
                      Content="Group by Files" IsChecked="{Binding GroupByFiles, Mode=TwoWay}" IsHitTestVisible="{Binding GroupByComputers}"/>
      </StackPanel>
        
    </Grid>
</UserControl>
