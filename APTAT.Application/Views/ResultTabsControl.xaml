<UserControl AutomationProperties.AutomationId="ResultsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:APTAT.Application" x:Class="APTAT.Application.ResultTabsControl" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
      <Grid.Resources>
        <Style TargetType="{x:Type TabItem}">
          <Setter Property="MinWidth" Value="100" />
          <Setter Property="MinHeight" Value="30" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Foreground" Value="#FF767676"/>
          <Setter Property="FontFamily" Value="Segoe UI Semibold" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type TabItem}">
                  <Border  BorderThickness="1 1 1 0"  BorderBrush="#FFE3E3E3" SnapsToDevicePixels="true" Background="White">
                    <Border Name="Border" Opacity="0.4" Background="White">
                      <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" Margin="10, 5" />
                    </Border>
                  </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="TabItem.IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="#FFD6D4D4" />
                    <Setter TargetName="Border" Property="Opacity" Value="1" />
                  </Trigger>
                  <Trigger Property="TabItem.IsSelected" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="#FFE3E3E3" />
                    <Setter TargetName="Border" Property="Opacity" Value="1" />
                    <Setter Property="Panel.ZIndex" Value="100" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Grid.Resources>
        
        <TabControl AutomationProperties.AutomationId="ResultsTabControl" BorderThickness="0" Padding="2 2 0 2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

            <TabItem AutomationProperties.AutomationId="UnknownFilesTab" Header="Scanning results">
                <local:ScanInfoTreeView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </TabItem>
            
            <TabItem AutomationProperties.AutomationId="ValkyrieAnalysisResultsTab" Header="Valkyrie analysis results" IsSelected="True">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 -32 2 0" TabItem.PreviewMouseLeftButtonDown="OnMouseLeftButtonDown">
                  <TabItem Header="Group by Computers" IsSelected="{Binding GroupByComputers, Mode=TwoWay}" />

                  <TabItem Header="Group by Files" IsSelected="{Binding GroupByFiles, Mode=TwoWay}" />
                </StackPanel>

                <local:ValkyrieResultUserControlByComputers HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding GroupByComputers, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <local:ValkyrieResultUserControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding GroupByFiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </Grid>
              
            </TabItem>
            
        </TabControl>
        
    </Grid>
</UserControl>
