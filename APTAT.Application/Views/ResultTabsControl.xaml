<UserControl AutomationProperties.AutomationId="ResultsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:APTAT.Application" x:Class="APTAT.Application.ResultTabsControl" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        
        <TabControl AutomationProperties.AutomationId="ResultsTabControl"
            Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

            <TabItem AutomationProperties.AutomationId="UnknownFilesTab"
                     Header="Unknown files">
                <local:ScanInfoTreeView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </TabItem>
            
            <TabItem AutomationProperties.AutomationId="ValkyrieAnalysisResultsTab"
                     Name="FVSTab" Header="Valkyrie analysis results" IsSelected="True" >
                <local:ValkyrieResultUserControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </TabItem>
            
        </TabControl>
        
    </Grid>
</UserControl>
