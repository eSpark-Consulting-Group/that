                    <TextBlock Text="{Binding}" Grid.Column="1" FontFamily="Segoe UI Light" FontSize="18" Margin="0,0,5,0" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ReportButtonListBoxItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding}" Grid.Column="1" FontFamily="Segoe UI Light" FontSize="16" Margin="0,0,0,0" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Application:TitleUpdater Header="{Binding Header}"/>

        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy}" BusyContent="Resolving Computers..." x:Name="loading" Background="Transparent" BorderBrush="Transparent" IsTabStop="false">
            <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding ValkyrieSendingFiles}" BusyContent="Sending Files for Analysis..." Background="Transparent" BorderBrush="Transparent" IsTabStop="false">
                <Grid>

                    <ContentControl x:Name="mainContent" IsTabStop="false"/>

                    <StackPanel Orientation="Vertical" Visibility="{Binding IsItemsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" 
                   HorizontalAlignment="Center">

                        <TextBlock AutomationProperties.AutomationId="NoScansTextBlock" Text="There are no scans have been performed yet."
                   Opacity="{Binding IsScanInProgress, Converter={StaticResource InverseBoolToOpacityConverter}}"
                   FontSize="21"
                   FontFamily="Segoe UI Light"/>

                        <Button AutomationProperties.AutomationId="StartScanningNowButton"
                    Margin="0,10,0,0"  HorizontalAlignment="Center"
                    Opacity="{Binding IsScanInProgress, Converter={StaticResource InverseBoolToOpacityConverter}}"
                    Style="{StaticResource LinkButton}" 
                    Content="Start Scanning Now!" FontSize="21" FontFamily="Segoe UI Light"
                    Command="{Binding StartScanCommand}"/>

                    </StackPanel>

                </Grid>
            </telerik:RadBusyIndicator>
        </telerik:RadBusyIndicator>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <telerik:RadToolBar AutomationProperties.AutomationId="MainToolBar"
                                Margin="0,0,0,0" VerticalAlignment="Top"  IsOverflowOpen="False" GripVisibility="Collapsed" IsManipulationEnabled="False" OverflowButtonVisibility="Collapsed" BorderThickness="0" >

