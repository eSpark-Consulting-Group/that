              </telerik:RadButton>

                <telerik:RadButton AutomationProperties.AutomationId="StopScanningButton"
                                  Margin="0,-1,0,-1" 
                                  Padding="10,20"
                                  FontSize="16"
                                  Command="{Binding StopScanCommand}">
