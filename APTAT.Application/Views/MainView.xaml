                </telerik:RadButton>

                

                <telerik:RadDropDownButton AutomationProperties.AutomationId="ReportsDropDownButton"
                                           AutoOpenDelay="0:0:0.0"
                                           Content="Reports"
                                           IsEnabled="{Binding IsReportEnabled}"
                                           Style="{StaticResource RadDropDownButtonStyle2}"
                                           Margin="0,-1,15,-1"
                                           ContentTemplate="{StaticResource ReportButtonContentTemplate}"
                                           x:Name="ReportButton"
                                           FontSize="16"
                                           Padding="10,20,10,20">
                    <telerik:RadDropDownButton.DropDownContent>
                        <telerik:RadContextMenu IconColumnWidth="0" Width="160" BorderThickness="0">
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="Executive" Click="OnExecutiveReportClick"  Visibility="{Binding ShowFlsReportsMenu, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}"  Header="Per Device" Click="OnPerDeviceReportClick" Visibility="{Binding ShowFlsReportsMenu, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}"  Header="Per Program" Click="OnPerProgramReportClick" Visibility="{Binding ShowFlsReportsMenu, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="Executive Valkyrie" Click="OnExecutiveReportValkyrieClick"  Visibility="{Binding IsValkyrieReportEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}"  Header="Per Device Valkyrie" Click="OnPerDeviceReportValkyrieClick" Visibility="{Binding IsValkyrieReportEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}"  Header="Per Program Valkyrie" Click="OnPerProgramReportValkyrieClick" Visibility="{Binding IsValkyrieReportEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </telerik:RadContextMenu>
                    </telerik:RadDropDownButton.DropDownContent>
                </telerik:RadDropDownButton>

