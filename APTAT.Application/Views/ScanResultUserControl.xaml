<UserControl    AutomationProperties.AutomationId="ScanResultsScreen"
                x:Class="APTAT.Application.ScanResultUserControl"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:Models="clr-namespace:APTAT.Application.Models"
                xmlns:TemplateSelectors="clr-namespace:APTAT.Application.TemplateSelectors"
                xmlns:Application="clr-namespace:APTAT.Application"
                xmlns:Controls="clr-namespace:APTAT.Application.Controls"
                xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" mc:Ignorable="d" 
                xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid>
        <telerik:RadTreeListView AutomationProperties.AutomationId="UnknownFilesTree"
                                 SelectedItem="{Binding SelectedItem}" 
                                 CanUserFreezeColumns="False"                                
                                 x:Name="treeList" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" ItemsSource="{Binding Items}"   
                                 RowStyle="{StaticResource rowStyleCompleted}"
                                 TabIndex="1"
                                 AutoExpandItems="False"
                                 RowHeight="50"
                                 HierarchyIndent="14"
                                 Validation.ErrorTemplate="{x:Null}"
                                 EnableRowVirtualization="True"
                                 MouseDoubleClick="OnTreeDoubleClick" FocusVisualStyle="{x:Null}">

            <telerik:RadTreeListView.Resources>

              
                <DataTemplate x:Key="NameTemplate">
                  <Grid HorizontalAlignment="Stretch" Height="50" Margin="-5 0 0 0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Margin="18,8,0,0" Text="{Binding NameAndIpAddress}" Grid.Column="0" HorizontalAlignment="Left"/>
                    <TextBlock Margin="18,2,0,0" Text="{Binding ShortName}"  FontSize="13" FontFamily="Segoe UI Light" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShortName}" Grid.Row="1"/>

                  </Grid>
                </DataTemplate>
                <DataTemplate x:Key="UnknownFileTemplate">
                    <Grid Height="50" Margin="-5 -2 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                      </Grid.RowDefinitions>
                      
