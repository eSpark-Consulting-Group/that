                              Opacity="{Binding Failed, Converter={StaticResource BoolToOpacityConverter}}" Width="24" Height="24" Data="M14.829994,7.7570062 L12.000999,10.586001 9.1729965,7.757998 7.7589951,9.1719995 10.586998,12.000002 7.7589951,14.828005 9.1729965,16.242007 12.000999,13.414004 14.829994,16.242007 16.243996,14.828005 13.415001,12.000002 16.243996,9.1710076 z M12.000999,4.0000023 C16.418999,4.0000024 20.000999,7.580996 20.000999,12.000002 20.000999,16.418002 16.418999,20.000002 12.000999,20.000002 7.5820007,20.000002 4.0009995,16.418002 4.0009994,12.000002 4.0009995,7.580996 7.5820007,4.0000024 12.000999,4.0000023 z M11.999998,2 C6.477999,2 1.9999995,6.4780002 1.9999995,12 1.9999995,17.522 6.477999,22 11.999998,22 17.521997,22 21.999996,17.522 21.999996,12 21.999996,6.4780002 17.521997,2 11.999998,2 z M11.999998,0 C18.626997,0 23.999996,5.3720001 23.999996,12 23.999996,18.627 18.626997,24 11.999998,24 5.3729991,24 0,18.627 0,12 0,5.3720001 5.3729991,0 11.999998,0 z" Fill="#FFFCAF17" Stretch="Fill" />
                      
                      
                        <TextBlock Margin="0,8,0,0" Text="{Binding ShortName}" VerticalAlignment="Center" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShortName}"/>
                        <TextBlock Margin="0,0,0,6" Text="{Binding InstancesCount}" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" />
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="SizeColumn">
                    <TextBlock Text="{Binding SizeString}" FontSize="13" FontFamily="Segoe UI Light" VerticalAlignment="Center" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding SizeString}" TextAlignment="Right" Margin=" 0 0 5 0"/>
                </DataTemplate>
                <TemplateSelectors:MainViewNameTemplateSelector x:Key="NameTemplateSelector" 
                                                                UnknownFileTemplate="{StaticResource UnknownFileTemplate}"
                                                                ComputerTemplate="{StaticResource NameTemplate}"/>
            </telerik:RadTreeListView.Resources>
            <telerik:RadTreeListView.ChildTableDefinitions>
                <telerik:TreeListViewTableDefinition ItemsSource="{Binding Computers}" />
            </telerik:RadTreeListView.ChildTableDefinitions>
            <telerik:RadTreeListView.Columns>
                <telerik:GridViewColumn 
                    IsFilterable="True"
                    ShowFilterButton="False"
                    ShowFieldFilters="False"
                    CellTemplateSelector="{StaticResource NameTemplateSelector}"
                    Header="NAME"
                    
                    Width="700*" 
                 SortMemberPath="ShortName" />
                <telerik:GridViewColumn 
                    CellTemplate="{StaticResource SizeColumn}"
                    SortMemberPath="Size"
                    IsFilterable="False"
                    Header="SIZE"  
                    TextAlignment="Right"
                    Width="80*"/>
            </telerik:RadTreeListView.Columns>
        </telerik:RadTreeListView>
    </Grid>
</UserControl>
