            </Canvas>
        
            <TextBlock  Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center" Text="{Binding FileName}" FontSize="20" Margin="30,8,20,8" Grid.Column="1" MaxWidth="750" ToolTipService.ToolTip="{Binding FileName}" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
        </Grid>
        <Grid Background="White" Grid.Row="1" Margin="65,0,0,0">
            
            <Grid x:Name="gridProperties" Margin="5, 0"  VerticalAlignment="Top" HorizontalAlignment="Left"  >
                <Grid.Resources>
                    <Style TargetType="TextBlock" >
                        <Setter Property="Margin" Value="7"/>
                    </Style>

                  <Style x:Key="SelectTextStyle" TargetType="TextBox">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="Margin" Value="4 7 0 0"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate>
                          <ScrollViewer x:Name="PART_ContentHost" MaxWidth="{TemplateBinding MaxWidth}" BorderThickness="0" Padding="0"/>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                    <Grid x:Name="GeneralCol1" Margin="20, 0,20,20 " MinWidth="370">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="File Name:"  Grid.Column="0" Grid.Row="0"/>
                    <TextBlock Text="Verdict:" Grid.Column="0" Grid.Row="1"/>
                    <TextBlock Text="Size:" Grid.Column="0" Grid.Row="2"/>
                    <TextBlock Text="Created:" Grid.Column="0" Grid.Row="3"/>
                    <TextBlock Text="Modified:" Grid.Column="0" Grid.Row="4"/>
                    <TextBlock Text="Accessed:" Grid.Column="0" Grid.Row="5"/>
                    <TextBlock Text="Trusted Vendor:" Grid.Column="0" Grid.Row="6"/>
                      
                    <TextBox Text="{Binding FileName}" Grid.Column="1" Grid.Row="0" MaxWidth="220" ToolTipService.ToolTip="{Binding FileName}" HorizontalAlignment="Left" Style="{StaticResource SelectTextStyle}"/>
                    <TextBox Text="{Binding Verdict}" Grid.Column="1" Grid.Row="1" MaxWidth="220" ToolTipService.ToolTip="{Binding Verdict}" HorizontalAlignment="Left" Style="{StaticResource SelectTextStyle}"/>
                    <TextBlock Text="{Binding Size}" Grid.Column="1" Grid.Row="2"/>
                    <TextBlock Text="{Binding Created}" Grid.Column="1" Grid.Row="3"/>
                    <TextBlock Text="{Binding Modified}" Grid.Column="1" Grid.Row="4"/>
                    <TextBlock Text="{Binding Accessed}" Grid.Column="1" Grid.Row="5"/>
                    <TextBlock Text="{Binding IsWhitelisted}" Grid.Column="1" Grid.Row="6" />
                </Grid>
                    <Grid x:Name="GeneralCol2" Grid.Column="1" Margin="20, 0,20,20" MinWidth="250">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Hash (SHA1):" Grid.Column="0" Grid.Row="0"/>
                    <TextBlock Text="Signer:" Grid.Column="0" Grid.Row="1"/>
                    <TextBlock Text="Description:" Grid.Column="0" Grid.Row="2"/>
                    <TextBlock Text="Version:" Grid.Column="0" Grid.Row="3"/>
                    <TextBlock Text="Copyright:" Grid.Column="0" Grid.Row="4"/>
                    <TextBlock Text="Product:" Grid.Column="0" Grid.Row="5"/>
                    <TextBlock Text="Malware Probability:" Grid.Column="0" Grid.Row="6"/>

                    <TextBox Text="{Binding Hash}" Grid.Column="1" Grid.Row="0" MaxWidth="220" ToolTipService.ToolTip="{Binding Hash}" HorizontalAlignment="Left" Style="{StaticResource SelectTextStyle}"/>
                    <TextBox Text="{Binding Signer}" Grid.Column="1" Grid.Row="1" MaxWidth="220" ToolTipService.ToolTip="{Binding Signer}" HorizontalAlignment="Left" Style="{StaticResource SelectTextStyle}"/>
                    <TextBox Text="{Binding Description}" Grid.Column="1" Grid.Row="2" MaxWidth="220" ToolTipService.ToolTip="{Binding Description}" HorizontalAlignment="Left" Style="{StaticResource SelectTextStyle}"/>
                    <TextBlock Text="{Binding Version}" Grid.Column="1" Grid.Row="3" />
                    <TextBox Text="{Binding Copyright}" Grid.Column="1" Grid.Row="4" MaxWidth="220" ToolTipService.ToolTip="{Binding Copyright}" HorizontalAlignment="Left" Style="{StaticResource SelectTextStyle}"/>
                    <TextBox Text="{Binding Product}" Grid.Column="1" Grid.Row="5" MaxWidth="220" ToolTipService.ToolTip="{Binding Product}" HorizontalAlignment="Left" Style="{StaticResource SelectTextStyle}"/>
                    <TextBlock Text="{Binding MalwareProbability}" Grid.Column="1" Grid.Row="6" />


                </Grid>
            </Grid>
            
        </Grid>
        
        <StackPanel Orientation="Horizontal" Grid.Row="3" Height="50"  Margin="0,0,30,20" HorizontalAlignment="Right" >
            <Button Content="Close" Margin="5"  Click="OnBackClick" Style="{StaticResource ButtonHighlightStyle}"/>
        </StackPanel>
    </Grid>
</Models:BaseView>
