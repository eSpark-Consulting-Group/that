<Window AutomationProperties.AutomationId="ScanCompletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:APTAT.Application"
        xmlns:converters="clr-namespace:APTAT.Application.Converters"
        x:Class="APTAT.Application.ScanCompletedWindow"
        Title="SCAN COMPLETED"   Width="400"  WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" BorderThickness="3" WindowStyle="None"
            SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <converters:InverseBoolToTextConverter x:Key="InverseBoolToTextConverter"></converters:InverseBoolToTextConverter>
    </Window.Resources>

    <Border VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Color="Black" Opacity="0.8" ShadowDepth="0.5" />
        </Border.Effect>

        <Grid Background="White" MinHeight="163">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Background="#2A81BA" Height="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SCAN COMPLETED" FontSize="18" Foreground="White" Margin="10,5,5,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,15,10,10">
                    <Grid Margin="0 5 0 0">
                        <Canvas x:Name="SuccessfulScanIcon" HorizontalAlignment="Left" Height="40" VerticalAlignment="Top" Width="40" Opacity="{Binding IsProtected, Converter={StaticResource BoolToOpacityConverter}}">
                          <Path Data="M17.561001,7.7449989 L19,9.1839991 11.954002,16.230997 11.929003,16.255997 6.9540048,11.281999 8.3690042,9.8669987 11.904003,13.401998 z M12,1.9999999 C6.4779968,2 2,6.4779968 1.9999999,12 2,17.522003 6.4779968,22 12,22 17.522003,22 22,17.522003 22,12 22,6.4779968 17.522003,2 12,1.9999999 z M12,0 C18.626999,0 24,5.3730011 24,12 24,18.626999 18.626999,24 12,24 5.3730011,24 0,18.626999 0,12 0,5.3730011 5.3730011,0 12,0 z" Fill="#FF2C8841" Height="40" Stretch="Fill" Width="40"/>

                        </Canvas>

                        <Canvas x:Name="MalwaresFoundScanIcon" HorizontalAlignment="Left" Height="40" VerticalAlignment="Top" Width="40" Opacity="{Binding IsProtected, Converter={StaticResource InverseBoolToOpacityConverter}}">
                          <Path Data="M12.000004,15 C12.552004,15 13.000004,15.448 13.000004,16 13.000004,16.552 12.552004,17 12.000004,17 11.447003,17 11.000004,16.552 11.000004,16 11.000004,15.448 11.447003,15 12.000004,15 z M11.000002,7.0000019 L13.000002,7.0000019 13.000002,14.000002 11.000002,14.000002 z M12,1.9999999 C6.4779968,2 2,6.4779968 1.9999999,12 2,17.522003 6.4779968,22 12,22 17.522003,22 22,17.522003 22,12 22,6.4779968 17.522003,2 12,1.9999999 z M12,0 C18.628006,0 24,5.3730011 24,12 24,18.626999 18.628006,24 12,24 5.3730011,24 0,18.626999 0,12 0,5.3730011 5.3730011,0 12,0 z" Fill="#FFD84332" Height="40" Stretch="Fill" Width="40"/>

                        </Canvas>
                    </Grid>

                    <TextBlock AutomationProperties.AutomationId="ScanCompletedTextBlock" Visibility="{Binding IsUnknownFound, Converter={StaticResource InverseBoolToVisibilityConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="15,0,0,5" Grid.Row="0" FontSize="21"  Foreground="#555" Style="{StaticResource HeaderTextBlock}" Width="300">
                        <Run Text="Scan Completed!"/>
                    </TextBlock>
                
                    <TextBlock Visibility="{Binding IsUnknownFound, Converter={StaticResource BoolToVisibilityConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="15,0,0,5" Grid.Row="0" FontSize="21"  Foreground="#555" Style="{StaticResource HeaderTextBlock}" Width="300">
                        <Run Text="Scan Completed! Do you want to analyse Unknown programs with Valkyrie?" />
                    </TextBlock>
                </StackPanel>

                <TextBlock AutomationProperties.AutomationId="StatisticsTextBlock" x:Name="Text" HorizontalAlignment="Center" FontSize="14"  Margin="30, 10" Grid.Row="1" LineHeight="28" Foreground="#555"/>

                <StackPanel Grid.Row="2" 
					Height="Auto" HorizontalAlignment="Center" >


                    <local:BannerUserControl  x:Name="Banner"  Width="357" Height="92"/>
                </StackPanel>

                <StackPanel AutomationProperties.AutomationId="ToolBarPanel" HorizontalAlignment="Center" Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="OkButton" Content="OK"  Margin="5,5,5,15" Click="Button_Click"  Style="{StaticResource ButtonHighlightStyle}" 
                            Tag="{Binding IsUnknownFound, Mode=OneWay}"/>
                    <Button AutomationProperties.AutomationId="CancelButton" Content="Cancel"  Margin="5,5,5,15" Click="CancelButton_Click"  Style="{StaticResource ButtonHighlightStyle}" 
                            Visibility="{Binding IsUnknownFound, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
            

        </Grid>


    </Border>
</Window>
