<ContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Class="APTAT.Application.Loading"
    Width="40" Height="40" mc:Ignorable="d"
    HorizontalAlignment="Center" VerticalAlignment="Center">
  <ContentControl.Resources>

    <Storyboard x:Key="StartLoad">
      <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.Opacity)">
        <SplineDoubleKeyFrame KeyTime="00:00:00.3" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
      <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
        <DiscreteObjectKeyFrame KeyTime="00:00:00">
          <DiscreteObjectKeyFrame.Value>
            <Visibility>Visible</Visibility>
          </DiscreteObjectKeyFrame.Value>
        </DiscreteObjectKeyFrame>
      </ObjectAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="LoadCycle" RepeatBehavior="Forever">
      <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
        <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
        <SplineDoubleKeyFrame KeyTime="00:00:01" Value="-360"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="StopLoad">
      <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
        <SplineDoubleKeyFrame KeyTime="00:00:01" Value="360"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.Opacity)">
        <SplineDoubleKeyFrame KeyTime="00:00:00.3" Value="0"/>
      </DoubleAnimationUsingKeyFrames>
      <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
        <DiscreteObjectKeyFrame KeyTime="00:00:00.3">
          <DiscreteObjectKeyFrame.Value>
            <Visibility>Collapsed</Visibility>
          </DiscreteObjectKeyFrame.Value>
        </DiscreteObjectKeyFrame>
      </ObjectAnimationUsingKeyFrames>
    </Storyboard>
  </ContentControl.Resources>
  <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
        Opacity="0" Visibility="Collapsed">

    <Grid.RenderTransform>
      <TransformGroup>
        <ScaleTransform/>
        <SkewTransform/>
        <RotateTransform/>
        <TranslateTransform/>
      </TransformGroup>
    </Grid.RenderTransform>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="CommonGroup">
        <VisualStateGroup.Transitions>
          <VisualTransition GeneratedDuration="00:00:00.2000000" To="Normal"/>
          <VisualTransition From="Normal" GeneratedDuration="00:00:00.2000000"/>
        </VisualStateGroup.Transitions>
        <VisualState x:Name="Normal"/>
        <VisualState x:Name="Load">
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
              <SplineDoubleKeyFrame KeyTime="00:00:01" Value="360"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.Opacity)">
              <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
              <SplineDoubleKeyFrame KeyTime="00:00:01" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00">
                <DiscreteObjectKeyFrame.Value>
                  <Visibility>Visible</Visibility>
                </DiscreteObjectKeyFrame.Value>
              </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Path x:Name="path" Stretch="Fill" Data="M34.874996,25.097221 C34.874996,19.850515 30.621702,15.499998 25.374996,15.499998 C20.94809,15.499998 17.228405,18.527977 16.174084,22.625799 L16.162741,22.674946 L8.4066076,27 L0.97984368,22.738792 L1.0014911,22.495018 C2.2561362,10.140743 12.689711,0.50000012 25.375,0.5 C38.905975,0.50000012 49.875,11.566247 49.875,25.097223" RenderTransformOrigin="0.5,0" VerticalAlignment="Top">
      <Path.Fill>
        <LinearGradientBrush EndPoint="0.021,0.33" StartPoint="0.492,0.466">
          <GradientStop Color="#FF6CC4E9" Offset="1" />
          <GradientStop Color="#FF1CA2DB" Offset="0" />
        </LinearGradientBrush>
      </Path.Fill>
      <Path.RenderTransform>
        <TransformGroup>
          <ScaleTransform ScaleY="0.55"/>
          <SkewTransform/>
          <RotateTransform/>
          <TranslateTransform/>
        </TransformGroup>
      </Path.RenderTransform>
    </Path>
    <Path x:Name="path_Copy2" Stretch="Fill" Data="M63.465,31.875 C63.465,49.271969 49.359814,63.5 31.960188,63.5 C15.128065,63.5 1.3789834,50.301922 0.50001848,33.691353 C0.48458076,33.399612 10.140352,38.910713 10.140352,38.910713 C10.140352,38.910713 19.856718,33.679985 19.889849,33.892906 C20.799664,39.739784 25.857307,44.214287 31.960184,44.214287 C38.706978,44.214287 44.176334,38.620762 44.176334,31.874996" RenderTransformOrigin="0.49999999880609,1">
      <Path.Fill>
        <LinearGradientBrush EndPoint="0.021,0.33" StartPoint="0.492,0.466">
          <GradientStop Color="#FF1CA2DB"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Path.Fill>
      <Path.RenderTransform>
        <TransformGroup>
          <ScaleTransform ScaleY="0.5"/>
          <SkewTransform/>
          <RotateTransform/>
          <TranslateTransform/>
        </TransformGroup>
      </Path.RenderTransform>
    </Path>
  </Grid>
</ContentControl>
