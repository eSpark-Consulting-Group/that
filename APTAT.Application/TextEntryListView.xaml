<UserControl x:Class=" APTAT.Application.TextEntryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
          xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:converters="clr-namespace:APTAT.Application.Converters"
             xmlns:ComponentModel="clr-namespace:System.ComponentModel;assembly=System.Windows"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
   
        <Grid x:Name="LayoutRoot" Margin="0,0,10,0">
            <Grid.Resources>
                <converters:EmptyStringToBoolConverter x:Key="EmptyStringToBoolConverter"/>
                <converters:SelectedIndexToBoolConverter x:Key="SelectedIndexToBoolConverter"/>
                <CollectionViewSource x:Key="CollectionViewSource">
                
                </CollectionViewSource>

        </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Row="0" Margin="0 5" HorizontalAlignment="Stretch" x:Name="InputTextBox" BorderThickness="0">
           
            </TextBox>

            <Button x:Name="AddButton" Grid.Row="0" Grid.Column="1" Margin="10 5 0 5" Width="120" VerticalAlignment="Center"
                    Content="Add"
                    IsEnabled="{Binding Text, ElementName=InputTextBox, Converter={StaticResource EmptyStringToBoolConverter}}" />

            <!--<sdk:DataGrid x:Name="ItemsList" Grid.Row="1" Margin="0 5 0 5" BorderBrush="#CCCCCC" BorderThickness="1"
                          ItemsSource="{Binding Source={StaticResource CollectionViewSource}}"
                          HeadersVisibility="None" AutoGenerateColumns="False" IsReadOnly="True">
                <sdk:DataGrid.Columns>
                    <sdk:DataGridTemplateColumn Width="*"/>
                </sdk:DataGrid.Columns>
            </sdk:DataGrid>-->

        <telerik:RadListBox x:Name="ItemsList" Grid.Row="1" Margin="0 5 0 5" BorderBrush="#CCCCCC" BorderThickness="1" 
                                ItemsSource="{Binding Source={StaticResource CollectionViewSource}}"
                            >
            
        </telerik:RadListBox>

            <Button x:Name="RemoveButton" Grid.Row="1" Grid.Column="1" Margin="10 5 0 5" Width="120" VerticalAlignment="Top"
                    Content="Remove"
                    IsEnabled="{Binding SelectedIndex, ElementName=ItemsList, Converter={StaticResource SelectedIndexToBoolConverter}}" />


        <Canvas x:Name="ToolTipIcon" Visibility="Collapsed" ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-5"  Background="Transparent"  Margin="10, 35,5,5" Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Row="1"  Grid.Column="1"  >


            <Ellipse  Fill="White" HorizontalAlignment="Left" Height="24" Stroke="#2A81BA" VerticalAlignment="Top" Width="24" StrokeThickness="2"/>
            <Path Data="M0,5 L4,5 L4,14 L0,14 z M2,0 C3.10457,0 4,0.895431 4,2 C4,3.10457 3.10457,4 2,4 C0.895431,4 0,3.10457 0,2 C0,0.895431 0.895431,0 2,0 z" Fill="#2A81BA" HorizontalAlignment="Left" Height="14" Stretch="Fill" Stroke="#FF767676" StrokeThickness="0" UseLayoutRounding="False" VerticalAlignment="Top" Width="4" Canvas.Left="10" Canvas.Top="5" />



        </Canvas>
        
            <!--<HyperlinkButton x:Name="TipText" Grid.Row="2" Margin="15,15,10,10" IsHitTestVisible="False" IsTabStop="False"
                             Style="{StaticResource InfoLink}" VerticalContentAlignment="Top" />-->

        </Grid>
   
</UserControl>
