<Models:BasePage xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"  x:Class="APTAT.Application.MainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:Models="clr-namespace:APTAT.Application.Models"
                 xmlns:TemplateSelectors="clr-namespace:APTAT.Application.TemplateSelectors" mc:Ignorable="d" 
      d:DesignHeight="480" d:DesignWidth="640"
	Title="APT Assesment Tool">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
       
            
 
        <telerik:RadToolBar Margin="-1" VerticalAlignment="Top"  IsOverflowOpen="False" GripVisibility="Collapsed"   IsManipulationEnabled="False" OverflowButtonVisibility="Collapsed" >
            <telerik:RadToolBarSeparator  Margin="26,0,0,0"/>
            <telerik:RadButton Margin="3,3,3,3" Height="35" Content="Start Scanning"
                               IsEnabled="{Binding IsScanInProgress, Converter={StaticResource InverseBooleanConverter}}"
                               Click="OnStartScanningClick" />
            
            <telerik:RadButton Margin="3" Height="35" Content="Stop Scanning"
                               IsEnabled="{Binding IsScanInProgress}"/>
            <telerik:RadToolBarSeparator Margin="0"/>
            <telerik:RadButton Margin="3" Height="35" Content="Properites"
                               IsEnabled="{Binding IsDetailsEnabled}" 
                               Click="OnPropertiesClick" />
            <telerik:RadToolBarSeparator Margin="0"/>
            <telerik:RadButton Margin="3" Height="35" Content="Build Report"
                               IsEnabled="{Binding IsScanInProgress, Converter={StaticResource InverseBooleanConverter}}"/>
            <telerik:RadToolBarSeparator Margin="0"/>
            <telerik:RadButton Margin="3" Height="35" Content="About" IsEnabled="False" />
        </telerik:RadToolBar>

      
        <telerik:RadTreeListView SelectedItem="{Binding SelectedItem}" CanUserFreezeColumns="False"  Grid.Row="1" x:Name="treeList" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Items}"  
                                  >
            <telerik:RadTreeListView.Resources>
                <DataTemplate x:Key="NameTemplate">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,5,5,0" Text="{Binding Name}"/>
                        <TextBlock  Grid.Column="1" Margin="5" Text="(Offline)" Opacity="{Binding IsOnline, Converter={StaticResource InverseBoolToOpacityConverter}}"/>
                        
                        <TextBlock Margin="0,0,5,5"
                                   ToolTip="{Binding StatusMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="{Binding IsRootItem}"
                                   Opacity="{Binding IsRootItem, Converter={StaticResource BoolToOpacityConverter}}"
                                   Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding StatusMessage}" FontSize="12" 
                                   Foreground="{Binding ScanStage, Converter={StaticResource ScanStageToBrushConverter}}"/>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="UnknownFileTemplate">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                </DataTemplate>
                <TemplateSelectors:MainViewNameTemplateSelector x:Key="NameTemplateSelector" 
                                                                UnknownFileTemplate="{StaticResource UnknownFileTemplate}"
                                                                ComputerTemplate="{StaticResource NameTemplate}"/>
            </telerik:RadTreeListView.Resources>
            <telerik:RadTreeListView.ChildTableDefinitions>
                <telerik:TreeListViewTableDefinition ItemsSource="{Binding Items}" />
            </telerik:RadTreeListView.ChildTableDefinitions>
            <telerik:RadTreeListView.Columns>
                <telerik:GridViewColumn 
                    Header="Name"
                    Width="400" 
                    CellTemplateSelector="{StaticResource NameTemplateSelector}" SortMemberPath="Name" />
                <telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding Type}"
                    Header="Type"  
                    IsFilterable="False"
                    Width="*"/>
                <telerik:GridViewDataColumn 
                    SortMemberPath="Size"
                    DataMemberBinding="{Binding SizeString}"
                    IsFilterable="False"
                    Header="Size"  
                    Width="*"/>
            </telerik:RadTreeListView.Columns>
        </telerik:RadTreeListView>
        <TextBlock Text="No items to display. Press Start Scanning Button"
                   Opacity="{Binding IsScanInProgress, Converter={StaticResource InverseBoolToOpacityConverter}}"
                   Grid.Row="1"
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Visibility="{Binding IsItemsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <StackPanel Visibility="{Binding IsItemsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Orientation="Horizontal" Height="44" Grid.Row="2" 
                    Opacity="{Binding IsScanInProgress, Converter={StaticResource InverseBoolToOpacityConverter}}">
            <TextBlock Text="Computers Count:" VerticalAlignment="Center" Margin="30,5,5,5"/>
            <TextBlock Text="{Binding ItemsCount}" VerticalAlignment="Center" Margin="0,5"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsItemsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Orientation="Horizontal" Height="44" Grid.Row="2" Opacity="{Binding IsScanInProgress, Converter={StaticResource BoolToOpacityConverter}}">
            <TextBlock Text="Scanned:" VerticalAlignment="Center" Margin="30,5,5,5"/>
            <TextBlock Text="{Binding ScannedItemsCount}" VerticalAlignment="Center" Margin="0,5"/>
            <TextBlock Text=" of " VerticalAlignment="Center" Margin="0,5"/>
            <TextBlock Text="{Binding OnlineItemsCount}" VerticalAlignment="Center" Margin="0,5"/>
        </StackPanel>
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy}"  BusyContent="Resolving Computers..." Background="Transparent"    BorderBrush="Transparent"/>
    </Grid>
</Models:BasePage>
