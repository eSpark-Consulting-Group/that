<Models:BasePage xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"  x:Class="APTAT.Application.MainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:Models="clr-namespace:APTAT.Application.Models" mc:Ignorable="d" 
      d:DesignHeight="480" d:DesignWidth="640"
	Title="APT Assesment Tool">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
       
            
 
        <telerik:RadToolBar Margin="-1" VerticalAlignment="Top"  IsOverflowOpen="False" GripVisibility="Collapsed"   IsManipulationEnabled="False" OverflowButtonVisibility="Collapsed" >
            <telerik:RadToolBarSeparator  Margin="26,0,0,0"/>
            <telerik:RadButton Margin="3,3,3,3" Height="35" Content="Start Scanning"
                               IsEnabled="{Binding IsScanInProgress, Converter={StaticResource InverseBooleanConverter}}"
                               Click="OnStartScanningClick" />
            
            <telerik:RadButton Margin="3" Height="35" Content="Stop Scanning"
                               IsEnabled="{Binding IsScanInProgress}"/>
            <telerik:RadToolBarSeparator Margin="0"/>
            <telerik:RadButton Margin="3" Height="35" Content="Properites"
                               IsEnabled="{Binding IsScanInProgress, Converter={StaticResource InverseBooleanConverter}}" 
                               Click="OnPropertiesClick" />
            <telerik:RadToolBarSeparator Margin="0"/>
            <telerik:RadButton Margin="3" Height="35" Content="Build Report"
                               IsEnabled="{Binding IsScanInProgress, Converter={StaticResource InverseBooleanConverter}}"/>
            <telerik:RadToolBarSeparator Margin="0"/>
            <telerik:RadButton Margin="3" Height="35" Content="About" />
        </telerik:RadToolBar>

      
        <telerik:RadTreeListView CanUserFreezeColumns="False"  Grid.Row="1" x:Name="treeList" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Items}" >
            <telerik:RadTreeListView.Resources>
                <DataTemplate x:Key="NameTemplate">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock
                            Opacity="{Binding IsRootItem, Converter={StaticResource BoolToOpacityConverter}}"
                            Text="{Binding Progress, StringFormat='({0}%)'}" Grid.Column="1" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </telerik:RadTreeListView.Resources>
            <telerik:RadTreeListView.ChildTableDefinitions>
                <telerik:TreeListViewTableDefinition ItemsSource="{Binding Items}" />
            </telerik:RadTreeListView.ChildTableDefinitions>
            <telerik:RadTreeListView.Columns>
                <telerik:GridViewColumn 
                    Header="Name"
                    Width="318" 
                    CellTemplate="{StaticResource NameTemplate}" SortMemberPath="Name" />
                <telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding Type}"
                    Header="Type"  
                    
                    IsFilterable="False"
                    Width="*"/>
                <telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding Size}"
                    IsFilterable="False"
                    Header="Size"  
                    Width="*"/>
            </telerik:RadTreeListView.Columns>
        </telerik:RadTreeListView>
        <StackPanel Orientation="Horizontal" Height="44" Grid.Row="2">
            <TextBlock Text="Computers Count:" VerticalAlignment="Center" Margin="30,5,5,5"/>
            <TextBlock Text="{Binding ItemsCount}" VerticalAlignment="Center" Margin="0,5"/>
        </StackPanel>
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy}"  Background="Transparent"   BorderBrush="Transparent"/>
    </Grid>
</Models:BasePage>
