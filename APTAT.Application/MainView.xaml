                              Height="32" Stretch="Fill" 
                             
                             Width="32"/>
                        </Border>


                        <TextBlock Margin="8,8,0,0" Text="{Binding Name}" Grid.Column="1"/>
                        <TextBlock  Grid.Column="2" Margin="0,8,0,0" Text="(Offline)" Opacity="{Binding IsOnline, Converter={StaticResource InverseBoolToOpacityConverter}}"/>
                        <TextBlock Margin="8,0,0,8"
                                   ToolTip="{Binding StatusMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="{Binding IsRootItem}"
                                   Opacity="{Binding IsRootItem, Converter={StaticResource BoolToOpacityConverter}}"
                                   Grid.Column="1"
                                   Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding StatusMessage}" FontSize="12" 
                                   Foreground="{Binding ScanStage, Converter={StaticResource ScanStageToBrushConverter}}"/>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="UnknownFileTemplate">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                </DataTemplate>
                <TemplateSelectors:MainViewNameTemplateSelector x:Key="NameTemplateSelector" 
                                                                UnknownFileTemplate="{StaticResource UnknownFileTemplate}"
                                                                ComputerTemplate="{StaticResource NameTemplate}"/>
            </telerik:RadTreeListView.Resources>
            <telerik:RadTreeListView.ChildTableDefinitions>
                <telerik:TreeListViewTableDefinition ItemsSource="{Binding Items}" />
            </telerik:RadTreeListView.ChildTableDefinitions>
            <telerik:RadTreeListView.Columns>
                <telerik:GridViewColumn 
                    Header="NAME"
                    Width="900" 
                    CellTemplateSelector="{StaticResource NameTemplateSelector}" SortMemberPath="Name" />
                <!--<telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding Type}"
                    Header="Type"  
                    IsFilterable="False"
                    Width="*"/>-->
                <telerik:GridViewDataColumn 
                    SortMemberPath="Size"
                    DataMemberBinding="{Binding SizeString}"
                    IsFilterable="False"
                    Header="SIZE"  
                    Width="*"/>
            </telerik:RadTreeListView.Columns>
        </telerik:RadTreeListView>
        <TextBlock Text="No items to display. Press Start Scanning Button"
                   Opacity="{Binding IsScanInProgress, Converter={StaticResource InverseBoolToOpacityConverter}}"
                   Grid.Row="1"
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Visibility="{Binding IsItemsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <!--<StackPanel Visibility="{Binding IsItemsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Orientation="Horizontal" Height="44" Grid.Row="2" 
                    Opacity="{Binding IsScanInProgress, Converter={StaticResource InverseBoolToOpacityConverter}}">
            <TextBlock Text="{Binding UnknownFilesCount}" VerticalAlignment="Center" Margin="30,5,0,5"/>
            <TextBlock Text=" unknown files detected (" VerticalAlignment="Center" Margin="0,5"/>
            <TextBlock Text="{Binding ScannedItemsCount}" VerticalAlignment="Center" Margin="0,5"/>
            <TextBlock Text=" of " VerticalAlignment="Center" Margin="0,5"/>
            <TextBlock Text="{Binding OnlineItemsCount}" VerticalAlignment="Center" Margin="0,5"/>
            <TextBlock Text=" computers scanned)." VerticalAlignment="Center" Margin="0,5"/>
        </StackPanel>-->

        <!--Visibility="{Binding IsItemsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}"-->
        <!--Opacity="{Binding IsScanInProgress, Converter={StaticResource BoolToOpacityConverter}}"-->
        <telerik:RadToolBar Margin="0,0,0,0" VerticalAlignment="Top"  IsOverflowOpen="False" GripVisibility="Collapsed"   IsManipulationEnabled="False" OverflowButtonVisibility="Collapsed" >
            <!--<telerik:RadToolBarSeparator  Margin="26,0,0,0"/>-->

