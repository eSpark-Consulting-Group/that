            <telerik:RadButton Margin="10,-1,5,-1"  Content="start scanning"
                               FontSize="18"
                               Padding="10"
                               IsEnabled="{Binding IsScanInProgress, Converter={StaticResource InverseBooleanConverter}}"
                               Click="OnStartScanningClick" />

            <telerik:RadButton Margin="5,-1"  Content="stop scanning"
                               Padding="10"
                               FontSize="18"
                               Command="{Binding StopScanCommand}"
                               IsEnabled="{Binding IsScanInProgress, Converter={StaticResource NullableConverter}}"/>
            <!--<telerik:RadToolBarSeparator Margin="0"/>-->
            <telerik:RadButton Margin="5,-1" Content="properites"
                               FontSize="18"
                               Padding="10"
                               IsEnabled="{Binding IsDetailsEnabled}" 
                               Click="OnPropertiesClick" />
            <!--<telerik:RadToolBarSeparator Margin="0"/>-->
            <telerik:RadButton Margin="5,-1" Content="build report"
                               FontSize="18"
                               Padding="10"
                               IsEnabled="{Binding IsScanInProgress, Converter={StaticResource InverseBooleanConverter}}"
                               Click="OnBuildReportClick"/>
            <!--<telerik:RadToolBarSeparator Margin="0"/>-->
            <telerik:RadButton Margin="5,-1" 
                               Padding="10"
                               Content="about" IsEnabled="False" FontSize="18"/>
        </telerik:RadToolBar>
        <!--Background="#FFF38546"-->
        <Border Grid.Row="2"  Background="#666" Height="35">
        <StackPanel Visibility="{Binding IsItemsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Orientation="Horizontal" Height="35" >
            <TextBlock Foreground="White" Text="{Binding UnknownFilesCount}" VerticalAlignment="Center" Margin="30,5,0,5"/>
                <TextBlock Foreground="White" Text=" unknown files detected (" VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Foreground="White" Text="{Binding ScannedItemsCount}" VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Foreground="White" Text=" of " VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Foreground="White" Text="{Binding OnlineItemsCount}" VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock  Foreground="White" Text=" computers scanned)." VerticalAlignment="Center" Margin="0,5"/>
        </StackPanel>
        </Border>
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy}"  BusyContent="Resolving Computers..." Background="Transparent"    BorderBrush="Transparent"/>

        
    </Grid>
</Models:BasePage>
