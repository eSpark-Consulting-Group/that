                <telerik:RadDropDownButton AutoOpenDelay="0:0:0.0"
                           Content="Reports"
                                       IsEnabled="{Binding IsReportEnabled}"
                                      Style="{StaticResource RadDropDownButtonStyle2}"
                                       Margin="5,-1,30,-1"
                           ContentTemplate="{StaticResource ReportButtonContentTemplate}"            
                       
                           x:Name="ReportButton"
                           FontSize="18"
                           Padding="10,20,10,20">
                    <telerik:RadDropDownButton.DropDownContent>

                        <telerik:RadContextMenu IconColumnWidth="0" Width="154" BorderThickness="0">
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="Executive" Click="OnExecutiveReportClick" />
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}"  Header="Per Device" Click="OnPerDeviceReportClick" />
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}"  Header="Per Program" Click="OnPerProgramReportClick" />
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}" Header="Executive Valkyrie" Click="OnExecutiveReportValkyrieClick" IsEnabled="{Binding IsValkyrieReportEnabled}"/>
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}"  Header="Per Device Valkyrie" Click="OnPerDeviceReportValkyrieClick" IsEnabled="{Binding IsValkyrieReportEnabled}"/>
                            <telerik:RadMenuItem HeaderTemplate="{StaticResource ReportButtonListBoxItemTemplate}"  Header="Per Program Valkyrie" Click="OnPerProgramReportValkyrieClick" IsEnabled="{Binding IsValkyrieReportEnabled}"/>
                        </telerik:RadContextMenu>

                    </telerik:RadDropDownButton.DropDownContent>
                </telerik:RadDropDownButton>

