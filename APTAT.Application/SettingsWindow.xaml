<Window x:Class="APTAT.Application.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy Credentials" Height="260" Width="300" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>            
            <RowDefinition Height="36"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Margin="5">
            <TextBlock FontSize="16">Authentication Required</TextBlock>
            <TextBlock FontSize="20"></TextBlock>
            <TextBlock x:Name="MessageText" Width="280" TextWrapping="WrapWithOverflow" >...</TextBlock>
        </StackPanel>
        <Grid Margin="5" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0">User Name:</Label>
        <TextBox Grid.Row="0" Grid.Column="1" Height="23" x:Name="LoginTextBox"/>
        <Label Grid.Row="1" Grid.Column="0">Password:</Label>
        <PasswordBox Grid.Row="1" Grid.Column="1" Height="23" x:Name="PasswordBox" />
    </Grid>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="2" Orientation="Horizontal">
            <Button Width="80" Height="23" Content="OK" Margin="5" Click="Button_Click"></Button>
            <Button Width="80" Height="23" Content="Cancel" Margin="5" Click="Button_CancelClick"></Button>
        </StackPanel>
    </Grid>
</Window>
