<Window x:Class="APTAT.Application.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy Credentials" Height="200" Width="300" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="36"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0">Login</Label>
        <TextBox Grid.Row="0" Grid.Column="1" Height="23" x:Name="LoginTextBox"/>
        <Label Grid.Row="1" Grid.Column="0">Password</Label>
        <PasswordBox Grid.Row="1" Grid.Column="1" Height="23" x:Name="PasswordBox" />
    </Grid>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="1" Orientation="Horizontal">
            <Button Width="80" Height="23" Content="OK" Margin="5" Click="Button_Click"></Button>
            <Button Width="80" Height="23" Content="Cancel" Margin="5"></Button>
        </StackPanel>
    </Grid>
</Window>
