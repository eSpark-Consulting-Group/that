<Window x:Class="APTAT.Application.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="STOP SCAN"   Width="400"  WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" BorderThickness="3" WindowStyle="None"
            SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">



    <Border VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Color="Black" Opacity="0.8" ShadowDepth="0.5" />
        </Border.Effect>

        <Grid Background="White" MinHeight="163">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Background="#FF0090FF" Height="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="STOP SCAN" FontSize="18" Foreground="White" Margin="10,5,5,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Carefully!" Grid.Row="0" FontSize="20" Margin="20,10,10,10" Foreground="#555" Style="{StaticResource HeaderTextBlock}"/>
                <TextBlock x:Name="Text" HorizontalAlignment="Center" FontSize="14"  Margin="30, 10" Grid.Row="1" LineHeight="28" Foreground="#555"
                           TextWrapping="Wrap">
                    <Run>
                        This operation will cancel all active scans.
                    </Run>
                    <LineBreak>
                    </LineBreak>
                    <Run>
                         Are you sure you want to continue?
                    </Run>

                </TextBlock>
                <StackPanel HorizontalAlignment="Center" Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
                    <Button Content="Yes"  Margin="5,5,5,15" Click="YesClick"  Style="{StaticResource ButtonHighlightStyle}" ></Button>
                    <Button Content="No"  Margin="5,5,5,15" Click="NoClick"  Style="{StaticResource ButtonHighlightStyle}" ></Button>
                </StackPanel>
            </Grid>
            <!--<Border Height="60" Width="10" Background="{StaticResource AccentBrush}"
                   
                    VerticalAlignment="Top" Margin="0,20,0,0" HorizontalAlignment="Left" Grid.Row="2"/>-->
        </Grid>


    </Border>
</Window>
