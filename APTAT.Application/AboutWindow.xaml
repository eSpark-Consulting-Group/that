<Window x:Class="APTAT.Application.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          Title="Stop Scan"   Width="389" Height="280"  WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" BorderThickness="3" WindowStyle="None"
            SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">



    <Border VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Color="Black" Opacity="0.8" ShadowDepth="0.5" />
        </Border.Effect>

        <Grid Background="White" MinHeight="163">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Background="#2A81BA" Height="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="About" FontSize="18" Foreground="White" Margin="10,5,5,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Background="#FCFCFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
        
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2"
                            Margin="10"
                            Orientation="Horizontal">
                    
                    <Image Source="APT.ico" Height="100"
                           Margin="15,5,20,5"/>
                    <Image Source="Assets/comodo_cto_200_40.png" 
                           Margin="10,5,20,5"/>
                    
                </StackPanel>
                
                <TextBlock Text="Product Name:" 
                           Grid.Row="1" Grid.Column="0"
                           FontFamily="Segoe UI Light" Margin="15,0,10,5" Foreground="#555" FontSize="13"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{StaticResource APTApplicationTitle}" 
                           FontFamily="Segoe UI Light" Margin="0,0,10,5" Foreground="#555" FontSize="13"></TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Product Version:" FontFamily="Segoe UI Light" Margin="15,0,10,5" Foreground="#555" FontSize="13"></TextBlock>
                <TextBlock Name="txtProductVersion" Grid.Row="2" Grid.Column="1"
                           Text="1.0.0.0" FontFamily="Segoe UI Light" Margin="0,0,10,5" Foreground="#555" FontSize="13"></TextBlock>
                
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                           Text="© 2013 Comodo Security Solutions, Inc. All Rights Reserved." FontFamily="Segoe UI Light" 
                           Margin="15,0,10,0" Foreground="#555" FontSize="13"></TextBlock>
                
                <StackPanel Orientation="Horizontal" 
                            Grid.Row="4" Grid.ColumnSpan="2"
                            Margin="5,10,20,5" HorizontalAlignment="Right" >
                    <Button Content="Close" Margin="5"  Click="OnBackClick" Style="{StaticResource ButtonHighlightStyle}"/>
                </StackPanel>
            </Grid>

        </Grid>

    </Border>
</Window>
