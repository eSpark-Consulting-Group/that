<Window x:Class="APTAT.Application.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          Title="Stop Scan"   Width="530" Height="240"  WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" BorderThickness="3" WindowStyle="None"
            SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">



    <Border VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Color="Black" Opacity="0.8" ShadowDepth="0.5" />
        </Border.Effect>

        <Grid Background="White" MinHeight="163">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Background="#2A81BA" Height="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="About" FontSize="18" Foreground="White" Margin="10,5,5,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Background="#FCFCFC" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="80"/>
                    <RowDefinition Height="Auto" MinHeight="25"/>
                    <RowDefinition Height="Auto" MinHeight="25"/>
                    <RowDefinition Height="Auto" MinHeight="60"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="138*"/>
                    <ColumnDefinition Width="155*"/>
                    <ColumnDefinition Width="228*"/>
                </Grid.ColumnDefinitions>
        
                <StackPanel Grid.RowSpan="3" 
                            Margin="10"
                            Orientation="Horizontal">
                    <Image Source="APT.ico" Height="100"
                		Margin="15,16,20,-6"/>
                    

                </StackPanel>
                
                <Image Source="Assets/comodo_cto.png" Stretch="None" HorizontalAlignment="Left"
                    	Margin="15,0,0,16" SnapsToDevicePixels="True" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2"/>
                
                <TextBlock Text="Product Name:" 
                           Grid.Row="1" Grid.Column="1"
                           FontFamily="Segoe UI" Margin="15,0,10,5" Foreground="#515151" FontSize="13"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="{StaticResource APTApplicationTitle}" 
                           FontFamily="Segoe UI" Margin="0,0,10,5" Foreground="#515151" FontSize="13"></TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="Product Version:" FontFamily="Segoe UI" Margin="15,0,10,5" Foreground="#515151" FontSize="13"></TextBlock>
                <TextBlock Name="txtProductVersion" Grid.Row="2" Grid.Column="2"
                           Text="1.1.0.13899" FontFamily="Segoe UI" Margin="0,0,10,5" Foreground="#515151" FontSize="13"></TextBlock>
                
                
               
                    <Button Grid.Row="3" Grid.ColumnSpan="1" HorizontalAlignment="Right" Content="Close" Margin="0,0,15,5"  Click="OnBackClick" Style="{StaticResource ButtonHighlightStyle}" Grid.Column="2" Width="120"/>
                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Left"
                           Text="© 2015 Comodo Security Solutions, Inc. All Rights Reserved." FontFamily="Segoe UI" 
                           Margin="24,20,0,0" Foreground="#878787" FontSize="13" ></TextBlock>
                
            </Grid>

        </Grid>

    </Border>
</Window>
