<Window x:Class="APTAT.Application.MainWindow"
				xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
				Title="APT Assesment Tool" MinHeight="300" MinWidth="300"  Height="768" Width="1024" WindowStyle="None"
    AllowsTransparency="True" Background="Transparent" BorderThickness="3"
    ResizeMode="CanResizeWithGrip"
        
        >
    <!--<telerik:RadWindow >-->
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="CloseButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.7" Storyboard.TargetName="path" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Normal"/>
                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>
                            <Path 
                                x:Name="path"
                                Data="M12.020836,0 L14.142151,2.1212997 L9.1923943,7.0710211 L14.142109,12.0207 L12.02079,14.142 L7.0710754,9.1923208 L2.121357,14.141999 L4.196167E-05,12.020699 L4.9497604,7.0710225 L0,2.1213009 L2.121315,2.0669997E-06 L7.0710754,4.9497228 z" 
                                  Fill="White" HorizontalAlignment="Right" Height="14.142" 
                                  Stretch="Fill" Stroke="Black" StrokeThickness="0" UseLayoutRounding="False" 
                                  VerticalAlignment="Center" 
                                Margin="10,0,10,0"
                                  Width="14.142"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="MinimizeButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.7" Storyboard.TargetName="path" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Normal"/>
                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>
                            <Path 
                                  x:Name="path"
                                  Data="M0,0 L17,0 L17,6 L0,6 z" 
                                Margin="10,0,5,0"
                                  Fill="White" HorizontalAlignment="Right" Height="3.167" 
                                  Stretch="Fill" Stroke="Black" StrokeThickness="0" VerticalAlignment="Center" Width="17" UseLayoutRounding="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border>
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Color="Black" Opacity="0.8" ShadowDepth="0.5" />
        </Border.Effect>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Background="#FF0090FF" Height="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="APT Assesment Tool" FontSize="18" Foreground="White" Margin="10,5,5,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button Style="{StaticResource MinimizeButton}" Click="OnMinimize"/>
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        
        <Frame Source="/MainView.xaml"  Background="#CEE0F9" NavigationUIVisibility="Hidden"  Grid.Row="1">
        </Frame>
        <!--<Border Background="Transparent" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Stretch" 
                x:Name="TopResizer" Height="10" Margin="10,0,10,0"/>
        <Border Background="Transparent" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Stretch" 
                x:Name="BottomResizer" Height="10" Margin="10,0,10,0"/>-->
        </Grid>
    </Border>
    <!--</telerik:RadWindow>-->
</Window>
