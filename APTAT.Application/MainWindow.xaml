<Window x:Class="APTAT.Application.MainWindow"
				xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                Title="APT/Unknown Risk Assessment Tool" MinHeight="300" MinWidth="880"  Height="768" Width="1024" 
                WindowStyle="None"
                AllowsTransparency="True" Background="Transparent" BorderThickness="3"
                ResizeMode="CanResizeWithGrip" 
        >

    <Border>
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Color="Black" Opacity="0.8" ShadowDepth="0.5" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Background="#2A81BA" Height="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/comodo_white.png" Height="16" Margin="10,0,0,0"/>
                    <TextBlock x:Name="txtTitle" 
                               FontSize="18" Foreground="White" Margin="10,5,5,5" 
                               Grid.Column="1"
                               Text="{StaticResource APTApplicationTitle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="2">
                        <Button Style="{StaticResource MinimizeButton}" Click="OnMinimize"/>
                        <Button x:Name="ResizeButton" Style="{StaticResource MaximizeButton}" Click="OnResizeClick" VerticalAlignment="Top"/>
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" Height="35" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame" Source="/MainView.xaml"  Background="#CEE0F9" NavigationUIVisibility="Hidden"  Grid.Row="1" >
            </Frame>
        </Grid>
    </Border>
</Window>
