<Window x:Class="APTAT.Application.ValkyrieDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Application="clr-namespace:APTAT.Application"
        Title="DETAILS"
        MaxWidth="850" 
        MaxHeight="440"
        MinWidth="915" 
        MinHeight="440"
        WindowStyle="None"
                AllowsTransparency="True" Background="Transparent" BorderThickness="3"
                ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border>
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Color="Black" Opacity="0.8" ShadowDepth="0.5" />
        </Border.Effect>

        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Background="#2A81BA" Height="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Details" FontSize="18" Foreground="White" Margin="10,5,5,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Application:ValkyrieDetailsView BackClick="OnBackClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
