                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollContentPresenter Grid.Row="2" CanContentScroll="{TemplateBinding CanContentScroll}" />

                    <ScrollBar x:Name="PART_VerticalScrollBar"
                       IsTabStop="False" Style="{StaticResource ScrollBarStyle1}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                       Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Orientation="Vertical" 
					   ViewportSize="{TemplateBinding ViewportHeight}"
                       Maximum="{TemplateBinding ScrollableHeight}"  Minimum="0.0"
                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>

                    <ScrollBar x:Name="PART_HorizontalScrollBar" 
                       IsTabStop="False"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                       Grid.Column="0" Grid.Row="4" Orientation="Horizontal"
					   ViewportSize="{TemplateBinding ViewportWidth}"
                       Maximum="{TemplateBinding ScrollableWidth}"  Minimum="0.0"
                       Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>

                    <Border Background="{DynamicResource MainBrush}" Grid.Row="2" IsHitTestVisible="False" VerticalAlignment="Top" Height="2" Margin="0 0 0 0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" SnapsToDevicePixels="True"/>
                    <Border Background="{DynamicResource AccentBrush}" Grid.Row="2" IsHitTestVisible="False" VerticalAlignment="Top" Height="30" Margin="0 2 0 0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                        <UIElement.OpacityMask>
                            <LinearGradientBrush LinearGradientBrush.StartPoint="0,0" LinearGradientBrush.EndPoint="0,1">
                                <GradientStop GradientStop.Offset="0" GradientStop.Color="White" />
                                <GradientStop GradientStop.Offset="0.5" GradientStop.Color="Transparent" />
                            </LinearGradientBrush>
                        </UIElement.OpacityMask>
                    </Border>
                    <Border Background="{DynamicResource AccentBrush}" Grid.Row="2" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="30" Margin="0 0 0 0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                        <UIElement.OpacityMask>
                            <LinearGradientBrush LinearGradientBrush.StartPoint="0,0" LinearGradientBrush.EndPoint="0,1">
                                <GradientStop GradientStop.Offset="0.5" GradientStop.Color="Transparent" />
                                <GradientStop GradientStop.Offset="1" GradientStop.Color="White" />
                            </LinearGradientBrush>
                        </UIElement.OpacityMask>
                    </Border>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="RadTreeListViewTemplate" TargetType="controls:RadTreeListView">
