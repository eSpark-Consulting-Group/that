                    </Trigger>
                    <Trigger Trigger.Property="UIElement.IsMouseOver" Trigger.Value="True">
                        <Setter Setter.TargetName="MouseOverElement" Property="Fill" Value="{DynamicResource StrongBrush2}" />
                        <Setter Setter.TargetName="MouseOverElement2" Property="Fill" Value="{DynamicResource StrongBrush2}" />
                    </Trigger>
                    <Trigger Trigger.Property="ButtonBase.IsPressed" Trigger.Value="True">
                        <Setter Setter.TargetName="MouseOverElement" Property="Fill" Value="{DynamicResource TextBrush2}" />
                        <Setter Setter.TargetName="MouseOverElement2" Property="Fill" Value="{DynamicResource TextBrush2}" />
