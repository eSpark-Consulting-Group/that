                <GradientStop Color="#FF000000" Offset="0.4" />
                <GradientStop Color="#FF000000" Offset="0.6" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>

            <Style TargetType="{x:Type ProgressBar}">
                <Setter Property="Control.Background" Value="#FFFFFFFF" />
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Grid x:Name="Background" Height="36" Width="196">
                                <Border Border.Background="{DynamicResource MainBrush}"  SnapsToDevicePixels="True"/>
                                <Rectangle x:Name="PART_Track" Margin="2,2,0,2" SnapsToDevicePixels="True"/>
                                <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="2 2 3 2">
                                    <Grid Grid.Name="Foreground">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition ColumnDefinition.MaxWidth="15" />
                                            <ColumnDefinition ColumnDefinition.Width="0.1*" />
                                            <ColumnDefinition ColumnDefinition.MaxWidth="15" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="Indicator" Grid.ColumnSpan="3" Grid.RowSpan="2" Margin="2" Background="{DynamicResource StrongBrush}" SnapsToDevicePixels="True"/>
                                        <Border x:Name="Animation" Border.Background="{DynamicResource StrongBrush}" Grid.ColumnSpan="3" Grid.RowSpan="2" Margin="2" SnapsToDevicePixels="True">
                                            <UIElement.OpacityMask>
                                                <MultiBinding>
                                                    <MultiBinding.Converter>
                                                        <Microsoft_Windows_Themes:ProgressBarHighlightConverter />
                                                    </MultiBinding.Converter>
                                                    <Binding Binding.Source="{StaticResource ProgressBarIndicatorAnimatedFill}" />
                                                    <Binding Binding.Path="ActualWidth" Binding.ElementName="Background" />
                                                    <Binding Binding.Path="ActualHeight" Binding.ElementName="Background" />
                                                </MultiBinding>
                                            </UIElement.OpacityMask>
                                        </Border>
                                        <Border x:Name="LeftDark" SnapsToDevicePixels="True" Border.Background="Transparent" Grid.RowSpan="2" Grid.Column="0" Width="14" HorizontalAlignment="Left" Margin="1,1,0,1" />
                                        <Border x:Name="RightDark" SnapsToDevicePixels="True" Border.Background="Transparent" Grid.Column="2" Grid.RowSpan="2" Margin="0,1,1,1" />
                                        <Rectangle x:Name="LeftLight" SnapsToDevicePixels="True" Shape.Fill="Transparent" Grid.Column="0" Grid.Row="2" Margin="1,0,0,1" />
                                        <Rectangle x:Name="CenterLight" SnapsToDevicePixels="True" Shape.Fill="Transparent" Grid.Column="1" Grid.Row="2" Margin="0,0,0,1" />
                                        <Rectangle x:Name="RightLight" SnapsToDevicePixels="True" Shape.Fill="Transparent" Grid.Column="2" Grid.Row="2" Margin="0,0,1,1" />
                                        <Border x:Name="Highlight2" SnapsToDevicePixels="True" Grid.ColumnSpan="3" Grid.RowSpan="2" Border.Background="Transparent" Margin="1,1,1,1"  />
                                    </Grid>
                                </Decorator>
                                <Border Border.BorderBrush="{DynamicResource StrongBrush}" Border.BorderThickness="2" Margin="0,0,0,0" SnapsToDevicePixels="True"/>
                                <Border Background="{DynamicResource MainBrush}" Width="2" Margin="0,2,2,2" HorizontalAlignment="Right" VerticalAlignment="Stretch" SnapsToDevicePixels="True"/>
                                <Border Background="{DynamicResource MainBrush}" Width="2" Margin="2,2,0,2" HorizontalAlignment="Left" VerticalAlignment="Stretch" SnapsToDevicePixels="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Trigger.Property="ProgressBar.Orientation" Trigger.Value="Vertical">
                                    <Setter Setter.TargetName="Background" Property="FrameworkElement.LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform RotateTransform.Angle="-90" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Setter.TargetName="PART_Track" Property="FrameworkElement.LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform RotateTransform.Angle="90" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Setter.TargetName="PART_Indicator" Property="FrameworkElement.LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform RotateTransform.Angle="90" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Setter.TargetName="Foreground" Property="FrameworkElement.LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform RotateTransform.Angle="-90" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Trigger.Property="ProgressBar.IsIndeterminate" Trigger.Value="True">
                                    <Setter Setter.TargetName="LeftDark" Property="UIElement.Visibility" Value="Collapsed" />
                                    <Setter Setter.TargetName="RightDark" Property="UIElement.Visibility" Value="Collapsed" />
                                    <Setter Setter.TargetName="LeftLight" Property="UIElement.Visibility" Value="Collapsed" />
                                    <Setter Setter.TargetName="CenterLight" Property="UIElement.Visibility" Value="Collapsed" />
                                    <Setter Setter.TargetName="RightLight" Property="UIElement.Visibility" Value="Collapsed" />
                                    <Setter Setter.TargetName="Indicator" Property="UIElement.Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Trigger.Property="ProgressBar.IsIndeterminate" Trigger.Value="False">
                                    <Setter Setter.TargetName="Animation" Property="Border.Background" Value="{DynamicResource WhiteBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="GridViewScrollViewerTemplate" TargetType="grid:GridViewScrollViewer">
