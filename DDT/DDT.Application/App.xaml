                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Trigger.Property="UIElement.IsKeyboardFocused" Trigger.Value="True">
                        <Setter Setter.TargetName="MouseOverElement" Property="Fill" Value="{DynamicResource StrongBrush2}" />
