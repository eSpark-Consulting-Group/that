                                    <Setter Setter.TargetName="Root" Property="BorderBrush" Value="{DynamicResource StrongBrush2}" />
                                    <Setter Setter.TargetName="Root2" Property="BorderBrush" Value="{DynamicResource StrongBrush2}" />
