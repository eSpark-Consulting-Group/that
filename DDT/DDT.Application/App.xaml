                        <grid:GridViewScrollViewer x:Name="PART_ItemsScrollViewer" Background="Transparent" FocusVisualStyle="{x:Null}"
									   CanContentScroll="True" Template="{StaticResource GridViewScrollViewerTemplate}" Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="2">
                            <grid:GridViewScrollViewer.HeaderRow>
                                <grid:GridViewHeaderRow x:Name="PART_HeaderRow" IndentLevel="{TemplateBinding GroupCount}" />
