                                                <Button Style="{StaticResource CloseButton}" x:Name="close" Background="{DynamicResource TextBrush3}"  Margin="5" Width="12" Height="12"   ToolTip="Clear" />

                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Trigger.Property="UIElement.IsMouseOver" Trigger.Value="True">
                                                <TriggerBase.ExitActions>
                                                    <BeginStoryboard BeginStoryboard.Name="AnimaMouseLeave_BeginStoryboard" BeginStoryboard.Storyboard="{StaticResource AnimaMouseLeave}" />
                                                </TriggerBase.ExitActions>
                                                <TriggerBase.EnterActions>
                                                    <BeginStoryboard BeginStoryboard.Name="AnimaMouseEnter_BeginStoryboard" BeginStoryboard.Storyboard="{StaticResource AnimaMouseEnter}" />
                                                </TriggerBase.EnterActions>
                                            </Trigger>
                                            <Trigger Trigger.Property="IsPressed" Trigger.Value="True">
                                                <Setter Setter.TargetName="MouseOverElement" Property="Border.Background" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        
                        <Grid Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Grid.Row="1">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="translate1" Y="17" />
                            </Grid.RenderTransform>

                            <Grid x:Name="grid1">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="SeparateStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Down">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="translate1" Storyboard.TargetProperty="Y" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="114" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="button2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Down2">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="translate1" Storyboard.TargetProperty="Y" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="114" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="button2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Up">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="translate1" Storyboard.TargetProperty="Y" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="17" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="button2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Up2">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="translate1" Storyboard.TargetProperty="Y" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="17" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="button2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0" >
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <CheckBox Visibility="Collapsed" Content="Re-deploy the package even if previous deployment has been detected" IsChecked="{Binding Redeploy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="22 22 0 0" HorizontalAlignment="Left"  />
                                <CheckBox Visibility="Collapsed" Content="Run remotely as currently logged-in user" IsChecked="{Binding RunAsUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="22 17 0 0" Grid.Row="1" HorizontalAlignment="Left"  />

                                <Grid Margin="22 15 22 5" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ParametersCheckbox" Content="Specify parameters"  Margin="0 1 0 0" 
                                                  HorizontalAlignment="Left" Checked="ParametersCheckbox_Checked"
                                                  IsChecked="{Binding IsInstallationParametersSpecified, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <telerik:RadWatermarkTextBox x:Name="Parameters"  Grid.Column="1" Margin="0 0 0 -2" Text="{Binding InstallationParameters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Opacity="{Binding IsInstallationParametersSpecified, Converter={converters:BoolToOpacityConverter}}" >
                                        <telerik:RadWatermarkTextBox.WatermarkContent>
                                            <TextBlock Text="{Binding ParametersExample}" Foreground="{DynamicResource TextBrush2}" />
                                        </telerik:RadWatermarkTextBox.WatermarkContent>
                                    </telerik:RadWatermarkTextBox>

                                    <Grid Grid.Column="2" Margin="20 0 0 0" Visibility="{Binding IsInstallationParametersSpecified, Converter={converters:BoolToVisibilityConverter}}">
                                        <CheckBox x:Name="Parameters64Checkbox" Content="Override parameters for 64-bit application" IsChecked="{Binding IsInstallationParameters64Specified, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding SeparatePackages, Converter={converters:BoolToVisibilityConverter}}"   Margin="0 1 0 0" HorizontalAlignment="Left" Checked="Parameters64Checkbox_Checked"/>
                                    </Grid>

                                    <Grid Grid.Column="3" Visibility="{Binding SeparatePackages, Converter={converters:BoolToVisibilityConverter}}">
                                        <Grid Visibility="{Binding IsInstallationParametersSpecified, Converter={converters:BoolToVisibilityConverter}}">
                                            <telerik:RadWatermarkTextBox x:Name="Parameters64" Margin="0 0 0 -2"  Visibility="{Binding IsInstallationParameters64Specified, Converter={converters:BoolToVisibilityConverter}}" Text="{Binding InstallationParameters64, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  >
                                                <telerik:RadWatermarkTextBox.WatermarkContent>
                                                    <TextBlock Text="{Binding ParametersExample}" Foreground="{DynamicResource TextBrush2}" />
                                                </telerik:RadWatermarkTextBox.WatermarkContent>
                                            </telerik:RadWatermarkTextBox>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <CheckBox x:Name="SeparateCheckbox" Grid.Row="3" IsChecked="{Binding SeparatePackages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Use separate packages for 32-bit and 64-bit applications"  Margin="22 7 0 21" HorizontalAlignment="Left" Checked="SeparateCheckbox_Checked" Unchecked="SeparateCheckbox_Unchecked" />

                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Next" Grid.Row="1" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Command="{Binding ChangeScreenCommand}" CommandParameter="{x:Static enums:ChangeScreenTypes.DiscoveryTargets}"  />

            </Grid>
        </Border>


    </Grid>
</UserControl>