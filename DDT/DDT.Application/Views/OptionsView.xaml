<UserControl x:Class="DDT.Application.Views.OptionsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DDT.Application.Views"
      xmlns:enums="clr-namespace:DDT.Application.Messages"
      xmlns:converters="clr-namespace:DDT.Application.Converters"
      xmlns:helpers="clr-namespace:DDT.Application.Helpers"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:behaviors="clr-namespace:DDT.Application.Behaviors"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300" helpers:ThemeHelper.Theme="{Binding Theme}">

    <Grid>
        <TextBlock HorizontalAlignment="Left" Style="{DynamicResource SubTitleTextStyle}" Visibility="{Binding ButtonsAvailable, Converter={converters:BoolToVisibilityConverter}}" FontSize="16"  VerticalAlignment="Top" Margin="3,40,0,0">
                Deployment Options
        </TextBlock>
        <Border Margin="0,62,0,0" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0" x:Name="scroll">
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition RowDefinition.Height="Auto" />
                            <RowDefinition RowDefinition.Height="*"  />
                        </Grid.RowDefinitions>

                        <Grid Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0 0 0 0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>


                                <Grid Margin="22 22 0 22" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Deploying timeout" Style="{DynamicResource SubTitleTextStyle}" Margin="0 8 0 0" />

                                    <TextBox Grid.Column="1" MaxLength="3" Text="{Binding DeployTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:IntToStringConverter}}" >
                                        <i:Interaction.Behaviors>
                                            <behaviors:TextPatternBehavior AllowInt="True" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>

                                    <TextBlock Text="minutes" HorizontalAlignment="Left" Style="{DynamicResource SubTitleTextStyle}" Grid.Column="2" Margin="11 8 0 0" />
                                </Grid>

                                <CheckBox Visibility="Collapsed" Content="Deploy to" Margin="22 20 0 10" VerticalAlignment="Top" IsChecked="{Binding DeployTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Grid.Row="2"/>
                                <CheckBox Visibility="Collapsed" Content="Windows Servers" Margin="44 0 0 10" VerticalAlignment="Top" IsChecked="{Binding DeployToWindowsServers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Grid.Row="3"/>
                                <CheckBox Visibility="Collapsed" Content="Windows Workstations" Margin="44 0 0 10" VerticalAlignment="Top" IsChecked="{Binding DeployToWindowsWorkstations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Grid.Row="4"/>
                                <CheckBox Visibility="Collapsed" Content="X86 Operation Systems" Margin="44 0 0 10" VerticalAlignment="Top" IsChecked="{Binding DeployTox86, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Grid.Row="5"/>
                                <CheckBox Visibility="Collapsed" Content="X64 Operation Systems" Margin="44 0 0 22" VerticalAlignment="Top" IsChecked="{Binding DeployTox64, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Grid.Row="6"/>
                            </Grid>
                        </Grid>

                        <Grid Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Grid.Row="1" Margin="0 50  0 0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource SubTitleTextStyle}" Visibility="{Binding ButtonsAvailable, Converter={converters:BoolToVisibilityConverter}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="3 -22 0 0">
                                    <TextBlock.Text>
                                        UI Options
                                    </TextBlock.Text>
                                </TextBlock>
                                <CheckBox Content="Show Animations" Grid.Row="1" VerticalAlignment="Top" Margin="22 19 22 20" IsChecked="{Binding ShowAnimations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  />

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="22 22 22 0"  HorizontalAlignment="Left">
                                    <CheckBox Content="Dark Cyan Theme" Style="{StaticResource ThemeCheckBoxStyle}" Background="#FF000607" BorderBrush="#FF00AED3" IsChecked="{Binding DarkCyanTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   />
                                    <CheckBox Content="Light Cyan Theme" Style="{StaticResource ThemeCheckBoxStyle}" Background="White" BorderBrush="#FF00AED3" Margin="22 0" IsChecked="{Binding LightCyanTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   />
                                    <CheckBox Content="Light Blue Theme" Style="{StaticResource ThemeCheckBoxStyle}" Background="White" BorderBrush="#FF2981BB"  IsChecked="{Binding LightBlueTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   />
                                </StackPanel>

                            </Grid>
                        </Grid>

                    </Grid>
                </ScrollViewer>

                <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Back" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Template="{StaticResource BackButton}" Foreground="{DynamicResource TextBrush3}" Command="{Binding ChangeScreenPreviousCommand}"/>

            </Grid>
        </Border>

    </Grid>
</UserControl>