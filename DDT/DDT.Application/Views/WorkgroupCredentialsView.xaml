<UserControl x:Class="DDT.Application.Views.WorkgroupCredentialsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DDT.Application.Views"
      xmlns:enums="clr-namespace:DDT.Application.Messages"
      xmlns:converters="clr-namespace:DDT.Application.Converters"
      xmlns:behaviors="clr-namespace:DDT.Application.Behaviors"
      xmlns:helpers="clr-namespace:DDT.Application.Helpers"
      xmlns:triggers="clr-namespace:DDT.Application.Triggers"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300" helpers:ThemeHelper.Theme="{Binding Theme}">

    <Grid>
        <TextBlock HorizontalAlignment="Left" Style="{DynamicResource SubTitleTextStyle}" Visibility="{Binding ButtonsAvailable, Converter={converters:BoolToVisibilityConverter}}" FontSize="16"  VerticalAlignment="Top" Margin="3,40,0,0">
                Workgroup Credentials
        </TextBlock>
        <Border Margin="0,62,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid VerticalAlignment="Top" Background="{DynamicResource AccentBrush}">
                    <Grid Margin="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <RadioButton HorizontalAlignment="Left" Grid.Row="0" Margin="-232 -2 0 0" Grid.Column="2" Content="Search Available Workgroups (may take a time)" IsChecked="{Binding EnumerateWorkgroups, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <RadioButton HorizontalAlignment="Right" Grid.Row="1" Margin="0 17 0 6" Content="Use Known Workgroup Name" IsChecked="{Binding EnumerateWorkgroups, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:BoolInvertConverter}}" Checked="RadioButton_Checked"/>

                        <telerik:RadWatermarkTextBox Grid.Column="2" Grid.Row="1" x:Name="text" VerticalAlignment="Bottom" IsEnabled="{Binding EnumerateWorkgroups, Converter={converters:BoolInvertConverter}, ConverterParameter=!}" Text="{Binding WorkgroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <telerik:RadWatermarkTextBox.WatermarkContent>
                                <TextBlock Text="{Binding WorkgroupMask}" Foreground="{DynamicResource TextBrush2}" />
                            </telerik:RadWatermarkTextBox.WatermarkContent>
                            <i:Interaction.Triggers>
                                <i:EventTrigger>
                                    <triggers:KeyToCommandAction Command="{Binding DiscoverWorkgroupCommand}" Key="Enter"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </telerik:RadWatermarkTextBox>

                    </Grid>

                </Grid>

                <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Next" Grid.Row="1" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Command="{Binding DiscoverWorkgroupCommand}" />
                <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Back" Grid.Row="1" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Template="{StaticResource BackButton}" Foreground="{DynamicResource TextBrush3}" Command="{Binding ChangeScreenPreviousCommand}" CommandParameter="{x:Static enums:ChangeScreenTypes.DiscoveryTargets}" />

            </Grid>
        </Border>

    </Grid>
</UserControl>