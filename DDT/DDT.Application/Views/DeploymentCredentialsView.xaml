<UserControl x:Class="DDT.Application.Views.DeploymentCredentialsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DDT.Application.Views"
      xmlns:enums="clr-namespace:DDT.Application.Messages"
      xmlns:behaviors="clr-namespace:DDT.Application.Behaviors"
      xmlns:converters="clr-namespace:DDT.Application.Converters"
      xmlns:helpers="clr-namespace:DDT.Application.Helpers"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300" helpers:ThemeHelper.Theme="{Binding Theme}">

    <Grid>
        <TextBlock HorizontalAlignment="Left" Style="{DynamicResource SubTitleTextStyle}" Visibility="{Binding ButtonsAvailable, Converter={converters:BoolToVisibilityConverter}}" FontSize="16" VerticalAlignment="Top" Margin="3,40,0,0">
                Deployment Credentials
        </TextBlock>
        <Border Margin="0,62,0,0" >
            <Grid VerticalAlignment="Top" Background="{DynamicResource AccentBrush}">
                <Grid Margin="22">
                    <local:LoginPasswordUserControl Grid.ColumnSpan="3" Login="{Binding Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UseCurrentDomain="{Binding UseCurrentDomainForDeploy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Command="{Binding DeployCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Start Deployment" Grid.Row="2" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Command="{Binding DeployCommand}" />
        <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Add More Targets" Grid.Row="2" Margin="0 17 197 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Template="{StaticResource BackButton}" Foreground="{DynamicResource TextBrush3}" Command="{Binding ChangeScreenCommand}" CommandParameter="{x:Static enums:ChangeScreenTypes.DiscoveryTargets}" />
        <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Back" Grid.Row="2" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Template="{StaticResource BackButton}" Foreground="{DynamicResource TextBrush3}" Command="{Binding ChangeScreenPreviousCommand}" />

    </Grid>

</UserControl>