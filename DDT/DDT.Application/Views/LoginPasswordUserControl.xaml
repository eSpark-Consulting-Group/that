<UserControl x:Class="DDT.Application.Views.LoginPasswordUserControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DDT.Application.Views"
      xmlns:behaviors="clr-namespace:DDT.Application.Behaviors"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:helpers="clr-namespace:DDT.Application.Helpers"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"  
      xmlns:converters="clr-namespace:DDT.Application.Converters"
      xmlns:triggers="clr-namespace:DDT.Application.Triggers"
      mc:Ignorable="d" x:Name="this"
      d:DesignHeight="300" d:DesignWidth="300" helpers:ThemeHelper.Theme="{Binding Theme}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="Domain Name" Grid.Row="2" Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolToSemiOpacityConverter}, ConverterParameter=!}" Style="{DynamicResource SubTitleTextStyle}" Visibility="{Binding ElementName=this, Path=ShowDomainController, Converter={converters:BoolToVisibilityConverter}}" Margin="0 8 0 0" HorizontalAlignment="Right" />
        <telerik:RadWatermarkTextBox Grid.Column="2" Grid.Row="2" x:Name="text" Margin="0 0 0 17" Visibility="{Binding ElementName=this, Path=ShowDomainController, Converter={converters:BoolToVisibilityConverter}}" IsEnabled="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" Text="{Binding DomainController, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <telerik:RadWatermarkTextBox.WatermarkContent>
                <TextBlock Text="{Binding DomainControllerMask}" Foreground="{DynamicResource TextBrush2}" />
            </telerik:RadWatermarkTextBox.WatermarkContent>
        </telerik:RadWatermarkTextBox>

        <TextBlock Text="Login" Grid.Row="3" Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolToSemiOpacityConverter}, ConverterParameter=!}" Style="{DynamicResource SubTitleTextStyle}" HorizontalAlignment="Right" Margin="0 8 0 0" />
        <telerik:RadWatermarkTextBox Grid.Column="2" Grid.Row="3" x:Name="text2" Margin="0 0 0 0" IsEnabled="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" Text="{Binding ElementName=this, Path=Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <telerik:RadWatermarkTextBox.WatermarkContent>
                <TextBlock Text="{Binding LoginMask}" Foreground="{DynamicResource TextBrush2}" />
            </telerik:RadWatermarkTextBox.WatermarkContent>
        </telerik:RadWatermarkTextBox>

        <TextBlock Text="Password" Grid.Row="4" Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolToSemiOpacityConverter}, ConverterParameter=!}" Style="{DynamicResource SubTitleTextStyle}" HorizontalAlignment="Right" Margin="0 25 0 0" />
        <telerik:RadWatermarkTextBox Grid.Column="2" Grid.Row="4" Margin="0 17 0 0" Padding="10 8 38 0" IsEnabled="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" IsTabStop="{Binding ElementName=PasswordMasked, Path=IsTabStop, Converter={converters:BoolInvertConverter}}" Text="{Binding ElementName=this, Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="PasswordUnmasked" >
            <telerik:RadWatermarkTextBox.WatermarkContent>
                <TextBlock Text="{Binding PasswordMask}" Foreground="{DynamicResource TextBrush2}" />
            </telerik:RadWatermarkTextBox.WatermarkContent>
            <i:Interaction.Triggers>
                <i:EventTrigger>
                    <triggers:KeyToCommandAction Command="{Binding ElementName=this, Path=Command}" Key="Enter"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </telerik:RadWatermarkTextBox>
        <PasswordBox Grid.Column="2" Grid.Row="4"  Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" Margin="0 17 0 0" Padding="10 8 38 0" x:Name="PasswordMasked" PasswordChanged="PasswordChanged" Visibility="Collapsed" IsTabStop="False">
            <i:Interaction.Triggers>
                <i:EventTrigger>
                    <triggers:KeyToCommandAction Command="{Binding ElementName=this, Path=Command}" Key="Enter"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </PasswordBox>

        <Button Grid.Column="2" Grid.Row="4" Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" IsHitTestVisible="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" Margin="0 15 0 0" MinWidth="34" HorizontalAlignment="Right" Click="SwitchMask" Template="{StaticResource PasswordButton}" Tag="False" x:Name="OpenedEye" ToolTip="Show" IsTabStop="False"/>
        <Button Grid.Column="2" Grid.Row="4" Opacity="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" IsHitTestVisible="{Binding ElementName=this, Path=UseCurrentDomain, Converter={converters:BoolInvertConverter}}" Margin="0 14 0 0" MinWidth="34" HorizontalAlignment="Right" Click="SwitchMask" Template="{StaticResource PasswordButton}" Tag="True" Visibility="Collapsed" x:Name="ClosedEye" ToolTip="Hide" IsTabStop="False"/>

        <RadioButton HorizontalAlignment="Left" Grid.Row="0" Margin="-196 -2 0 0" Grid.Column="2" Visibility="{Binding HasCurrentDomainName, Converter={converters:BoolToVisibilityConverter}}" Content="{Binding CurrentDomainName}" IsChecked="{Binding ElementName=this, Path=UseCurrentDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <RadioButton HorizontalAlignment="Right" Grid.Row="1" Margin="0 17 0 19"  Visibility="{Binding HasCurrentDomainName, Converter={converters:BoolToVisibilityConverter}}" Content="Use Custom Credentials" IsChecked="{Binding ElementName=this, Path=UseCurrentDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:BoolInvertConverter}}" Checked="RadioButton_Checked"/>
    </Grid>

</UserControl>