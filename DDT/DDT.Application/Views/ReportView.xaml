<UserControl x:Class="DDT.Application.Views.ReportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DDT.Application.Views"
      xmlns:enums="clr-namespace:DDT.Application.Messages"
      xmlns:converters="clr-namespace:DDT.Application.Converters"
      xmlns:helpers="clr-namespace:DDT.Application.Helpers"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300" helpers:ThemeHelper.Theme="{Binding Theme}">

    <Grid Visibility="{Binding HasInternalProgress, Converter={converters:BoolToVisibilityConverter}, ConverterParameter=!}">
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Visibility="{Binding ButtonsAvailable, Converter={converters:BoolToVisibilityConverter}}" Style="{DynamicResource SubTitleTextStyle}" FontSize="16"  VerticalAlignment="Top" Margin="3,40,0,0">
                Report Preview
        </TextBlock>
        <Border Margin="0,62,0,0" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource AccentBrush}" >
                    <telerik:RadPdfViewer x:Name="pdf" Mode="TextSelection" BorderThickness="0" DocumentChanged="pdf_DocumentChanged" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" >
                    <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Save" Margin="0 0 17 0"  Template="{StaticResource BackButton}" Foreground="{DynamicResource TextBrush3}" Click="Button_Click_1" />
                    <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Print" Click="Button_Click" />
                </StackPanel>
                <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Back" Grid.Row="1" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Template="{StaticResource BackButton}" Foreground="{DynamicResource TextBrush3}" Command="{Binding ChangeScreenPreviousCommand}" CommandParameter="{x:Static enums:ChangeScreenTypes.DeploymentResults}" />

            </Grid>
        </Border>
        <local:SearchUserControl PdfTarget="{Binding ElementName=pdf}" Visibility="{Binding ButtonsAvailable, Converter={converters:BoolToVisibilityConverter}}" VerticalAlignment="Top" HorizontalAlignment="Right" />
    </Grid>
</UserControl>
