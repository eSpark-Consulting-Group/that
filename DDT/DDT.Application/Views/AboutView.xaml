                        <TextBlock SnapsToDevicePixels="True" Margin="140,-4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="22" Foreground="{DynamicResource StrongBrush}" FontFamily="{StaticResource myriadpro}"  Text="Discovery and Deployment Tool">
                        </TextBlock>

                        <TextBlock x:Name="version" Margin="376 18 0 0" Foreground="{DynamicResource TextBrush}" FontSize="13" FontFamily="{StaticResource myriadpro}" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap">
                        </TextBlock>

                        <TextBlock Margin="0 -3 0 0" MaxWidth="380" Foreground="{DynamicResource TextBrush}" FontSize="13" FontFamily="{StaticResource myriadpro}" HorizontalAlignment="Right" VerticalAlignment="Top" TextWrapping="Wrap">
                            <Run Text="This tool is designed to deploy installation packages to the devices discovered on the network."/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource SubTitleTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="© 2016 Comodo Security Solutions, Inc. All Rights Reserved." Margin="0,0,0,-3"  FontSize="13" />
                    </Grid>
                </Border>

                <Grid Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Grid.Row="1" Margin="0 50  0 0">
                    <Grid Margin="23">
                        <Grid.Resources>
                            <Style TargetType="{x:Type TextBlock}" >
                                <Setter Property="FontFamily" Value="{StaticResource myriadpro}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource SubTitleTextStyle}" Visibility="{Binding ButtonsAvailable, Converter={converters:BoolToVisibilityConverter}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-20 -45 0 0">
                            <TextBlock.Text>
                                Target Endpoint Requirements
                            </TextBlock.Text>
                        </TextBlock>
                        
                        <TextBlock  Grid.Row="1"  TextWrapping="Wrap" Margin="0,0,0,0">
                            <Run Text="Check whether a target computer is turned on and connected to the network."  />
                        </TextBlock>

                        <TextBlock  Grid.Row="2"  TextWrapping="Wrap" Margin="0,15,0,0">
                            <Run Text="Check whether firewall on a target computer is turned Off."  />
                        </TextBlock>

                        <TextBlock  Grid.Row="3" TextWrapping="Wrap" Margin="0,15,0,0">
                            <Run Text="Check whether IP address of a target computer is correct."  />
                        </TextBlock>

                        <TextBlock  Grid.Row="4"  TextWrapping="Wrap" Margin="0,15,0,0">
                            <Run Text="In the Network Neighbourhood run Network Wizard, enable file sharing."  />
                        </TextBlock>

                        <TextBlock  Grid.Row="5"  TextWrapping="Wrap" Margin="0,15,0,0">
                            <Run Text="Make sure Administrator password is not blank and correct."  />
                        </TextBlock>

                        <TextBlock  Grid.Row="6"  TextWrapping="Wrap" Margin="0,15,0,0">
                            <Run Text="Check whether 'Forceguest' option on target computer is disabled:"  />
                            <Run Text="HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa" Foreground="{DynamicResource StrongBrush}"/>
                            <Run Text="'forceguest' dword is 0." />
                        </TextBlock>

                        <TextBlock  Grid.Row="7"  TextWrapping="Wrap" Margin="0,15,0,0">
                            <Run Text="If the account is not a built-in Administrator, check whether:" />
                            <Run Text="HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System" Foreground="{DynamicResource StrongBrush}"/>
                            <Run Text="'LocalAccountTokenFilterPolicy' dword is 1." />
                        </TextBlock>

                    </Grid>
                </Grid>


                <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Back" Grid.Row="2" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Template="{StaticResource BackButton}" Foreground="{DynamicResource TextBrush3}" Command="{Binding ChangeScreenPreviousCommand}"  />

            </Grid>
        </Border>
    </Grid>
</UserControl>