<UserControl x:Class="DDT.Application.Views.EULAView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DDT.Application.Views"
      xmlns:enums="clr-namespace:DDT.Application.Messages"
      xmlns:converters="clr-namespace:DDT.Application.Converters"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      xmlns:helpers="clr-namespace:DDT.Application.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300" helpers:ThemeHelper.Theme="{Binding Theme}">

    <Grid>
        <Border Background="{DynamicResource MainBrush}" Margin="0 30 -1 0"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Visibility="{Binding ButtonsAvailable, Converter={converters:BoolToVisibilityConverter}}" Style="{DynamicResource SubTitleTextStyle}" FontSize="16"  VerticalAlignment="Top" Margin="3,40,0,0">
                End User License Agreement
        </TextBlock>
        <Border Margin="0,62,0,0" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource AccentBrush}" >
                    <telerik:RadPdfViewer x:Name="pdf" Mode="TextSelection" DocumentChanged="pdf_DocumentChanged" BorderThickness="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" />
                </Border>

                <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Accept" Grid.Row="1" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Command="{Binding ChangeScreenCommand}" CommandParameter="{x:Static enums:ChangeScreenTypes.Packages}"/>

            </Grid>
        </Border>

        </Grid>
</UserControl>
