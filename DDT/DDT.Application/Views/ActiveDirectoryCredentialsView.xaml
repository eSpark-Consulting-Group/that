<UserControl x:Class="DDT.Application.Views.ActiveDirectoryCredentialsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DDT.Application.Views"
      xmlns:converters="clr-namespace:DDT.Application.Converters"
      xmlns:behaviors="clr-namespace:DDT.Application.Behaviors"
      xmlns:helpers="clr-namespace:DDT.Application.Helpers"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:enums="clr-namespace:DDT.Application.Messages"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300" helpers:ThemeHelper.Theme="{Binding Theme}">

    <Grid>
        <TextBlock HorizontalAlignment="Left" Style="{DynamicResource SubTitleTextStyle}" Visibility="{Binding ButtonsAvailable, Converter={converters:BoolToVisibilityConverter}}" FontSize="16"  VerticalAlignment="Top" Margin="3,40,0,0">
                Active Directory Credentials
        </TextBlock>
        <Border Margin="0,62,0,0">
            <Grid VerticalAlignment="Top" Background="{DynamicResource AccentBrush}">
                <Grid Margin="22">
                    <local:LoginPasswordUserControl Margin="0" ShowDomainController="true"  Grid.ColumnSpan="3" Login="{Binding ActiveDirectoryLogin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Password="{Binding ActiveDirectoryPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UseCurrentDomain="{Binding UseCurrentDomainForActiveDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Command="{Binding DiscoverActiveDirectoryCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Next" Grid.Row="1" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Command="{Binding DiscoverActiveDirectoryCommand}" />
        <Button Opacity="{Binding ButtonsAvailable, Converter={converters:BoolToOpacityConverter}}" Content="Back" Grid.Row="1" Margin="0 17 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Template="{StaticResource BackButton}" Foreground="{DynamicResource TextBrush3}" Command="{Binding ChangeScreenPreviousCommand}" CommandParameter="{x:Static enums:ChangeScreenTypes.DiscoveryTargets}" />

    </Grid>
</UserControl>